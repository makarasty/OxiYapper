// Audio page (SPEC Recording, Audio before whisper, Sounds): microphone, live meter, the DSP
// switches, tail, recording cap and the sounds of the five events.
import { Theme, Shell, Icons, Card, Row, Divider, ToggleRow, SliderRow, Combo, SubTabs, Button, Meter, CardGrid, GalleryTile } from "../theme/index.slint";
import { Warnings } from "../theme/components/feedback.slint";

// Which control changed; `value` of `AudioState.edited` carries its new value.
export enum AudioKey { device, gain, sensitivity, normalize, trim, denoise, tail, max-minutes, volume, done-on }

// Filled and read by `pages::audio`.
export global AudioState {
    // 0 Microphone, 1 Recording, 2 to 6 the Sounds tab on the sound of start, stop, text ready,
    // cancel and error (the order of `pages::audio::ROLES`).
    in-out property <int> view;
    // "System default" first, then the input devices.
    in property <[string]> devices;
    in-out property <int> device;
    in-out property <float> gain-db;
    in-out property <float> sensitivity-db;
    in-out property <bool> normalize;
    in-out property <bool> trim;
    in-out property <bool> denoise;
    in-out property <float> tail-ms;
    in-out property <float> max-minutes;
    // The defaults of `Config::default()`: a double click on a slider's thumb returns to them.
    in property <float> default-gain-db;
    in property <float> default-sensitivity-db;
    in property <float> default-tail-ms;
    in property <float> default-max-minutes;
    // Live meter: bar heights 0..1, oldest first.
    in property <[float]> bars;
    in property <bool> clipping;
    // Per bar, parallel to `bars`: which ones clipped (red).
    in property <[bool]> clipped;
    // True while the page holds the microphone open.
    in property <bool> live;
    // Why there is no meter ("No microphone"), shown while `live` is off.
    in property <string> note;
    // The configured mic is missing and the meter runs on the system default; empty otherwise.
    in property <string> fallback;
    // Listing the devices failed (the error kind); empty otherwise.
    in property <string> list-error;
    // The open mic gives only exact zeros (muted or switched off); empty otherwise.
    in property <string> silence;
    // The Test button: true while it records and plays back (its steps are toasts).
    in property <bool> testing;
    // Per sound (start, stop, text ready, cancel, error): its tiles, `Builtin::ALL` in order then
    // the own file, and the tile picked (-1: none).
    in property <[[GalleryTile]]> role-tiles;
    in property <[int]> role-tile;
    // The glyphs of the tiles, read by `pages::audio` when it builds them.
    out property <image> sound-icon: Icons.sound-wave-circle;
    out property <image> file-icon: Icons.folder-open;
    in-out property <float> volume;
    in property <float> default-volume;
    // `sounds.done_enabled`: the text ready sound plays.
    in-out property <bool> done-on;
    // Why a sound cannot be used or played, from the daemon's warnings; empty otherwise.
    in property <string> sound-warning;
    // Why the daemon cannot play a preview now; empty when it can.
    in property <string> preview-off;
    in property <bool> can-browse;
    callback shown();
    callback edited(AudioKey, float);
    callback test();
    callback sound-picked(int);
    callback choose-file();
    callback preview();
}

export component AudioPage inherits VerticalLayout {
    // The shell's room under the header row: the sound gallery takes what the sub-tabs and the
    // card above it leave, so the Sounds tab fits without the page scrolling (UI rule 25).
    in property <length> free-height;
    // The sound shown on the Sounds tab: 0 start, 1 stop, 2 text ready, 3 cancel, 4 error.
    property <int> role: clamp(AudioState.view - 2, 0, 4);
    alignment: start;
    spacing: Theme.space-4;
    init => {
        AudioState.shown();
    }
    tabs := SubTabs {
        items: [@tr("Microphone"), @tr("Recording"), @tr("Sounds")];
        selected: min(AudioState.view, 2);
        picked(i) => {
            AudioState.view = i;
        }
    }
    if AudioState.view == 0: Card {
        Row {
            title: @tr("Device");
            warning: Warnings.both(AudioState.list-error, AudioState.fallback);
            fill-controls: true;
            full-text: AudioState.devices[AudioState.device];
            Combo {
                model: AudioState.devices;
                current-index <=> AudioState.device;
                accessible-label: @tr("Device");
                selected => {
                    AudioState.edited(AudioKey.device, self.current-index);
                }
            }
        }
        Divider { }
        // The Test button takes its width from the column: the meter shrinks, the right edge stays
        // the column's (DS-3.3).
        Row {
            title: @tr("Level");
            warning: AudioState.silence;
            fill-controls: true;
            Meter {
                bars: AudioState.bars;
                live: AudioState.live;
                clipped: AudioState.clipped;
                empty-text: AudioState.note;
                idle-text: @tr("Listening");
                accessible-label: !AudioState.live ? AudioState.note : AudioState.clipping ? @tr("Level, clipping") : @tr("Level");
            }
            Button {
                text: @tr("Test");
                enabled: !AudioState.testing;
                tooltip: @tr("A test is running");
                clicked => {
                    AudioState.test();
                }
            }
        }
        Divider { }
        SliderRow {
            title: @tr("Gain");
            info: @tr("Changes what Whisper hears.");
            minimum: -20;
            maximum: 20;
            bipolar: true;
            signed: true;
            unit: "dB";
            default-value: AudioState.default-gain-db;
            value <=> AudioState.gain-db;
            changed(v) => {
                AudioState.edited(AudioKey.gain, v);
            }
        }
        Divider { }
        SliderRow {
            title: @tr("Meter sensitivity");
            info: @tr("Changes only the meter, not the recording.");
            minimum: -20;
            maximum: 20;
            bipolar: true;
            signed: true;
            unit: "dB";
            default-value: AudioState.default-sensitivity-db;
            value <=> AudioState.sensitivity-db;
            changed(v) => {
                AudioState.edited(AudioKey.sensitivity, v);
            }
        }
    }
    if AudioState.view == 1: Card {
        ToggleRow {
            flat: true;
            title: @tr("Normalise level");
            checked <=> AudioState.normalize;
            toggled(on) => {
                AudioState.edited(AudioKey.normalize, on ? 1 : 0);
            }
        }
        Divider { }
        ToggleRow {
            flat: true;
            title: @tr("Trim silence");
            checked <=> AudioState.trim;
            toggled(on) => {
                AudioState.edited(AudioKey.trim, on ? 1 : 0);
            }
        }
        Divider { }
        ToggleRow {
            flat: true;
            title: @tr("Noise suppression");
            warning: AudioState.denoise ? @tr("Noise suppression can make Whisper worse.") : "";
            checked <=> AudioState.denoise;
            toggled(on) => {
                AudioState.edited(AudioKey.denoise, on ? 1 : 0);
            }
        }
        Divider { }
        SliderRow {
            title: @tr("Tail after release");
            minimum: 0;
            maximum: 1000;
            step: 50;
            unit: "ms";
            default-value: AudioState.default-tail-ms;
            value <=> AudioState.tail-ms;
            changed(v) => {
                AudioState.edited(AudioKey.tail, v);
            }
        }
        Divider { }
        SliderRow {
            title: @tr("Max length");
            minimum: 1;
            maximum: 30;
            unit: "min";
            default-value: AudioState.default-max-minutes;
            value <=> AudioState.max-minutes;
            changed(v) => {
                AudioState.edited(AudioKey.max-minutes, v);
            }
        }
    }
    if AudioState.view >= 2: VerticalLayout {
        // Followed by hand: picking a row of the Combo sets its index and so drops a binding.
        property <int> role: root.role;
        changed role => {
            roles.current-index = self.role;
        }
        spacing: Theme.space-4;
        sound-card := Card {
            Row {
                title: @tr("Sound for");
                warning: AudioState.sound-warning;
                fill-controls: true;
                roles := Combo {
                    // Only the view changes: the sounds stay readable on a locked config.
                    locked: false;
                    model: [@tr("Start"), @tr("Stop"), @tr("Text ready"), @tr("Cancel"), @tr("Error")];
                    current-index: root.role;
                    accessible-label: @tr("Sound for");
                    selected => {
                        AudioState.view = 2 + self.current-index;
                    }
                }
            }
            if root.role == 2: Divider { }
            if root.role == 2: ToggleRow {
                flat: true;
                title: @tr("Play when the text is ready");
                checked <=> AudioState.done-on;
                toggled(on) => {
                    AudioState.edited(AudioKey.done-on, on ? 1 : 0);
                }
            }
            Divider { }
            Row {
                title: @tr("Own file");
                if AudioState.can-browse: Button {
                    text: @tr("Choose file");
                    enabled: !Shell.locked;
                    tooltip: Shell.locked-tip;
                    clicked => {
                        AudioState.choose-file();
                    }
                }
            }
            Divider { }
            // Preview plays the tile picked below, so it is not in the own-file row.
            Row {
                title: @tr("Picked sound");
                Button {
                    text: @tr("Preview");
                    icon: Icons.play;
                    enabled: AudioState.preview-off == "";
                    tooltip: AudioState.preview-off;
                    clicked => {
                        AudioState.preview();
                    }
                }
            }
            Divider { }
            SliderRow {
                title: @tr("Volume");
                minimum: 0;
                maximum: 100;
                unit: "%";
                default-value: AudioState.default-volume;
                value <=> AudioState.volume;
                changed(v) => {
                    AudioState.edited(AudioKey.volume, v);
                }
            }
        }
        CardGrid {
            accessible-label: @tr("Sounds");
            // Up to two rows of tiles, at least one; more scroll inside the grid. Under banners not
            // even one row fits and the page scrolls: then the grid shows every row, so only one
            // thing scrolls (UI rule 26).
            property <length> room: root.free-height - tabs.preferred-height - sound-card.preferred-height - 2 * Theme.space-4;
            height: self.room < self.min-height ? self.full-height : clamp(self.room, self.min-height, 2 * self.min-height + Theme.tile-gap);
            tiles: AudioState.role-tiles[root.role];
            selected: AudioState.role-tile[root.role];
            picked(i) => {
                AudioState.sound-picked(i);
            }
        }
    }
}
