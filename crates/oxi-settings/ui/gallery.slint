        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            VerticalLayout {
                spacing: Theme.space-2;
                Remark {
                    text: "PositionTiles: Bottom centre picked";
                }
                PositionTiles {
                    names: root.positions;
                    selected: 4;
                }
            }
        }
    }

    Section {
        title: "Card grid";
        note: "CardGrid (Per-app apps, models, sounds): glyph top-left, title, caption, the check badge top-right. The grid scrolls inside its box with the 6 px bar in a 12 px gutter, the page does not. Arrows move the focus ring, Enter or Space picks. A long title is cut and stands in full in the tooltip.";
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            StateBox {
                label: "Empty";
                CardGrid {
                    empty-text: "Nothing found on this computer.";
                    empty-icon: Icons.app-generic;
                }
            }
            StateBox {
                label: "Found apps, nothing selected; one with no icon";
                CardGrid {
                    tiles: [
                        { picture: Icons.logo, title: "OxiYapper", caption: "oxiyapper.exe" },
                        { title: "Synth App", caption: "synthapp.exe" },
                    ];
                    fallback-icon: Icons.app-generic;
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            StateBox {
                label: "Selected Soft click, hover Bell, keyboard focus";
                CardGrid {
                    tiles: root.sound-tiles;
                    selected: 0;
                    force-hover: 1;
                    force-focus: true;
                }
            }
            StateBox {
                label: "Disabled tiles, one of them selected";
                CardGrid {
                    tiles: root.disabled-tiles;
                    selected: 0;
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            StateBox {
                label: "Locked (read-only config)";
                CardGrid {
                    tiles: root.sound-tiles;
                    selected: 1;
                    locked: true;
                }
            }
            StateBox {
                label: "60 tiles, tile 32 selected and scrolled into view";
                long-grid := CardGrid {
                    tiles: root.many-tiles;
                    selected: 31;
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            StateBox {
                label: "60 tiles from the top, keyboard focus on tile 5 (long name)";
                CardGrid {
                    tiles: root.many-tiles;
                    selected: 4;
                    force-focus: true;
                }
            }
        }
    }

    Section {
        title: "Warning slot and toast";
        note: "WarningSlot: the '!' keeps its width while empty, the text is its tooltip on hover and keyboard focus. Toast: lies over the bottom of the window, pushes nothing, leaves after 3 s; the newest replaces the current one.";
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            VerticalLayout {
                width: 640px;
                spacing: Theme.space-2;
                Remark {
                    text: "No warning: the slot stays, the control does not move";
                }
                Card {
                    Row {
                        icon: Icons.mic;
                        title: "Device";
                        Combo {
                            model: root.devices;
                        }
                    }
                }
                Remark {
                    text: "Warning: the icon in the same slot; the tooltip below shows its text on hover";
                }
                Card {
                    Row {
                        icon: Icons.mic;
                        title: "Device";
                        warning: "Not connected: Headset (Bluetooth). Using the system default.";
                        Combo {
                            model: root.devices;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Tooltip {
                        text: "Not connected: Headset (Bluetooth). Using the system default.";
                    }
                }
            }
            VerticalLayout {
                width: 640px;
                spacing: Theme.space-2;
                StateBox {
                    box-height: 96px;
                    label: "ToastHost over content (real, gone 3 s after the sheet opens)";
                    ToastHost {
                        width: 100%;
                        height: 100%;
                        init => {
                            Toast.show("Copied to the clipboard.");
                        }
                    }
                }
                Remark {
                    text: "A long toast wraps inside its 320 px bubble";
                }
                HorizontalLayout {
                    alignment: start;
                    Tooltip {
                        text: "Could not read the sound file. OxiYapper keeps using the built-in sound until you pick another one.";
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Show toast";
                        clicked => {
                            Toast.show("Copied to the clipboard.");
                        }
                    }
                }
            }
        }
    }

    Section {
        title: "Keycaps";
        note: "Board caps scale with the key unit (radius max(4, unit x 0.12), label clamp(unit x 0.30, 12, 15)). Picked = accent fill; held = pressed fill, 1 px lower.";
        GridRow {
            label: "";
            for s in ["rest", "hover", "picked", "held", "invalid", "disabled"]: Cell {
                width: 80px;
                label: s;
            }
        }
        for u in [28px, 44px, 52px]: GridRow {
            label: "unit " + round(u / 1px);
            for s[i] in ["rest", "hover", "picked", "held", "invalid", "disabled"]: Cell {
                width: 80px;
                height: u + 28px;
                Keycap {
                    width: u * (u < 40px ? 1.5 : 1.25) - Theme.keycap-gap-for(u);
                    height: u - Theme.keycap-gap-for(u);
                    unit: u;
                    label: u < 36px ? "Ctl" : "Ctrl";
                    force-hover: i == 1;
                    picked: i == 2;
                    held: i == 3;
                    invalid: i == 4;
                    enabled: i != 5;
                }
            }
        }
        GridRow {
            label: "KeycapRow";
            Cell {
                width: 200px;
                label: "chord";
                KeycapRow {
                    keys: ["Ctrl", "Win"];
                    label: "Ctrl + Win";
                }
            }
            Cell {
                width: 200px;
                label: "warning";
                KeycapRow {
                    keys: ["Alt", "F4"];
                    warning: true;
                }
            }
            Cell {
                width: 200px;
                label: "preview 40 px";
                KeycapRow {
                    keys: ["Ctrl", "Shift", "F13"];
                    cap-height: 40px;
                }
            }
            Cell {
                width: 200px;
                label: "empty";
                KeycapRow {
                    empty-text: "No keys yet";
                }
            }
        }
    }

    Section {
        title: "Page structure";
        note: "PageHeader, Group (header 8 px above, cards 4 px apart), Card, Row, ToggleRow (whole card toggles), SliderRow, ClickCard. Shown at the content max width 880.";
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 880px;
                background: Theme.bg-page;
                border-radius: Theme.radius-card;
                VerticalLayout {
                    padding-left: Theme.page-padding;
                    padding-right: Theme.page-padding;
                    padding-bottom: Theme.page-padding;
                    spacing: Theme.group-gap;
                    PageHeader {
                        title: "Audio";
                    }
                    Group {
                        title: "Microphone";
                        Card {
                            Row {
                                icon: Icons.mic;
                                title: "Device";
                                Combo {
                                    model: root.devices;
                                }
                            }
                            Note {
                                severity: Severity.warning;
                                text: "Not connected: Headset (Bluetooth). Using the system default.";
                            }
                        }
                        Card {
                            Row {
                                icon: Icons.mic;
                                title: "Level";
                                fill-controls: true;
                                Meter {
                                    bars: root.bars;
                                }
                            }
                        }
                        Card {
                            SliderRow {
                                icon: Icons.speaker-2;
                                title: "Gain";
                                description: "Boosts or cuts what Whisper hears.";
                                minimum: -20;
                                maximum: 20;
                                value: 3;
                                bipolar: true;
                                signed: true;
                                unit: "dB";
                            }
                        }
                        Card {
                            SliderRow {
                                icon: Icons.timer;
                                title: "Unload after idle";
                                description: "Frees GPU memory when you have not dictated for a while.";
                                minimum: 0;
                                maximum: 60;
                                value: 0;
                                unit: "min";
                                zero-text: "never";
                            }
                        }
                    }
                    Group {
                        title: "Processing";
                        ToggleRow {
                            title: "Normalise level";
                            description: "Evens out quiet and loud speech.";
                            checked: true;
                        }
                        ToggleRow {
                            title: "Trim silence (hover)";
                            description: "Cuts silence at the start and end.";
                            force-hover: true;
                        }
                        ToggleRow {
                            title: "Noise suppression (focused)";
                            description: "Can make Whisper worse; off by default.";
                            force-focus: true;
                        }
                        ToggleRow {
                            title: "Start at sign-in (disabled)";
                            description: "Takes effect in a later version.";
                            enabled: false;
                        }
                        ToggleRow {
                            title: "Check for updates (locked)";
                            description: "Once a day OxiYapper asks GitHub for the latest version. Nothing installs on its own.";
                            checked: true;
                            locked: true;
                        }
                    }
                    Group {
                        title: "Speech model";
                        icon: Icons.brain-circuit;
                        for m in [
                            { name: "Whisper small", caption: "0.5 GB · fast, good for most", badge: "Ready", kind: BadgeKind.success, on: true, hover: false, pressed: false, focus: false, progress: -1 },
                            { name: "Whisper large-v3 turbo (hover)", caption: "1.6 GB · best quality", badge: "Recommended", kind: BadgeKind.accent, on: false, hover: true, pressed: false, focus: false, progress: -1 },
                            { name: "Whisper medium (pressed, downloading)", caption: "1.5 GB", badge: "Downloading", kind: BadgeKind.neutral, on: false, hover: false, pressed: true, focus: false, progress: 0.44 },
                            { name: "Whisper base (focused)", caption: "0.1 GB · fastest", badge: "Not downloaded", kind: BadgeKind.neutral, on: false, hover: false, pressed: false, focus: true, progress: -1 },
                        ]: ClickCard {
                            force-hover: m.hover;
                            force-pressed: m.pressed;
                            force-focus: m.focus;
                            accessible-label: m.name;
                            HorizontalLayout {
                                spacing: Theme.icon-gap;
                                VerticalLayout {
                                    alignment: center;
                                    Radio {
                                        checked: m.on;
                                        hover: m.hover;
                                    }
                                }
                                VerticalLayout {
                                    spacing: Theme.title-gap;
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        alignment: start;
                                        Text {
                                            text: m.name;
                                            font-size: Theme.body-size;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                        }
                                        Badge {
                                            text: m.badge;
                                            kind: m.kind;
                                        }
                                    }
                                    Remark {
                                        text: m.caption;
                                    }
                                    if m.progress >= 0: ProgressBar {
                                        value: m.progress;
                                        label: "0.7 of 1.5 GB";
                                    }
                                }
                                if !m.on && m.progress < 0: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Download";
                                        icon: Icons.arrow-download-16;
                                    }
                                }
                                if m.progress >= 0: VerticalLayout {
                                    alignment: center;
                                    Button {
                                        kind: ButtonKind.subtle;
                                        text: "Cancel";
                                        icon: Icons.dismiss-16;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Section {
        title: "Banner";
        note: "Window level: severity fill, 30 % stroke of the same hue, icon 20, actions right; under 560 px the text goes above the buttons.";
        Banner {
            severity: Severity.warning;
            text: "OxiYapper is not running. Settings are saved to the config file.";
            Button {
                text: "Start";
            }
        }
        Banner {
            severity: Severity.warning;
            text: "config.toml is from a newer version and is read-only. Update OxiYapper to change settings here.";
            Button {
                text: "Open file";
            }
        }
        Banner {
            severity: Severity.error;
            text: "config.toml line 3, column 11: expected a value";
            Button {
                text: "Open file";
            }
            Button {
                text: "Reset to defaults";
            }
        }
        HorizontalLayout {
            alignment: start;
            Banner {
                width: 480px;
                severity: Severity.error;
                text: "Narrow (480 px): the text wraps on its own line above the buttons.";
                Button {
                    text: "Open file";
                }
                Button {
                    text: "Reset to defaults";
                }
            }
        }
    }

    Section {
        title: "Note, meter, progress, badge";
        note: "Note: inline under a control, no border, severity colour. Meter: newest at the right, clipping bars red, empty state with a reason.";
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            Card {
                width: 520px;
                Note {
                    severity: Severity.info;
                    text: "Takes effect in a later version.";
                }
                Note {
                    severity: Severity.success;
                    text: "All lines valid";
                }
                Note {
                    severity: Severity.warning;
                    text: "Noise suppression can make Whisper worse.";
                }
                Note {
                    severity: Severity.error;
                    text: "Line 2 has no =>: ignored";
                }
                Note {
                    severity: Severity.warning;
                    text: "Update checks will stop.";
                    Button {
                        kind: ButtonKind.subtle;
                        text: "Turn off";
                    }
                    Button {
                        kind: ButtonKind.primary;
                        text: "Keep checking";
                    }
                }
            }
            VerticalLayout {
                width: 420px;
                spacing: Theme.space-3;
                Remark {
                    text: "Meter live (one clipping bar) / no meter";
                }
                Meter {
                    bars: root.bars;
                }
                Meter {
                    live: false;
                    empty-text: "No microphone";
                }
                Remark {
                    text: "ProgressBar 44 % / over budget / 0 / done";
                }
                ProgressBar {
                    value: 0.44;
                    label: "0.7 of 1.6 GB";
                }
                ProgressBar {
                    value: 1;
                    error: true;
                    label: "240 / 223 tokens";
                }
                ProgressBar {
                    value: 0;
                }
                ProgressBar {
                    value: 1;
                }
                Remark {
                    text: "Badge success / neutral / accent";
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Badge {
                        text: "Ready";
                        kind: BadgeKind.success;
                    }
                    Badge {
                        text: "Not downloaded";
                    }
                    Badge {
                        text: "Recommended";
                        kind: BadgeKind.accent;
                    }
                }
            }
        }
    }

    Section {
        title: "Home: stat cards and activity";
        note: "StatCard: icon + label, big value, caption. ActivityHeatmap: weeks as columns, Mon..Sun rows, five levels of the accent, today outlined.";
        HorizontalLayout {
            alignment: start;
            VerticalLayout {
                width: 880px;
                spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    StatCard {
                        icon: Icons.text-word-count;
                        label: "Words spoken";
                        value: "299.9K";
                        caption: "All time";
                    }
                    StatCard {
                        icon: Icons.top-speed;
                        label: "Words per minute";
                        value: "142";
                        caption: "Based on recorded speech";
                    }
                    StatCard {
                        icon: Icons.mic;
                        label: "Dictations";
                        value: "8,214";
                        caption: "All time";
                    }
                    StatCard {
                        icon: Icons.fire;
                        label: "Current streak";
                        value: "12 days";
                        caption: "Longest: 40 days";
                    }
                }
                Card {
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Image {
                            source: Icons.calendar;
                            width: 20px;
                            height: 20px;
                            colorize: Theme.text-primary;
                        }
                        Text {
                            text: "Speaking activity";
                            font-size: Theme.body-size;
                            font-weight: Theme.weight-strong;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        ActivityHeatmap {
                            levels: root.activity;
                            months: root.months;
                            today: root.activity.length - 1;
                            cell: 16px;
                            gap: 4px;
                            summary: "Speaking activity, last 26 weeks";
                        }
                    }
                }
            }
        }
    }
}

// The interactive gallery (`cargo run -p oxi-settings --example gallery`): theme switch on top.
// Test surface: `tests/gallery.rs` reads the bubble's fade under the mock clock.
export component TipFadeProbe inherits Window {
    out property <float> bubble-opacity: bubble.opacity;
    bubble := TipBubble {
        text: "Tip";
    }
}

// Test surface: `tests/gallery.rs` reads what a `PathField` shows at rest.
export component PathFieldProbe inherits Window {
    // Known at creation, before the test wires `PathText`, as on a page.
    in property <string> path: "C:\\Users\\Synth\\AppData\\Local\\OxiYapper\\models\\ggml-large-v3-turbo.bin";
    out property <string> shown: f.shown;
    width: 400px;
    height: 100px;
    f := PathField {
        x: 0;
        y: 0;
        width: 240px;
        path: root.path;
    }
}

// Test surface: `tests/gallery.rs` walks a gallery by keyboard; the owner side keeps `selected`.
export component TileGalleryProbe inherits Window {
    in property <[GalleryTile]> tiles;
    in-out property <int> selected: -1;
    in-out property <bool> locked;
    out property <int> picks: self.count;
    out property <int> cursor: g.cursor;
    out property <int> columns: g.columns;
    out property <length> scrolled: g.scrolled;
    property <int> count;
    width: 560px;
    height: 360px;
    g := TileGallery {
        tiles: root.tiles;
        selected: root.selected;
        locked: root.locked;
        picked(i) => {
            root.selected = i;
            root.count += 1;
        }
    }
}

// Test surface: `tests/gallery.rs` walks the bar by keyboard; pane 0 has a field with unsaved text,
// pane 1 is taller than the window's share of it.
export component SubTabsProbe inherits Window {
    in-out property <int> selected;
    out property <int> picks: self.count;
    out property <bool> ring: bar.ring;
    out property <string> draft: field.text;
    out property <bool> draft-focused: field.has-focus;
    out property <bool> other-focused: other.has-focus;
    out property <length> panes-min: panes.min-height;
    // The pane fills the host: the field is as wide as the window.
    out property <length> draft-width: field.width;
    property <int> count;
    width: 480px;
    height: 300px;
    VerticalLayout {
        bar := SubTabs {
            items: ["One", "Two", "Three"];
            selected: root.selected;
            picked(i) => {
                root.selected = i;
                root.count += 1;
            }
        }
        panes := Rectangle {
            vertical-stretch: 1;
            SubTabPane {
                shown: root.selected == 0;
                field := TextField { }
            }
            SubTabPane {
                shown: root.selected == 1;
                Rectangle {
                    min-height: 200px;
                    other := FocusScope { }
                }
            }
        }
    }
}

// Test surface: `tests/gallery.rs` clicks each control that takes the focus in its click handler
// (UI rule 17: a click draws no ring). Stacked from y 0: Segmented, TilePicker, Slider.
export component ClickRingProbe inherits Window {
    out property <bool> segmented-ring: seg.ring;
    out property <bool> tiles-ring: tiles.ring;
    out property <bool> slider-ring: slider.ring;
    out property <length> tiles-y: tiles.y;
    out property <length> slider-y: slider.y + slider.height / 2;
    in-out property <int> picked;
    width: 480px;
    height: 200px;
    VerticalLayout {
        alignment: start;
        seg := Segmented {
            items: ["One", "Two"];
            selected: root.picked;
            locked: false;
            picked(i) => {
                root.picked = i;
            }
        }
        tiles := TilePicker {
            tiles: [{ title: "One" }, { title: "Two" }];
            selected: root.picked;
            locked: false;
            tile-height: 40px;
            picked(i) => {
                root.picked = i;
            }
        }
        slider := Slider {
            locked: false;
        }
    }
}

// Test surface: a destructive icon button (a rule's Remove) at 0,0 turns red under the pointer.
export component IconDangerProbe inherits Window {
    out property <bool> red: remove.red;
    width: 100px;
    height: 100px;
    remove := Button {
        x: 0;
        y: 0;
        kind: ButtonKind.icon;
        destructive: true;
        icon: Icons.delete-16;
        text: "Remove";
    }
}

export component GalleryWindow inherits Window {
    in-out property <bool> dark;
    title: "OxiYapper design system";
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    preferred-width: 1400px;
    preferred-height: 900px;
    background: Theme.bg-page;
    function apply-theme() {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        root.apply-theme();
    }
    changed dark => {
        root.apply-theme();
    }
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-3;
            padding-left: Theme.page-padding;
            spacing: Theme.space-3;
            alignment: start;
            Segmented {
                width: 200px;
                items: ["Light", "Dark"];
                selected: root.dark ? 1 : 0;
                locked: false;
                picked(i) => {
                    root.dark = i == 1;
                }
            }
            lock-switch := Switch {
                checked <=> Shell.locked;
                locked: false;
            }
            Text {
                text: "Shell.locked";
                font-size: Theme.body-size;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }
        ScrollView {
            GallerySheet { }
        }
    }
}

// The same sheet without scrolling, for the PNGs: the test sizes the window to `sheet-height`.
export component GalleryShot inherits Window {
    in-out property <bool> dark;
    out property <length> sheet-height: sheet.preferred-height;
    out property <length> long-grid-scrolled: sheet.long-grid-scrolled;
    out property <int> long-grid-columns: sheet.long-grid-columns;
    out property <length> long-grid-height: sheet.long-grid-height;
    default-font-family: Theme.font-family;
    default-font-size: Theme.body-size;
    background: Theme.bg-page;
    function apply-theme() {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        root.apply-theme();
    }
    changed dark => {
        root.apply-theme();
    }
    sheet := GallerySheet {
        width: root.width;
        height: self.preferred-height;
        y: 0;
    }
}
