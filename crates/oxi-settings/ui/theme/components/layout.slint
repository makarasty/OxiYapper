// Page structure: header, groups, cards and the setting rows inside them (Windows 11 Settings
// pattern: one card per setting, label and description left, control right).
import { Theme, Shell } from "../tokens.slint";
import { FocusRing, KeyFocus, CardFrame, Caption, Tip, InfoTip, ScrollBox } from "base.slint";
import { Switch } from "switch.slint";
import { Slider, NumberField } from "slider.slint";
import { WarningSlot } from "feedback.slint";
import { Button, ButtonKind } from "button.slint";

// An optional header 8 px above its cards; the cards (children) 4 px apart. No box of its own.
export component Group inherits VerticalLayout {
    in property <string> title;
    in property <image> icon;
    // A hint about the group: the "i" `pair-gap` after the title, this text its tooltip (UI rule
    // 35). Empty shows none.
    in property <string> info;
    // The trailing action at the title row's right end (DS-28.6): a soft Button, its `action-tip`
    // the tooltip. Empty `action-text` shows none and the row keeps its height.
    in property <string> action-text;
    in property <image> action-icon;
    in property <string> action-tip;
    in property <bool> action-enabled: true;
    callback action;
    spacing: Theme.card-gap;
    if root.title != "": HorizontalLayout {
        padding-bottom: Theme.header-gap - Theme.card-gap;
        spacing: Theme.pair-gap;
        alignment: stretch;
        // Centred in the row, which a trailing action button makes taller than the icon.
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: Theme.icon-size;
                height: Theme.icon-size;
                colorize: Theme.text-primary;
                accessible-role: none;
            }
        }
        Text {
            text: root.title;
            font-size: Theme.body-size;
            font-weight: Theme.weight-strong;
            color: Theme.text-primary;
            // Centred in the icon's 20 px cell, so the icon and the text share one centre.
            vertical-alignment: center;
        }
        if root.info != "": VerticalLayout {
            alignment: center;
            InfoTip {
                text: root.info;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if root.action-text != "": Button {
            kind: ButtonKind.soft;
            text: root.action-text;
            icon: root.action-icon;
            tooltip: root.action-tip;
            enabled: root.action-enabled;
            clicked => {
                root.action();
            }
        }
    }
    @children
}

// What a card holds: padding 16/12 (none when `flush`), the children stacked with 8 px gaps.
component CardBody inherits VerticalLayout {
    in property <bool> flush;
    padding-left: root.flush ? 0 : Theme.card-padding-h;
    padding-right: root.flush ? 0 : Theme.card-padding-h;
    padding-top: root.flush ? 0 : Theme.card-padding-v;
    padding-bottom: root.flush ? 0 : Theme.card-padding-v;
    spacing: Theme.space-2;
    alignment: start;
}

// A card of rows. The wrapped texts inside make its height depend on its width: take it from the layout.
export component Card inherits CardFrame {
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    inner := CardBody {
        @children
    }
}

// A whole-card button (model choice, About links): hover and pressed fills, focus ring, Enter
// and Space click it.
export component ClickCard inherits CardFrame {
    in property <bool> enabled: true;
    in property <bool> force-hover;
    in property <bool> force-pressed;
    in property <bool> force-focus;
    out property <bool> hover: root.enabled && (touch.has-hover || root.force-hover);
    callback clicked;
    property <bool> down: root.enabled && (touch.pressed || root.force-pressed);
    property <bool> key-focus;
    background: root.down ? Theme.bg-card-pressed : root.hover ? Theme.bg-control-hover : Theme.bg-card;
    animate background { duration: Theme.motion-quick; easing: ease-out; }
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.key-focus = KeyFocus.after(reason, root.key-focus);
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    inner := CardBody {
        @children
    }
    FocusRing {
        shown: root.force-focus || (root.key-focus && fs.has-focus);
        radius: Theme.radius-card;
    }
}

// `[icon 20?] [title + description, both wrap] .... [!] [control column]` inside a Card. The control
// column (children, right-aligned) is `control-column` wide: 360 px, 240 under a 720 px page (DS-3),
// the same in every row of every page (the wrapping of the text on the left must not move it); the
// "!" sits just left of the packed controls; an `info` hint is an "i" `pair-gap` after the title.
export component Row inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    // A hint about the setting: the "i" after the title, this text its tooltip (UI rule 35). Empty
    // shows none.
    in property <string> info;
    in property <string> description;
    in property <bool> enabled: true;
    // Stretch the controls over the column (slider, meter) instead of packing them right.
    in property <bool> fill-controls;
    // A persistent warning: the "!" before the controls, this text on hover. Empty shows none.
    in property <string> warning;
    // A title from the user (an app name): one line, cut, the whole of it on hover (UI rules 1, 28).
    in property <bool> elide;
    // The whole of what the control shows (a device name in a Combo): on hover when it is cut
    // (UI rule 28). shortcut: "cut" is measured against the column less the Combo's arrow and
    // padding, not the Combo's own text box; fine while the Combo fills the column.
    in property <string> full-text;
    // No controls: the text takes the control column too, not wrapping beside an empty one.
    in property <bool> text-only;
    // Why the controls are off while `enabled` is false: their tooltip (UI rule 31).
    in property <string> off-tip;
    // Where the title's text starts (tests).
    out property <length> title-x: title.absolute-position.x;
    spacing: Theme.icon-gap;
    min-height: root.description == "" ? Theme.row-min-height : Theme.control-height;
    if root.icon.width > 0: VerticalLayout {
        alignment: center;
        Image {
            source: root.icon;
            width: Theme.icon-size;
            height: Theme.icon-size;
            colorize: root.enabled ? Theme.text-primary : Theme.text-disabled;
            accessible-role: none;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: Theme.title-gap;
        horizontal-stretch: 1;
        preferred-width: 0;
        Rectangle {
            min-height: title.min-height;
            preferred-height: title.preferred-height;
            title := Text {
                // Without an x Slint centres a narrowed child: the title would start half the "i" room in.
                x: 0;
                // The "i" keeps its room so a long title wraps before it, not under it.
                width: parent.width - (root.info == "" ? 0 : Theme.pair-gap + Theme.icon-size);
                height: 100%;
                text: root.title;
                font-size: Theme.body-size;
                color: root.enabled ? Theme.text-primary : Theme.text-disabled;
                wrap: root.elide ? TextWrap.no-wrap : TextWrap.word-wrap;
                overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
                vertical-alignment: center;
            }
            if root.elide: TouchArea {
                Tip {
                    text: title.preferred-width > title.width ? root.title : "";
                    hovered: parent.has-hover;
                }
            }
            // One line of the title's font: the "i" centres on the first line when the title wraps.
            line := Text {
                visible: false;
                text: "X";
                font-size: Theme.body-size;
                accessible-role: none;
            }
            // Slint does not give where a wrapped line ends, so a wrapped title's "i" sits at the end
            // of the first line's room (kept free above): never under the text, never on line two.
            if root.info != "": InfoTip {
                x: min(title.preferred-width, title.width) + Theme.pair-gap;
                // The box is the text block's height (the layout gives it its preferred), so line one starts at 0.
                y: (line.preferred-height - self.height) / 2;
                text: root.info;
            }
        }
        if root.description != "": Caption {
            text: root.description;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            wrap: word-wrap;
        }
    }
    // The "!" keeps this room so a warning never moves the text; it is drawn in the control column.
    Rectangle {
        width: Theme.icon-size;
    }
    Rectangle {
        horizontal-stretch: 0;
        preferred-width: root.text-only ? 0 : Theme.control-column;
        min-width: self.preferred-width;
        max-width: self.preferred-width;
        min-height: controls.min-height;
        preferred-height: controls.preferred-height;
        // Next to the controls it warns about (a switch, a button), not alone at the column's start;
        // never left of its kept room.
        WarningSlot {
            x: root.fill-controls ? -(Theme.icon-gap + Theme.icon-size) : max(-(Theme.icon-gap + Theme.icon-size), parent.width - controls.preferred-width - Theme.control-gap - Theme.icon-size);
            y: 0;
            height: parent.height;
            text: root.warning;
        }
        // Under the controls: a locked control lets the pointer through and this says why (UI rule
        // 31); a control that stays live (Open folder) keeps the pointer and its own tooltip.
        // Over the controls only, so the "!" beside them keeps its own tooltip.
        if Shell.locked || (!root.enabled && root.off-tip != ""): TouchArea {
            x: root.fill-controls ? 0 : max(0, parent.width - controls.preferred-width);
            width: parent.width - self.x;
            Tip {
                text: Shell.locked ? Shell.locked-tip : root.off-tip;
                hovered: parent.has-hover;
            }
        }
        // A parent TouchArea sees the hover and still hands the pointer to the controls.
        hover := TouchArea {
            enabled: root.full-text != "" && !Shell.locked;
            // A row taller than its controls (title + description) centres them (DS-3.4).
            VerticalLayout {
                alignment: center;
                controls := HorizontalLayout {
                    alignment: root.fill-controls ? LayoutAlignment.stretch : LayoutAlignment.end;
                    spacing: Theme.control-gap;
                    @children
                }
            }
            Tip {
                text: measure.preferred-width > hover.width - Theme.control-height - Theme.space-3 ? root.full-text : "";
                hovered: hover.has-hover;
            }
        }
        measure := Text {
            visible: false;
            text: root.full-text;
            font-size: Theme.body-size;
            accessible-role: none;
        }
    }
}

// 1 px line between two Rows of one Card (a card with a single Row has none).
export component Divider inherits Rectangle {
    // 1 px hairline.
    height: 1px;
    background: Theme.divider;
    accessible-role: none;
}

// A Card with one Row and a Switch; a click anywhere on the card toggles it (Windows 11). The
// Switch keeps the role and takes the row title as its label. `flat`: no card of its own, a row
// between Dividers inside a Card.
export component ToggleRow inherits CardFrame {
    in property <bool> flat;
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> info;
    in property <string> warning;
    in property <string> off-tip;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> locked: Shell.locked;
    in property <bool> force-hover;
    in property <bool> force-focus;
    out property <bool> key-focused: switch.key-focused;
    out property <length> title-x: row.title-x;
    callback toggled(bool);
    public function take-focus(ring: bool) {
        switch.take-focus(ring);
    }
    property <bool> live: root.enabled && !root.locked;
    background: root.flat ? transparent : root.live && (touch.has-hover || root.force-hover) ? Theme.bg-control-hover : Theme.bg-card;
    animate background { duration: Theme.motion-quick; easing: ease-out; }
    // 1 px hairline: the card's stroke.
    border-width: root.flat ? 0 : 1px;
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    touch := TouchArea {
        enabled: root.live;
        mouse-cursor: pointer;
        clicked => {
            switch.toggle();
        }
    }
    inner := CardBody {
        flush: root.flat;
        row := Row {
            icon: root.icon;
            title: root.title;
            description: root.description;
            info: root.info;
            warning: root.warning;
            off-tip: root.off-tip;
            enabled: root.live;
            switch := Switch {
                checked <=> root.checked;
                enabled: root.enabled;
                locked: root.locked;
                force-hover: root.force-hover;
                force-focus: root.force-focus;
                accessible-label: root.title;
                toggled(on) => {
                    root.toggled(on);
                }
            }
        }
    }
}

// A Row whose control column holds a Slider and its NumberField, bound to one value.
export component SliderRow inherits Row {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 1;
    in property <float> default-value: root.minimum;
    in property <bool> bipolar;
    in property <int> decimals: 0;
    in property <string> unit;
    in property <bool> signed;
    in property <string> zero-text;
    in property <bool> locked: Shell.locked;
    callback changed(float);
    fill-controls: true;
    Slider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        default-value: root.default-value;
        bipolar: root.bipolar;
        enabled: root.enabled;
        locked: root.locked;
        accessible-label: root.title;
        changed(v) => {
            root.changed(v);
        }
    }
    NumberField {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        decimals: root.decimals;
        unit: root.unit;
        signed: root.signed;
        zero-text: root.zero-text;
        enabled: root.enabled;
        locked: root.locked;
        accessible-label: root.title;
        changed(v) => {
            root.changed(v);
        }
    }
}

// A vertical scroller with the design-system bar (DS-18), over Flickable: std's fluent bar grows
// off its axis on hover and cannot be restyled. Content takes the full width and leaves exactly
// `scrollbar-gutter` only while it overflows; the 6 px thumb is centred in that gutter. Children
// are laid out at `visible-width` (a layout child takes it and reports its height).
export component ScrollView {
    in-out property <length> viewport-y <=> box.viewport-y;
    out property <length> visible-width: box.content-width;
    out property <length> visible-height: root.height;
    out property <bool> overflows: box.overflows;
    // The content's height; the layout inside reports it.
    property <length> content-h: body.preferred-height;
    min-height: 0;
    preferred-height: root.content-h;
    box := ScrollBox {
        width: root.width;
        height: root.height;
        // shortcut: the gutter is reserved from the height at full width; content that only
        // overflows once narrowed by the gutter shows no bar, fine for card pages.
        content-height: max(root.height, root.content-h);
        body := VerticalLayout {
            width: box.content-width;
            alignment: start;
            @children
        }
    }
}

// The page's header row (DS-14, R2.4): `SubTabs` (or the page name) left, the status chip slot
// right, a 1 px divider across the whole content width at the bottom. Children go left; set
// `title` instead on a page without tabs.
export component HeaderRow {
    in property <string> title;
    height: Theme.header-row-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    Rectangle {
        y: root.height - self.height;
        // 1 px hairline: the tab line.
        height: 1px;
        background: Theme.divider;
    }
    HorizontalLayout {
        spacing: Theme.control-gap;
        if root.title != "": Text {
            text: root.title;
            font-size: Theme.body-size;
            font-weight: Theme.weight-strong;
            color: Theme.text-primary;
            vertical-alignment: center;
            accessible-role: none;
        }
        @children
    }
}

// The status at the right of the header row (DS-14.4): the text, then a status dot `pair-gap` right
// of it. Inert while `actionable` is off (the normal state); with an action (no model, no
// microphone, daemon down) it hovers, takes the pointer and the keyboard, and `clicked` fires.
export component StatusChip {
    in property <string> text;
    in property <color> dot: Theme.success-text;
    in property <bool> actionable;
    // Shown on hover, inert chip or not: what the status means, or what a click does.
    in property <string> tooltip;
    in property <bool> force-hover;
    in property <bool> force-focus;
    callback clicked;
    property <bool> hover: root.actionable && (touch.has-hover || root.force-hover);
    property <bool> key-focus;
    height: Theme.control-height;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-enabled: root.actionable;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.actionable) {
            root.clicked();
        }
    }
    face := Rectangle {
        border-radius: Theme.radius-control;
        background: root.hover ? (touch.pressed ? Theme.bg-subtle-selected : Theme.bg-subtle-hover) : transparent;
        animate background { duration: Theme.motion-quick; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.pair-gap;
        Text {
            text: root.text;
            font-size: Theme.body-size;
            color: Theme.text-secondary;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.status-dot-size;
                height: Theme.status-dot-size;
                border-radius: Theme.radius-round;
                background: root.dot;
            }
        }
    }
    // Enabled on an inert chip too, for the tooltip; only an actionable one clicks.
    touch := TouchArea {
        mouse-cursor: root.actionable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.actionable) {
                root.clicked();
            }
        }
    }
    Tip {
        text: root.tooltip;
        hovered: touch.has-hover;
    }
    fs := FocusScope {
        enabled: root.actionable;
        focus-on-click: false;
        focus-gained(reason) => {
            root.key-focus = KeyFocus.after(reason, root.key-focus);
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    FocusRing {
        shown: root.force-focus || (root.key-focus && fs.has-focus);
    }
}
