// Overlay page (SPEC Feedback): the pill on or off, its spot on screen, hiding it over
// fullscreen apps, and a preview the daemon shows at the picked spot. One card of four rows, like
// System (owner's direction B, item 17).
import { Theme, Shell, Icons, Card, Row, Divider, ToggleRow, Button, PositionTiles } from "../theme/index.slint";

// Filled and read by `pages::overlay`.
export global OverlayState {
    in-out property <bool> enabled;
    // Picker order: top left, top centre, top right, then the bottom row the same way.
    in property <int> position;
    in-out property <bool> hide-over-fullscreen;
    // The daemon link is up: Preview needs it to show the pill.
    in property <bool> online;
    // Why Preview is off; empty while online or connecting.
    in property <string> note;
    callback enabled-toggled(bool);
    callback position-picked(int);
    callback hide-over-fullscreen-toggled(bool);
    callback preview();
}

export component OverlayPage inherits VerticalLayout {
    property <[string]> names: [@tr("Top left"), @tr("Top centre"), @tr("Top right"), @tr("Bottom left"), @tr("Bottom centre"), @tr("Bottom right")];
    alignment: start;
    Card {
        ToggleRow {
            flat: true;
            title: @tr("Show the overlay");
            checked <=> OverlayState.enabled;
            toggled(on) => {
                OverlayState.enabled-toggled(on);
            }
        }
        Divider { }
        ToggleRow {
            flat: true;
            title: @tr("Hide over fullscreen apps");
            checked <=> OverlayState.hide-over-fullscreen;
            toggled(on) => {
                OverlayState.hide-over-fullscreen-toggled(on);
            }
        }
        Divider { }
        // The picked spot's name is the description, left of the tiles, so it moves nothing.
        Row {
            title: @tr("Position");
            enabled: !Shell.locked;
            description: OverlayState.position >= 0 && OverlayState.position < root.names.length ? root.names[OverlayState.position] : "";
            VerticalLayout {
                alignment: center;
                PositionTiles {
                    accessible-label: @tr("Position");
                    names: root.names;
                    selected: OverlayState.position;
                    picked(i) => {
                        OverlayState.position-picked(i);
                    }
                }
            }
        }
        Divider { }
        // Why Preview is off is its tooltip (the banner above already says the daemon is off).
        // The row says what happens, the button names it: one word is not shown twice.
        Row {
            title: @tr("Try it on the desktop");
            Button {
                text: @tr("Preview");
                icon: Icons.eye-16;
                enabled: OverlayState.online;
                tooltip: OverlayState.note;
                accessible-description: OverlayState.note;
                clicked => {
                    OverlayState.preview();
                }
            }
        }
    }
}
