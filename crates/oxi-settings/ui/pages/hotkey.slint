// Hotkey page (SPEC Recording, Settings UI): the chord as keycaps and an edit button, which opens
// the full keyboard (click keys or press them, held keys light up); then the mode.
import { Theme, Shell, Icons, Group, Card, Row, KeycapRow, TilePicker, Note, Severity, Button, ButtonKind } from "../theme/index.slint";
import { Keyboard, KeyCap } from "../keyboard.slint";

// Filled and read by `pages::hotkey`.
export global HotkeyState {
    // The saved chord, "Ctrl + Win", and its keys one by one.
    in property <string> chord;
    in property <[string]> chord-keys;
    // 0 push-to-talk, 1 toggle.
    in property <int> mode;
    in property <bool> keyboard-open;
    // The daemon link is up: without it no key is captured and Apply is off.
    in property <bool> online;
    in property <[KeyCap]> caps;
    in property <float> columns;
    in property <float> rows;
    // The pending chord as it would be saved; empty while it has no keys.
    in property <string> pending;
    // The pending keys one by one (also while the chord is refused, to show what was pressed).
    in property <[string]> pending-keys;
    // Why the pending chord cannot be saved; empty when it can.
    in property <string> error;
    // Set when a pressed chord ends the capture: 1 moves the focus to Apply, 2 to Cancel, 0 stays.
    in property <int> move-focus;
    // The page came into view.
    callback shown();
    callback change();
    callback key-clicked(string);
    // The keyboard gained (true) or lost (false) the keyboard focus: hotkey capture follows it.
    callback focused(bool);
    callback apply();
    callback cancel();
    callback mode-picked(int);
}

// A Button the board can send the keyboard focus to: the theme's Button keeps its FocusScope private.
component FocusButton inherits FocusScope {
    in property <string> text;
    in property <string> spoken;
    in property <string> tooltip;
    in property <ButtonKind> kind: ButtonKind.secondary;
    callback activated();
    focus-on-click: false;
    focus-on-tab-navigation: false;
    min-width: button.min-width;
    height: Theme.control-height;
    key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) {
            root.activated();
            return accept;
        }
        reject
    }
    button := Button {
        text: root.text;
        kind: root.kind;
        tooltip: root.tooltip;
        enabled: root.enabled;
        force-focus: root.has-focus;
        accessible-label: root.spoken;
        clicked => {
            root.activated();
        }
    }
}

export component HotkeyPage inherits VerticalLayout {
    init => {
        HotkeyState.shown();
    }
    alignment: start;
    spacing: Theme.group-gap;
    Group {
        title: @tr("Shortcut");
        Card {
            Row {
                icon: Icons.keyboard;
                title: @tr("Hotkey");
                description: @tr("Hold these keys to talk. Esc cancels a recording.");
                Rectangle {
                    min-width: chord.min-width;
                    preferred-width: chord.preferred-width;
                    chord := KeycapRow {
                        keys: HotkeyState.chord-keys;
                        label: HotkeyState.chord;
                    }
                    TouchArea {
                        enabled: !Shell.locked && !HotkeyState.keyboard-open;
                        clicked => {
                            HotkeyState.change();
                        }
                    }
                }
                Button {
                    kind: ButtonKind.icon;
                    icon: Icons.edit-16;
                    text: @tr("Change hotkey");
                    enabled: !Shell.locked && !HotkeyState.keyboard-open;
                    tooltip: HotkeyState.keyboard-open ? @tr("The keyboard is open below") : @tr("Settings are read-only");
                    clicked => {
                        HotkeyState.change();
                    }
                }
            }
        }
        // Keys pressed while it has the focus come from the daemon's hook (CaptureHotkey), which
        // swallows Tab and Esc too: so releasing a chord or pressing Esc alone hands the focus back.
        if HotkeyState.keyboard-open: board := FocusScope {
            property <int> move-focus: HotkeyState.move-focus;
            accessible-role: groupbox;
            accessible-label: @tr("Hotkey keyboard");
            init => {
                self.focus();
            }
            changed move-focus => {
                if self.move-focus == 1 {
                    apply.focus();
                } else if self.move-focus == 2 {
                    cancel.focus();
                }
            }
            focus-gained => {
                HotkeyState.focused(true);
            }
            focus-lost => {
                HotkeyState.focused(false);
            }
            // A FocusScope does not take its child's height: the panel would end above the buttons.
            min-height: panel.min-height;
            preferred-height: panel.preferred-height;
            panel := Card {
                Text {
                    text: @tr("Press the new hotkey");
                    font-size: Theme.subtitle-size;
                    font-weight: Theme.weight-strong;
                    color: Theme.text-primary;
                }
                Text {
                    text: HotkeyState.online ? @tr("Click keys or press them. Left and right modifiers both count.") : @tr("Not connected to OxiYapper: pressed keys are not seen. Start OxiYapper to pick a hotkey.");
                    wrap: word-wrap;
                    font-size: Theme.caption-size;
                    color: Theme.text-secondary;
                }
                KeycapRow {
                    keys: HotkeyState.pending-keys;
                    cap-height: 40px;
                    warning: HotkeyState.error != "";
                    empty-text: @tr("No keys yet");
                    label: HotkeyState.pending != "" ? @tr("New hotkey: {}", HotkeyState.pending) : @tr("No keys yet");
                }
                Keyboard {
                    caps: HotkeyState.caps;
                    columns: HotkeyState.columns;
                    rows: HotkeyState.rows;
                    clicked(name) => {
                        board.focus();
                        HotkeyState.key-clicked(name);
                    }
                }
                if HotkeyState.error != "": Note {
                    text: HotkeyState.error;
                    severity: Severity.error;
                }
                HorizontalLayout {
                    spacing: Theme.control-gap;
                    alignment: end;
                    cancel := FocusButton {
                        text: @tr("Cancel");
                        spoken: @tr("Cancel hotkey change");
                        activated => {
                            HotkeyState.cancel();
                        }
                    }
                    apply := FocusButton {
                        text: @tr("Apply");
                        spoken: @tr("Apply hotkey");
                        kind: ButtonKind.primary;
                        enabled: !Shell.locked && HotkeyState.online && HotkeyState.error == "";
                        tooltip: !HotkeyState.online ? @tr("Start OxiYapper to apply") : HotkeyState.error;
                        activated => {
                            HotkeyState.apply();
                        }
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Recording mode");
        TilePicker {
            accessible-label: @tr("Recording mode");
            columns: 2;
            tiles: [
                { icon: Icons.hand-left-24, icon-selected: Icons.hand-left-24-filled, title: @tr("Push to talk"), caption: @tr("Hold the keys while you speak. Double-tap to lock.") },
                { icon: Icons.toggle-right-24, icon-selected: Icons.toggle-right-24-filled, title: @tr("Toggle"), caption: @tr("Press once to start, again to stop.") },
            ];
            selected: HotkeyState.mode;
            picked(i) => {
                HotkeyState.mode-picked(i);
            }
        }
    }
}
