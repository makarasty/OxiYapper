// Settings window (redesign spec sections 2 and 3): a nav rail with icons on the left (icons only
// under 960 px), the page on the right in a scrolling column as wide as the window allows, banners above it.
import { Palette, ScrollView } from "std-widgets.slint";
import { Theme, Shell, Icons, Caption, KeyFocus, Tip, Button, Banner, Severity, PageHeader, MonthLabel } from "theme/index.slint";
import { KeyTipHost, Toast, ToastHost } from "theme/components/feedback.slint";
import { HomePage, HomeState } from "pages/home.slint";
import { HotkeyPage, HotkeyState } from "pages/hotkey.slint";
import { KeyCap } from "keyboard.slint";
import { AudioPage, AudioState, AudioKey } from "pages/audio.slint";
import { ModelPage, ModelState, ModelRow } from "pages/model.slint";
import { TextPage, TextState, PasteRuleRow, FileState, FileInfo, TextFile } from "pages/text.slint";
import { OverlayPage, OverlayState } from "pages/overlay.slint";
import { SystemPage, ThemeChoice, SystemState } from "pages/system.slint";
import { TestPage, TestState, TestRow } from "pages/test.slint";
import { AboutPage } from "pages/about.slint";

export { GalleryTile } from "theme/index.slint";
export { Shell, Theme, Toast, ThemeChoice, HomeState, MonthLabel, HotkeyState, KeyCap, AudioState, AudioKey, ModelState, ModelRow, TextState, PasteRuleRow, FileState, FileInfo, TextFile, OverlayState, SystemState, TestState, TestRow }

export enum Page { home, hotkey, audio, model, text, overlay, test, system, about }

// The daemon chip at the foot of the rail; `hidden` when the window follows no daemon.
export enum DaemonStatus { hidden, running, stopped, stuck }

// One page of the rail. Selected: neutral fill, 3x16 accent pill, filled icon in accent; the label
// keeps its weight so nothing moves. The rail owns focus; `focused` draws the ring inside.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <image> icon-selected;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> focused;
    callback activated();
    // The label starts past the icon: the rail inset, the icon, one sibling gap.
    property <length> text-x: Theme.space-3 + Theme.icon-size + Theme.space-2;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.bg-subtle-selected : touch.has-hover ? Theme.bg-subtle-hover : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.activated();
    }
    Rectangle {
        x: 0;
        y: (root.height - Theme.rail-pill-height) / 2;
        width: Theme.rail-pill-width;
        height: Theme.rail-pill-height;
        border-radius: Theme.radius-round;
        background: Theme.accent;
        visible: root.selected;
    }
    Image {
        x: root.compact ? (root.width - Theme.icon-size) / 2 : Theme.space-3;
        y: (root.height - Theme.icon-size) / 2;
        width: Theme.icon-size;
        height: Theme.icon-size;
        source: root.selected ? root.icon-selected : root.icon;
        colorize: root.selected ? Theme.accent-text : Theme.text-primary;
        accessible-role: none;
    }
    if !root.compact: Text {
        x: root.text-x;
        width: root.width - root.text-x - Theme.space-2;
        text: root.label;
        font-size: Theme.body-size;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    touch := TouchArea {
        clicked => {
            root.activated();
        }
    }
    Tip {
        text: root.compact ? root.label : "";
        hovered: touch.has-hover;
    }
    Rectangle {
        visible: root.focused;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-outer;
        border-radius: Theme.radius-control;
    }
}

// Daemon state: 8 px dot and a caption; a click starts or restarts it, as the banner's button does.
component StatusChip inherits Rectangle {
    in property <DaemonStatus> status;
    in property <bool> compact;
    callback clicked();
    property <string> text: root.status == DaemonStatus.running ? @tr("Running") : root.status == DaemonStatus.stopped ? @tr("Not running") : @tr("Not answering");
    property <length> dot: Theme.space-2;
    // Centred under the rail icons.
    property <length> dot-x: Theme.space-3 + (Theme.icon-size - root.dot) / 2;
    height: Theme.control-height;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.bg-subtle-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        x: root.compact ? (root.width - root.dot) / 2 : root.dot-x;
        y: (root.height - root.dot) / 2;
        width: root.dot;
        height: root.dot;
        border-radius: Theme.radius-round;
        background: root.status == DaemonStatus.running ? Theme.success-text : root.status == DaemonStatus.stopped ? Theme.warning-text : Theme.error-text;
    }
    if !root.compact: Caption {
        x: root.dot-x + root.dot + Theme.space-2;
        text: root.text;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Tip {
        text: root.compact ? root.text : "";
        hovered: touch.has-hover;
    }
}

export component AppWindow inherits Window {
    in property <string> app-name;
    in property <string> version;
    in property <string> licence;
    in property <string> repository;
    in-out property <Page> page: Page.home;
    in-out property <ThemeChoice> theme;
    // Empty hides the banner.
    in property <string> banner-text;
    // The banner is for a broken file: offer "Reset to defaults" too (a newer file only gets "Open file").
    in property <bool> banner-fixable;
    // The last failed save or file action; empty hides it. Shown under the config banner.
    in property <string> action-error;
    // The daemon link's notice (not running, restart to update, a daemon-side config error);
    // empty hides it. Start and Restart are the buttons it may carry.
    in property <string> daemon-text;
    // `daemon-text` is the daemon's report of the config file this window reads too.
    in property <bool> daemon-config-error;
    in property <bool> daemon-start;
    in property <bool> daemon-restart;
    in property <DaemonStatus> daemon-status;
    // Why the last daemon start failed; shown under the notice.
    in property <string> spawn-error;
    // Above 0: minimum and maximum size are both this, so the OS window is created with no
    // maximize button (`open_without_maximize`).
    in property <length> frame-width;
    in property <length> frame-height;
    // The window stops here (SPEC Settings UI): fullscreen is only empty space for this app.
    out property <length> largest-width: Theme.window-max-width;
    out property <length> largest-height: Theme.window-max-height;
    // How far the open page is scrolled (0 at the top, negative below).
    out property <length> scroll-y: scroll.content-y;
    // The display scale the window opens at, set once before the OS window exists. Slint gives
    // every later icon change to the taskbar too, as ICON_BIG, in place of the exe's oxi.ico; so a
    // window moved to another display keeps this size.
    in property <float> icon-scale: 1;
    callback theme-changed(ThemeChoice);
    callback start-daemon();
    callback restart-daemon();
    callback open-file();
    callback reset-config();

    title: @tr("{} settings", root.app-name);
    icon: Icons.window-logo(root.icon-scale);
    default-font-family: Theme.font-family;
    // Text that sets no size (the std ComboBox and its list) reads body size, as every control does.
    default-font-size: Theme.body-size;
    // Test surface: `tests/shell.rs` reads the size the std widgets fall back to.
    out property <length> text-size: root.default-font-size;
    preferred-width: Theme.window-first-width;
    preferred-height: Theme.window-first-height;
    min-width: root.frame-width > 0px ? root.frame-width : Theme.window-min-width;
    min-height: root.frame-height > 0px ? root.frame-height : Theme.window-min-height;
    max-width: root.frame-width > 0px ? root.frame-width : root.largest-width;
    max-height: root.frame-height > 0px ? root.frame-height : root.largest-height;
    background: Theme.bg-page;
    forward-focus: keys;

    // A broken config is said once: the window's own banner has the buttons to fix it.
    property <bool> daemon-shown: root.daemon-text != "" && !(root.daemon-config-error && root.banner-text != "");
    property <bool> compact: root.width < Theme.compact-window;
    property <length> rail-head: Theme.space-6;
    property <length> rail-item: Theme.rail-item-height;
    // The page title centres on the first rail item (UI rule 8), whatever the font's line height.
    property <length> title-height: header.preferred-height - Theme.title-top - Theme.title-bottom;
    property <length> title-centre: root.rail-head + Theme.space-1 + root.rail-item / 2;
    property <length> pad: root.width < Theme.narrow-window ? Theme.page-padding-narrow : Theme.page-padding;
    // One rule for every page and state (UI rule 6); the window's maximum is the only cap.
    property <length> page-width: root.width - nav.width - 2 * root.pad;
    property <[{page: Page, label: string, icon: image, filled: image}]> rail: [
        { page: Page.home, label: @tr("Home"), icon: Icons.home, filled: Icons.home-filled },
        { page: Page.model, label: @tr("Model"), icon: Icons.brain-circuit, filled: Icons.brain-circuit-filled },
        { page: Page.hotkey, label: @tr("Hotkey"), icon: Icons.keyboard, filled: Icons.keyboard-filled },
        { page: Page.audio, label: @tr("Audio"), icon: Icons.mic, filled: Icons.mic-filled },
        { page: Page.text, label: @tr("Text"), icon: Icons.text-t, filled: Icons.text-t-filled },
        { page: Page.overlay, label: @tr("Overlay"), icon: Icons.slide-text, filled: Icons.slide-text-filled },
        { page: Page.test, label: @tr("Test"), icon: Icons.checkmark-circle, filled: Icons.checkmark-circle },
        { page: Page.system, label: @tr("System"), icon: Icons.settings, filled: Icons.settings-filled },
        { page: Page.about, label: @tr("About"), icon: Icons.info, filled: Icons.info-filled },
    ];

    pure function index-of(p: Page) -> int {
        return p == Page.home ? 0 : p == Page.model ? 1 : p == Page.hotkey ? 2 : p == Page.audio ? 3 : p == Page.text ? 4 : p == Page.overlay ? 5 : p == Page.test ? 6 : p == Page.system ? 7 : 8;
    }

    // System follows the OS: `unknown` makes the style read the OS scheme.
    function apply-theme() {
        Palette.color-scheme = root.theme == ThemeChoice.dark ? ColorScheme.dark : root.theme == ThemeChoice.light ? ColorScheme.light : ColorScheme.unknown;
    }
    init => {
        root.apply-theme();
        Shell.page-width = root.page-width;
    }
    changed theme => {
        root.apply-theme();
    }
    changed page-width => {
        Shell.page-width = root.page-width;
    }
    changed page => {
        // The rail follows a page opened by Ctrl+Tab; the page opens at its top.
        nav.cursor = root.index-of(root.page);
        scroll.content-y = 0;
        if (root.page == Page.home) {
            HomeState.shown();
        }
        // The focused field may have left with the old page, and Ctrl+Tab needs a focus to reach
        // `keys`. The rail keeps its own focus.
        if (!nav.has-focus) {
            keys.focus();
        }
    }

    // Ctrl+Tab and Ctrl+Shift+Tab cycle the pages from anywhere, before a focused field sees them.
    keys := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (event.modifiers.control && (event.text == Key.Tab || event.text == Key.Backtab)) {
                let step = event.modifiers.shift || event.text == Key.Backtab ? root.rail.length - 1 : 1;
                root.page = root.rail[Math.mod(root.index-of(root.page) + step, root.rail.length)].page;
                return accept;
            }
            reject
        }

        // Placed by hand, not in a layout: the rail width follows the window width, which a layout
        // would feed back into the window's minimum size.
        nav := FocusScope {
            x: 0;
            y: 0;
            width: root.compact ? Theme.rail-width-compact : Theme.rail-width;
            height: parent.height;
            accessible-role: tab-list;
            property <int> cursor;
            property <bool> key-focus;
            focus-gained(reason) => {
                self.cursor = root.index-of(root.page);
                self.key-focus = KeyFocus.from-key(reason);
            }
            // Up and Down move the focus between pages; Enter or Space opens one.
            key-pressed(event) => {
                if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    self.cursor = clamp(self.cursor + (event.text == Key.UpArrow ? -1 : 1), 0, root.rail.length - 1);
                    self.key-focus = true;
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    root.page = root.rail[self.cursor].page;
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding-left: Theme.space-1;
                padding-right: Theme.space-1;
                padding-bottom: Theme.space-2;
                spacing: Theme.space-1;
                HorizontalLayout {
                    height: root.rail-head;
                    // The logo at the head's foot: centred it kept 2 px to the window's top edge and
                    // looked cut. shortcut: 4 px, a taller head costs the 720x520 fit of About, Home
                    // and Paste (UI rule 25); grow it if those pages get room.
                    padding-top: Theme.space-1;
                    // Over the rail icons in both widths.
                    padding-left: root.compact ? (nav.width - 2 * Theme.space-1 - Theme.icon-size) / 2 : Theme.space-3;
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        logo := Image {
                            source: Icons.logo;
                            width: Theme.icon-size;
                            height: Theme.icon-size;
                            accessible-role: none;
                        }
                    }
                    if !root.compact: Text {
                        text: root.app-name;
                        font-size: Theme.body-size;
                        font-weight: Theme.weight-strong;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                for item[i] in root.rail: NavItem {
                    height: root.rail-item;
                    label: item.label;
                    icon: item.icon;
                    icon-selected: item.filled;
                    selected: root.page == item.page;
                    compact: root.compact;
                    focused: nav.has-focus && nav.key-focus && nav.cursor == i;
                    activated => {
                        nav.cursor = i;
                        root.page = item.page;
                    }
                }
                Rectangle { }
                if root.daemon-status != DaemonStatus.hidden: StatusChip {
                    status: root.daemon-status;
                    compact: root.compact;
                    clicked => {
                        if (root.daemon-start) {
                            root.start-daemon();
                        } else if (root.daemon-restart) {
                            root.restart-daemon();
                        }
                    }
                }
            }
        }

        VerticalLayout {
            x: nav.width;
            y: 0;
            width: parent.width - nav.width;
            height: parent.height;
            if root.banner-text != "" || root.daemon-shown || root.action-error != "": HorizontalLayout {
                padding-left: root.pad;
                padding-top: Theme.space-4;
                alignment: start;
                VerticalLayout {
                    width: parent.width - 2 * root.pad;
                    spacing: Theme.space-2;
                    if root.banner-text != "": Banner {
                        text: root.banner-text;
                        severity: root.banner-fixable ? Severity.error : Severity.warning;
                        Button {
                            text: @tr("Open file");
                            clicked => {
                                root.open-file();
                            }
                        }
                        if root.banner-fixable: Button {
                            text: @tr("Reset to defaults");
                            clicked => {
                                root.reset-config();
                            }
                        }
                    }
                    if root.daemon-shown: Banner {
                        text: root.spawn-error == "" ? root.daemon-text : root.daemon-text + " " + root.spawn-error;
                        severity: root.spawn-error != "" ? Severity.error : Severity.warning;
                        if root.daemon-start: Button {
                            text: @tr("Start");
                            clicked => {
                                root.start-daemon();
                            }
                        }
                        if root.daemon-restart: Button {
                            text: @tr("Restart");
                            clicked => {
                                root.restart-daemon();
                            }
                        }
                    }
                    if root.action-error != "": Banner {
                        text: root.action-error;
                        severity: Severity.error;
                    }
                }
            }

            // One scroll area for the open page (back at the top on a page change); the scrollbar sits at the window edge, right of the cards.
            scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: max(self.visible-height, column.preferred-height);
                column := VerticalLayout {
                    x: 0;
                    // Not `visible-width`: the 14 px scrollbar sits in the page padding, so the
                    // cards keep their width whether or not it shows.
                    width: scroll.width;
                    padding-left: root.pad;
                    padding-right: root.pad;
                    padding-top: root.title-centre - Theme.title-top - root.title-height / 2;
                    padding-bottom: root.pad;
                    alignment: start;
                    header := PageHeader {
                        title: root.rail[root.index-of(root.page)].label;
                    }
                    if root.page == Page.home: HomePage {
                        window-width: root.width;
                        content-width: root.page-width;
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                    }
                    if root.page == Page.hotkey: HotkeyPage {
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                    }
                    if root.page == Page.audio: AudioPage {
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                    }
                    if root.page == Page.model: ModelPage { }
                    if root.page == Page.text: TextPage {
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                    }
                    if root.page == Page.overlay: OverlayPage { }
                    if root.page == Page.test: TestPage { }
                    if root.page == Page.system: SystemPage {
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                        theme: root.theme;
                        theme-picked(choice) => {
                            root.theme = choice;
                            root.theme-changed(choice);
                        }
                    }
                    if root.page == Page.about: AboutPage {
                        free-height: scroll.visible-height - column.padding-top - column.padding-bottom - header.preferred-height;
                        app-name: root.app-name;
                        version: root.version;
                        licence: root.licence;
                        repository: root.repository;
                    }
                }
            }
        }

        ToastHost {
            x: nav.width;
            y: 0;
            width: parent.width - nav.width;
            height: parent.height;
        }

        KeyTipHost {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }
    }
}
