// System page (SPEC System). The shell owns the theme picker (config `ui.theme`); the rest is
// `[system]`, `[history]` and `debug.log_text`, filled and read by `pages::system`.
import { Theme, Shell, Icons, Group, Card, Row, Divider, ToggleRow, TilePicker, Combo, Button, ButtonKind, NumberField, PathField, SubTabs, TextField, FocusRing, KeyFocus, Tip } from "../theme/index.slint";
import { HomeState } from "home.slint";

export enum ThemeChoice { system, dark, light }

export global SystemState {
    // The sub-tab: 0 General, 1 Recordings and files (UI rule 25: the page did not fit).
    in-out property <int> tab;
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> log-text;
    // The accent picker (DS-20.7). The presets in both themes (derived in Rust, nothing here
    // computes a colour), the preset the seed equals (-1: a custom one) and the field's text.
    in property <[string]> swatch-names;
    in property <[color]> swatch-fill-dark;
    in property <[color]> swatch-ink-dark;
    in property <[color]> swatch-fill-light;
    in property <[color]> swatch-ink-light;
    in property <int> accent-selected: -1;
    in-out property <string> accent-hex;
    // The seed in use, as `accent-hex` shows it when nothing is being typed: unconfirmed text goes back to it.
    in property <string> accent-saved;
    // Why the typed hex is refused (the field's error state, cleared by the next edit), and the
    // close-to-error notice: the Accent row's "!".
    in-out property <string> accent-error;
    in property <string> accent-notice;
    callback accent-picked(int);
    callback accent-typed(string);
    // Names of the app languages (`pages::system::APP_LANGUAGES`) and the one in use.
    in property <[string]> app-languages;
    in-out property <int> app-language;
    callback app-language-picked(int);
    callback autostart-toggled(bool);
    // Off fires only after the note is confirmed.
    callback update-check-toggled(bool);
    callback log-text-toggled(bool);
    callback open-settings-folder();
    callback open-logs-folder();
    // Recording storage. `history-folder` is the chosen folder (empty: the default one),
    // `history-path` where recordings land (the field's text, typed into), `history-problem` the
    // row's "!" text.
    in-out property <bool> history-on;
    in-out property <float> history-days;
    in-out property <float> history-gb;
    in property <string> history-folder;
    in-out property <string> history-path;
    in property <string> history-problem;
    // The config's size limit is not whole GB, so the field shows it rounded up: the row's "!".
    in property <string> history-limit-note;
    // No native folder dialog on this OS: the button is hidden.
    in property <bool> can-browse;
    callback history-toggled(bool);
    callback history-days-changed(float);
    callback history-gb-changed(float);
    // The dialog starts at this path, the field's text (DS-13.4).
    callback history-browse(string);
    // Enter in the folder field: a full path, or empty for the default folder.
    callback history-folder-typed(string);
    // The page was opened: the chosen folder may have gone since the last look.
    callback history-check();
}

// DS-20.7: ten 20 px swatches 6 px apart and the seed's hex field, packed to the column's right
// edge (DS-3.7). Arrow keys move through the swatches, Space or Enter picks.
component AccentPicker inherits Rectangle {
    callback picked(int);
    callback typed(string);
    property <[color]> fills: Theme.dark ? SystemState.swatch-fill-dark : SystemState.swatch-fill-light;
    property <[color]> inks: Theme.dark ? SystemState.swatch-ink-dark : SystemState.swatch-ink-light;
    property <length> swatch-size: 20px;
    property <length> pitch: 26px;
    property <length> strip-width: SystemState.swatch-names.length * root.pitch - (root.pitch - root.swatch-size);
    property <int> cursor;
    property <bool> key-focus;
    // The column's width, contents laid from its right edge: in the narrow column (240) the
    // swatches reach left over the Row's free title space instead of past the card.
    min-width: Theme.control-column;
    preferred-width: Theme.control-column;
    height: Theme.control-height;
    accessible-role: radio-group;
    accessible-label: @tr("Accent");

    // The cells are the full control height and half a gap wider than the swatch each side.
    strip := Rectangle {
        x: root.width - Theme.control-side - Theme.control-gap - root.strip-width;
        width: root.strip-width;
        height: 100%;
        for name[i] in SystemState.swatch-names: Rectangle {
            x: i * root.pitch;
            width: root.swatch-size;
            height: root.swatch-size;
            circle := Rectangle {
                background: root.fills[i];
                border-radius: Theme.radius-round;
                if SystemState.accent-selected == i: Image {
                    width: 12px;
                    height: 12px;
                    source: Icons.checkmark-12;
                    colorize: root.inks[i];
                    accessible-role: none;
                }
                FocusRing {
                    radius: Theme.radius-round;
                    shown: root.key-focus && strip-fs.has-focus && root.cursor == i;
                }
            }
            // Hover: a 2 px ring 2 px outside the swatch, drawn over the row's own free space.
            Rectangle {
                visible: touch.has-hover && !Shell.locked;
                x: -4px;
                y: -4px;
                width: parent.width + 8px;
                height: parent.height + 8px;
                border-width: 2px;
                border-color: Theme.stroke-keycap;
                border-radius: Theme.radius-round;
            }
            touch := TouchArea {
                x: -(root.pitch - root.swatch-size) / 2;
                y: -(Theme.control-height - root.swatch-size) / 2;
                width: root.pitch;
                height: Theme.control-height;
                enabled: !Shell.locked;
                mouse-cursor: pointer;
                clicked => {
                    root.cursor = i;
                    root.picked(i);
                }
                Tip {
                    text: name;
                    hovered: touch.has-hover;
                }
            }
            accessible-role: radio-button;
            accessible-label: name;
            accessible-checked: SystemState.accent-selected == i;
        }
        strip-fs := FocusScope {
            enabled: !Shell.locked;
            focus-on-click: false;
            focus-gained(reason) => {
                root.key-focus = KeyFocus.after(reason, root.key-focus);
                root.cursor = max(0, SystemState.accent-selected);
            }
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) {
                    root.cursor = max(0, root.cursor - 1);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.cursor = min(SystemState.swatch-names.length - 1, root.cursor + 1);
                    return accept;
                }
                if (event.text == " " || event.text == "\n") {
                    root.picked(root.cursor);
                    return accept;
                }
                reject
            }
        }
    }
    field := TextField {
        x: root.width - Theme.control-side;
        width: Theme.control-side;
        text <=> SystemState.accent-hex;
        accessible-label: @tr("Accent colour as hex");
        invalid: SystemState.accent-error != "";
        invalid-tip: SystemState.accent-error;
        // Only Enter applies: text left behind is neither applied nor saved, so it does not stay.
        // shortcut: Alt+Tab away also puts it back (a 7-character seed; the folder field keeps its text),
        // keep it unless owners miss the typed text.
        changed has-focus => {
            if (!self.has-focus) {
                SystemState.accent-hex = SystemState.accent-saved;
                SystemState.accent-error = "";
            }
        }
        edited(text) => {
            SystemState.accent-error = "";
        }
        accepted(text) => {
            root.typed(text);
        }
    }
}

export component SystemPage inherits VerticalLayout {
    in property <ThemeChoice> theme;
    callback theme-picked(ThemeChoice);
    // The page's own room in the window: in a low one General tightens up (UI rule 25).
    in property <length> free-height;
    property <bool> tight: root.free-height < Theme.system-tight-height;
    // The update switch was turned off: it stays on until the note is confirmed (SPEC Settings UI).
    // The note and its buttons take the row's title and switch, so the row keeps its height.
    property <bool> confirm-update-off;
    // The swap removes the focused control, so focus moves with it, ringed only for the keyboard.
    property <bool> confirm-by-key;
    // Text was typed into the folder field and not yet saved (Enter) or put back.
    property <bool> path-typed;
    // Puts the saved path back over unsaved text in the folder field; Enter is the only save.
    function put-back-path() {
        if (root.path-typed) {
            root.path-typed = false;
            SystemState.history-check();
        }
    }
    alignment: start;
    // DS-1.3: the first group sits `header-bottom` under the tab line, as on every page.
    spacing: Theme.header-bottom;
    init => {
        SystemState.history-check();
    }
    SubTabs {
        items: [@tr("General"), @tr("Recordings and files")];
        selected: SystemState.tab;
        picked(i) => {
            // The field goes with its tab, so its focus loss is never seen.
            root.put-back-path();
            SystemState.tab = i;
        }
    }
    if SystemState.tab == 0: VerticalLayout {
    alignment: start;
    spacing: root.tight ? Theme.space-4 : Theme.group-gap;
    Group {
        title: @tr("Appearance");
        TilePicker {
            accessible-label: @tr("Theme");
            columns: 3;
            tile-height: root.tight ? Theme.tile-height-short : Theme.tile-height;
            tiles: [
                { icon: Icons.dark-theme-24, icon-selected: Icons.dark-theme-24-filled, title: @tr("System") },
                { icon: Icons.weather-sunny-24, icon-selected: Icons.weather-sunny-24-filled, title: @tr("Light") },
                { icon: Icons.weather-moon-24, icon-selected: Icons.weather-moon-24-filled, title: @tr("Dark") },
            ];
            selected: root.theme == ThemeChoice.light ? 1 : root.theme == ThemeChoice.dark ? 2 : 0;
            picked(i) => {
                root.theme-picked(i == 1 ? ThemeChoice.light : i == 2 ? ThemeChoice.dark : ThemeChoice.system);
            }
        }
        Card {
            Row {
                title: @tr("Accent");
                // A refused hex shows in the field itself (DS-8.7); the row's "!" is the notice.
                warning: SystemState.accent-notice;
                AccentPicker {
                    picked(i) => {
                        SystemState.accent-picked(i);
                    }
                    typed(text) => {
                        SystemState.accent-typed(text);
                    }
                }
            }
            Divider { }
            // No icon: no other System row has one, and titles start at one x (UI rule 9).
            Row {
                title: @tr("App language");
                info: @tr("Menus and labels of this window. It does not change the language you dictate in.");
                // The Combo spans the column (DS-3.1), as on Audio.
                fill-controls: true;
                Combo {
                    model: SystemState.app-languages;
                    current-index <=> SystemState.app-language;
                    accessible-label: @tr("App language");
                    selected => {
                        SystemState.app-language-picked(self.current-index);
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Startup and updates");
        Card {
            ToggleRow {
                flat: true;
                title: @tr("Start at sign-in");
                checked <=> SystemState.autostart;
                toggled(on) => {
                    SystemState.autostart-toggled(on);
                }
            }
            Divider { }
            Rectangle {
                min-height: update-row.min-height;
                preferred-height: update-row.preferred-height;
                update-row := ToggleRow {
                    visible: !root.confirm-update-off;
                    flat: true;
                    title: @tr("Check for updates");
                    info: @tr("Once a day OxiYapper asks GitHub for the latest version. Nothing installs on its own.");
                    checked <=> SystemState.update-check;
                    toggled(on) => {
                        if (on) {
                            root.confirm-update-off = false;
                            SystemState.update-check-toggled(true);
                        } else {
                            self.checked = true;
                            root.confirm-by-key = self.key-focused;
                            root.confirm-update-off = true;
                        }
                    }
                }
                if root.confirm-update-off: Row {
                    init => {
                        keep.take-focus(root.confirm-by-key);
                    }
                    title: @tr("Update checks tell you when a fix is out.");
                    Button {
                        text: @tr("Turn off");
                        kind: ButtonKind.soft;
                        // The risky choice the confirmation guards turns red under the pointer (UI rule 16).
                        destructive: true;
                        accessible-label: @tr("Turn off update checks");
                        clicked => {
                            root.confirm-update-off = false;
                            update-row.take-focus(self.key-focused);
                            SystemState.update-check = false;
                            SystemState.update-check-toggled(false);
                        }
                    }
                    keep := Button {
                        text: @tr("Keep checking");
                        kind: ButtonKind.primary;
                        clicked => {
                            root.confirm-update-off = false;
                            update-row.take-focus(self.key-focused);
                        }
                    }
                }
            }
        }
    }
    }
    if SystemState.tab == 1: Card {
            // Its own row: two limit fields and the switch (252 px) overflow the 240 px column.
            ToggleRow {
                flat: true;
                title: @tr("Save recordings");
                checked <=> SystemState.history-on;
                toggled(on) => {
                    root.put-back-path();
                    SystemState.history-toggled(on);
                }
            }
            Divider { }
            Row {
                title: @tr("Keep recordings");
                // Limits act on the folder below, saving on or off; an earlier folder is never touched
                // (SPEC History, owner 2026-11-10).
                info: @tr("Keeps audio and text in the folder below up to these limits. Older ones are deleted, even while off.");
                warning: SystemState.history-limit-note;
                NumberField {
                    value <=> SystemState.history-days;
                    maximum: 999;
                    unit: @tr("days");
                    zero-text: @tr("Forever");
                    accessible-label: @tr("Keep recordings for");
                    changed has-focus => {
                        if (self.has-focus) {
                            root.put-back-path();
                        }
                    }
                    changed(days) => {
                        SystemState.history-days-changed(days);
                    }
                }
                NumberField {
                    value <=> SystemState.history-gb;
                    maximum: 999;
                    unit: @tr("GB");
                    zero-text: @tr("No limit");
                    accessible-label: @tr("Recordings size limit");
                    changed has-focus => {
                        if (self.has-focus) {
                            root.put-back-path();
                        }
                    }
                    changed(gb) => {
                        SystemState.history-gb-changed(gb);
                    }
                }
            }
            Divider { }
            // Browse and Open under the field, outside the Row: its title sits on the field's line.
            VerticalLayout {
                spacing: Theme.space-2;
                Row {
                    title: @tr("Recordings folder");
                    warning: SystemState.history-problem;
                    // DS-3.1: the path fills the control column; under it Browse and Open, both labelled
                    // (items 7, 44): three controls do not fit one 240 px column.
                    fill-controls: true;
                    // Moving focus to another control (Tab, a click on a limit field, a button or switch)
                    // with the field unsaved puts the saved path back; Enter is the only save. Buttons and
                    // switches take no focus on a click, so they put it back themselves. The field losing
                    // focus alone (Alt+Tab away) keeps the typed text.
                    PathField {
                        path <=> SystemState.history-path;
                        display: SystemState.history-folder == "" ? @tr("Default folder") : "";
                        // The field inside takes the label; the frame itself is no element of its own.
                        accessible-role: none;
                        accessible-label: @tr("Recordings folder");
                        edited(text) => {
                            root.path-typed = true;
                        }
                        accepted(text) => {
                            root.path-typed = false;
                            SystemState.history-folder-typed(text);
                        }
                        tabbed => {
                            root.put-back-path();
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.control-gap;
                    if SystemState.can-browse: Button {
                        text: @tr("Browse");
                        accessible-label: @tr("Change recordings folder");
                        enabled: !Shell.locked;
                        tooltip: Shell.locked-tip;
                        clicked => {
                            root.path-typed = false;
                            SystemState.history-browse(SystemState.history-path);
                            // The dialog blocks: a cancel leaves the typed text, put the saved path back.
                            SystemState.history-check();
                        }
                    }
                    // Only opens Explorer: live while the config is locked.
                    Button {
                        text: @tr("Open");
                        kind: ButtonKind.soft;
                        icon: Icons.folder-open;
                        accessible-label: @tr("Open recordings folder");
                        clicked => {
                            root.put-back-path();
                            HomeState.open-history();
                        }
                    }
                }
            }
            Divider { }
            Row {
                title: @tr("Open a folder");
                Button {
                    text: @tr("Settings");
                    kind: ButtonKind.soft;
                    icon: Icons.folder-open;
                    accessible-label: @tr("Open settings folder");
                    clicked => {
                        root.put-back-path();
                        SystemState.open-settings-folder();
                    }
                }
                Button {
                    text: @tr("Logs");
                    kind: ButtonKind.soft;
                    icon: Icons.folder-open;
                    accessible-label: @tr("Open logs folder");
                    clicked => {
                        root.put-back-path();
                        SystemState.open-logs-folder();
                    }
                }
            }
            Divider { }
            ToggleRow {
                flat: true;
                title: @tr("Log dictated text");
                warning: SystemState.log-text ? @tr("Dictated text is written to the log files while this is on. Turn it off when you are done.") : "";
                checked <=> SystemState.log-text;
                toggled(on) => {
                    root.put-back-path();
                    SystemState.log-text-toggled(on);
                }
            }
    }
}
