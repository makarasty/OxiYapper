// Text page (SPEC Text): dictionary.txt with its prompt token budget, replace.txt with the lines
// it ignores, and how text is pasted (mode, trailing space, restore delay, per-app rules).
import { Palette, Button, ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Shell, Group, Row, ToggleRow, SliderRow, ThumbPicker, InlineNote } from "../widgets.slint";

export enum TextFile { dictionary, replacements }

// How a text file was read. `converted`: UTF-16 or a BOM, Save writes plain UTF-8.
// `not-text` and `unreadable` (an io error, its kind in `FileInfo.error`): the editor stays
// empty and Save is off, so the file is never wiped.
export enum FileState { ok, converted, not-text, unreadable }

export struct FileInfo {
    state: FileState,
    error: string,
    // What was on disk when the editor last matched it ("missing", or length and hash). Kept
    // here so a rebind after Reset still knows it; Save writes only while the disk still has it.
    base: string,
    // Edited since the last load or save.
    dirty: bool,
    // Save or a re-check found the file changed on disk while the editor was dirty; `error`
    // then names the read error if the file cannot be read now.
    conflict: bool,
}

// One per-app paste rule. `mode`: 0 the global mode, 1 clipboard, 2 type.
export struct PasteRuleRow {
    app: string,
    mode: int,
}

// Filled and read by `pages::text`.
export global TextState {
    in-out property <string> dictionary;
    in property <FileInfo> dictionary-info;
    // Tokens of the whole dictionary, and the most whisper keeps.
    in property <int> tokens;
    in property <int> budget;
    // 1-based first line left out of the prompt (it and every line after it); 0 when all fit.
    in property <int> dropped-from;
    in-out property <string> replacements;
    in property <FileInfo> replacements-info;
    // Numbers of the lines without "=>", comma separated; empty when every line parses.
    in property <string> bad-lines;
    // 0 clipboard, 1 type.
    in-out property <int> paste-mode;
    in-out property <bool> trailing-space;
    in-out property <float> restore-delay-ms;
    in property <[PasteRuleRow]> rules;
    // The app of a refused duplicate rule; empty hides the note.
    in property <string> duplicate-app;
    // The page came into view: files with no unsaved edits are read again.
    callback shown();
    callback edited(TextFile, string);
    callback save(TextFile);
    callback open(TextFile);
    callback reload(TextFile);
    callback overwrite(TextFile);
    callback paste-mode-picked(int);
    callback trailing-space-toggled(bool);
    callback restore-delay-changed(float);
    callback rule-mode-picked(int, int);
    callback rule-removed(int);
    callback rule-added(string);
}

// An editor for one text file: the text, a status line (the children) with Open file and Save,
// and the notes about how the file was read.
component FileEditor inherits VerticalLayout {
    in property <TextFile> file;
    in property <string> name;
    in property <string> label;
    in property <FileInfo> info;
    in property <length> editor-height;
    in-out property <string> text;
    property <bool> readable: root.info.state != FileState.not-text && root.info.state != FileState.unreadable;
    TextEdit {
        height: root.editor-height;
        text <=> root.text;
        enabled: root.readable;
        accessible-label: root.label;
        edited(text) => {
            TextState.edited(root.file, text);
        }
    }
    HorizontalLayout {
        spacing: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            @children
            if root.info.dirty: Text {
                text: @tr("Unsaved changes");
                font-size: 11px;
                color: Palette.foreground;
                opacity: 0.7;
            }
        }
        Button {
            text: @tr("Open file");
            accessible-label: @tr("Open {}", root.name);
            clicked => {
                TextState.open(root.file);
            }
        }
        Button {
            text: @tr("Save");
            accessible-label: @tr("Save {}", root.name);
            enabled: root.readable;
            clicked => {
                TextState.save(root.file);
            }
        }
    }
    if root.info.conflict: InlineNote {
        text: root.info.error != "" ? @tr("Could not read {} on disk: {}.", root.name, root.info.error) : @tr("{} changed on disk since it was loaded.", root.name);
        Button {
            text: @tr("Reload");
            accessible-label: @tr("Reload {}", root.name);
            clicked => {
                TextState.reload(root.file);
            }
        }
        Button {
            text: @tr("Overwrite");
            accessible-label: @tr("Overwrite {}", root.name);
            clicked => {
                TextState.overwrite(root.file);
            }
        }
    }
    if !root.readable: InlineNote {
        text: root.info.state == FileState.unreadable ? @tr("Could not read {}: {}.", root.name, root.info.error) : @tr("{} is not UTF-8 or UTF-16 text: fix it in a text editor.", root.name);
        Button {
            text: @tr("Reload");
            accessible-label: @tr("Reload {}", root.name);
            clicked => {
                TextState.reload(root.file);
            }
        }
    }
    if root.info.state == FileState.converted: Text {
        text: @tr("Saved as UTF-16 or with a BOM: Save rewrites it as UTF-8.");
        wrap: word-wrap;
        font-size: 11px;
        color: Palette.foreground;
    }
}

// Scrolls only when notes and banners outgrow the window.
export component TextPage inherits ScrollView {
    init => {
        TextState.shown();
    }
    preferred-height: content.preferred-height;
    max-height: content.preferred-height;
    min-height: 0;
    content-width: self.visible-width;
    content-height: content.preferred-height;
    content := VerticalLayout {
        width: root.visible-width;
        // Room for the scrollbar, so it does not sit on the boxes' border.
        padding-right: 10px;
        spacing: 8px;
        Group {
            title: @tr("Dictionary: words that help whisper, one per line");
            FileEditor {
                file: TextFile.dictionary;
                name: "dictionary.txt";
                label: @tr("Dictionary");
                info: TextState.dictionary-info;
                editor-height: 72px;
                text <=> TextState.dictionary;
                Text {
                    text: @tr("{} / {} tokens", TextState.tokens, TextState.budget);
                    color: TextState.dropped-from > 0 ? Shell.error-text : Palette.foreground;
                }
                if TextState.dropped-from > 0: Text {
                    text: @tr("Over the limit: line {} and after are not sent.", TextState.dropped-from);
                    wrap: word-wrap;
                    font-size: 11px;
                    color: Shell.error-text;
                }
            }
        }
        Group {
            title: @tr("Replacements: heard => wanted, one per line");
            FileEditor {
                file: TextFile.replacements;
                name: "replace.txt";
                label: @tr("Replacements");
                info: TextState.replacements-info;
                editor-height: 64px;
                text <=> TextState.replacements;
                Text {
                    text: TextState.bad-lines == "" ? @tr("Every line has =>.") : @tr("Ignored, no =>: line {}", TextState.bad-lines);
                    wrap: word-wrap;
                    color: TextState.bad-lines == "" ? Palette.foreground : Shell.error-text;
                }
            }
        }
        Group {
            title: @tr("Paste");
            ThumbPicker {
                accessible-label: @tr("Paste mode");
                thumbs: [
                    { image: @image-url("../img/text-clipboard.svg"), caption: @tr("Clipboard") },
                    { image: @image-url("../img/text-type.svg"), caption: @tr("Type") },
                ];
                selected: TextState.paste-mode;
                picked(i) => {
                    TextState.paste-mode = i;
                    TextState.paste-mode-picked(i);
                }
            }
            ToggleRow {
                label: @tr("Trailing space");
                checked <=> TextState.trailing-space;
                toggled(on) => {
                    TextState.trailing-space-toggled(on);
                }
            }
            SliderRow {
                label: @tr("Restore clipboard after");
                minimum: 0;
                maximum: 1000;
                step: 25;
                value <=> TextState.restore-delay-ms;
                value-text: @tr("{} ms", round(TextState.restore-delay-ms));
                changed(v) => {
                    TextState.restore-delay-changed(v);
                }
            }
            ListView {
                height: 64px;
                for rule[i] in TextState.rules: Row {
                    label: rule.app;
                    ComboBox {
                        width: 110px;
                        model: [@tr("Default"), @tr("Clipboard"), @tr("Type")];
                        current-index: rule.mode;
                        enabled: !Shell.locked;
                        accessible-label: @tr("Mode for {}", rule.app);
                        selected => {
                            TextState.rule-mode-picked(i, self.current-index);
                        }
                    }
                    Button {
                        text: @tr("Remove");
                        accessible-label: @tr("Remove {}", rule.app);
                        enabled: !Shell.locked;
                        clicked => {
                            TextState.rule-removed(i);
                        }
                    }
                }
            }
            Row {
                label: @tr("Per-app rule");
                new-app := LineEdit {
                    width: 150px;
                    placeholder-text: @tr("app.exe");
                    enabled: !Shell.locked;
                    accessible-label: @tr("New rule app");
                }
                Button {
                    text: @tr("Add");
                    accessible-label: @tr("Add rule");
                    enabled: !Shell.locked && new-app.text != "";
                    clicked => {
                        TextState.rule-added(new-app.text);
                        new-app.text = "";
                    }
                }
            }
            if TextState.duplicate-app != "": InlineNote {
                text: @tr("{} already has a rule: change its mode in the list above.", TextState.duplicate-app);
            }
        }
    }
}
