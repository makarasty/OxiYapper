// Audio page (SPEC Recording, Audio before whisper): microphone, live meter, the DSP switches,
// tail, recording cap and dictation language.
import { Theme, Group, Card, Row, Divider, ToggleRow, SliderRow, Combo, Segmented, Button, Meter, Note, Severity } from "../theme/index.slint";

// Which control changed; `value` of `AudioState.edited` carries its new value.
export enum AudioKey { device, gain, sensitivity, normalize, trim, denoise, tail, max-minutes, language }

// Filled and read by `pages::audio`.
export global AudioState {
    // "System default" first, then the input devices.
    in property <[string]> devices;
    in-out property <int> device;
    in-out property <float> gain-db;
    in-out property <float> sensitivity-db;
    in-out property <bool> normalize;
    in-out property <bool> trim;
    in-out property <bool> denoise;
    in-out property <float> tail-ms;
    in-out property <float> max-minutes;
    // The defaults of `Config::default()`: a double click on a slider's thumb returns to them.
    in property <float> default-gain-db;
    in property <float> default-sensitivity-db;
    in property <float> default-tail-ms;
    in property <float> default-max-minutes;
    // 0 ru, 1 en, 2 auto.
    in property <int> language;
    // Live meter: bar heights 0..1, oldest first.
    in property <[float]> bars;
    in property <bool> clipping;
    // True while the page holds the microphone open.
    in property <bool> live;
    // Why there is no meter ("No microphone"), shown while `live` is off.
    in property <string> note;
    // The configured mic is missing and the meter runs on the system default; empty otherwise.
    in property <string> fallback;
    // Listing the devices failed (the error kind); empty otherwise.
    in property <string> list-error;
    // The open mic gives only exact zeros (muted or switched off); empty otherwise.
    in property <string> silence;
    // The Test button: true while it records and plays back; its status line.
    in property <bool> testing;
    in property <string> test-status;
    callback shown();
    callback edited(AudioKey, float);
    callback test();
}

export component AudioPage inherits VerticalLayout {
    alignment: start;
    spacing: Theme.group-gap;
    init => {
        AudioState.shown();
    }
    Group {
        title: @tr("Microphone");
        Card {
            Row {
                title: @tr("Device");
                Combo {
                    model: AudioState.devices;
                    current-index <=> AudioState.device;
                    accessible-label: @tr("Device");
                    selected => {
                        AudioState.edited(AudioKey.device, self.current-index);
                    }
                }
            }
            if AudioState.list-error != "": Note {
                text: AudioState.list-error;
                severity: Severity.error;
            }
            if AudioState.fallback != "": Note {
                text: AudioState.fallback;
                severity: Severity.warning;
            }
            Divider { }
            Row {
                title: @tr("Level");
                fill-controls: true;
                Meter {
                    bars: AudioState.bars;
                    live: AudioState.live;
                    clipping: AudioState.clipping;
                    empty-text: AudioState.note;
                    accessible-label: !AudioState.live ? AudioState.note : AudioState.clipping ? @tr("Level, clipping") : @tr("Level");
                }
            }
            if AudioState.silence != "": Note {
                text: AudioState.silence;
                severity: Severity.warning;
            }
            Divider { }
            Row {
                title: @tr("Mic test");
                description: @tr("Records 3 seconds and plays them back.");
                Button {
                    text: @tr("Test");
                    enabled: !AudioState.testing;
                    tooltip: @tr("A test is running");
                    clicked => {
                        AudioState.test();
                    }
                }
            }
            if AudioState.test-status != "": Note {
                text: AudioState.test-status;
            }
            Divider { }
            SliderRow {
                title: @tr("Gain");
                description: @tr("Boosts or cuts what Whisper hears.");
                minimum: -20;
                maximum: 20;
                bipolar: true;
                signed: true;
                unit: "dB";
                default-value: AudioState.default-gain-db;
                value <=> AudioState.gain-db;
                changed(v) => {
                    AudioState.edited(AudioKey.gain, v);
                }
            }
            Divider { }
            SliderRow {
                title: @tr("Meter sensitivity");
                description: @tr("Only changes how the meter looks.");
                minimum: -20;
                maximum: 20;
                bipolar: true;
                signed: true;
                unit: "dB";
                default-value: AudioState.default-sensitivity-db;
                value <=> AudioState.sensitivity-db;
                changed(v) => {
                    AudioState.edited(AudioKey.sensitivity, v);
                }
            }
        }
    }
    Group {
        title: @tr("Processing");
        ToggleRow {
            title: @tr("Normalise level");
            description: @tr("Evens out quiet and loud speech.");
            checked <=> AudioState.normalize;
            toggled(on) => {
                AudioState.edited(AudioKey.normalize, on ? 1 : 0);
            }
        }
        ToggleRow {
            title: @tr("Trim silence");
            description: @tr("Cuts silence at the start and end.");
            checked <=> AudioState.trim;
            toggled(on) => {
                AudioState.edited(AudioKey.trim, on ? 1 : 0);
            }
        }
        ToggleRow {
            title: @tr("Noise suppression");
            // While on, the warning below says it: no second copy here.
            description: AudioState.denoise ? "" : @tr("Can make Whisper worse; off by default.");
            checked <=> AudioState.denoise;
            toggled(on) => {
                AudioState.edited(AudioKey.denoise, on ? 1 : 0);
            }
        }
        if AudioState.denoise: Note {
            inset: true;
            text: @tr("Noise suppression can make Whisper worse.");
            severity: Severity.warning;
        }
    }
    Group {
        title: @tr("Recording");
        Card {
            SliderRow {
                title: @tr("Tail after release");
                description: @tr("Keeps recording a moment after you let go.");
                minimum: 0;
                maximum: 1000;
                step: 50;
                unit: "ms";
                default-value: AudioState.default-tail-ms;
                value <=> AudioState.tail-ms;
                changed(v) => {
                    AudioState.edited(AudioKey.tail, v);
                }
            }
            Divider { }
            SliderRow {
                title: @tr("Max length");
                description: @tr("Recording stops at this length.");
                minimum: 1;
                maximum: 30;
                unit: "min";
                default-value: AudioState.default-max-minutes;
                value <=> AudioState.max-minutes;
                changed(v) => {
                    AudioState.edited(AudioKey.max-minutes, v);
                }
            }
            Divider { }
            Row {
                title: @tr("Language");
                Segmented {
                    accessible-label: @tr("Language");
                    min-width: Theme.segmented-min-width;
                    items: [@tr("RU"), @tr("EN"), @tr("Auto")];
                    selected: AudioState.language;
                    picked(i) => {
                        AudioState.edited(AudioKey.language, i);
                    }
                }
            }
        }
    }
}
