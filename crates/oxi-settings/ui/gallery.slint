    property <[string]> positions: ["Top left", "Top centre", "Top right", "Bottom left", "Bottom centre", "Bottom right"];
    property <[float]> bars: [0.1, 0.2, 0.15, 0.3, 0.5, 0.42, 0.6, 0.35, 0.2, 0.7, 0.85, 1.0, 0.9, 0.55, 0.4, 0.3, 0.45, 0.62, 0.5, 0.33, 0.2, 0.12, 0.25, 0.4, 0.58, 0.72, 0.5, 0.3, 0.2, 0.1, 0.18, 0.3, 0.52, 0.66, 0.48, 0.3];
    property <[int]> activity: [
            0, 2, 4, 2, 2, 0, 0, 0, 1, 0, 4, 2, 0, 0, 0, 0, 4, 2, 3, 3, 1, 1, 1, 0, 0, 4, 3, 0,
            0, 0, 3, 3, 2, 0, 2, 0, 2, 3, 1, 4, 0, 0, 0, 0, 1, 3, 0, 4, 0, 0, 2, 1, 2, 2, 4, 0,
            2, 4, 3, 2, 2, 2, 2, 0, 3, 4, 0, 0, 1, 1, 1, 2, 2, 4, 0, 1, 0, 2, 0, 1, 3, 0, 3, 1,
            0, 3, 0, 3, 0, 0, 2, 0, 3, 3, 1, 2, 2, 1, 0, 0, 2, 1, 3, 3, 0, 2, 0, 3, 3, 2, 3, 2,
            1, 0, 0, 0, 1, 0, 0, 2, 0, 3, 2, 2, 1, 0, 2, 3, 1, 0, 2, 2, 0, 0, 1, 2, 1, 3, 0, 1,
            0, 1, 0, 0, 1, 2, 1, 0, 0, 0, 4, 4, 0, 0, 0, 4, 3, 1, 0, 1, 1, 1, 4, 3, 2, 1, 3, 0,
            1, 3, 3, 0, 1, 3, 1, 0, 2, 3, 3, 1];
    property <[MonthLabel]> months: [
        { week: 0, text: "May" },
        { week: 3, text: "Jun" },
        { week: 7, text: "Jul" },
        { week: 12, text: "Aug" },
        { week: 16, text: "Sep" },
        { week: 20, text: "Oct" },
        { week: 25, text: "Nov" },
    ];
    property <[string]> devices: ["Microphone (USB Audio)", "Headset (Bluetooth)"];

    padding: Theme.page-padding;
    spacing: Theme.group-gap;

    PageHeader {
        padding-top: 0;
        title: "OxiYapper design system";
        caption: Theme.dark ? "Dark theme. Every value comes from theme/tokens.slint." : "Light theme. Every value comes from theme/tokens.slint.";
    }

    Section {
        title: "Colour";
        note: "Hex read back from the tokens; ratios are WCAG 2, computed by Contrast.ratio from the token values.";
        for r in ceil(root.swatches.length / 6): HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            for c in 6: SwatchView {
                visible: r * 6 + c < root.swatches.length;
                s: root.swatches[r * 6 + c];
            }
        }
    }

    Section {
        title: "Type";
        note: "Segoe UI Variable Text (Theme.font-family); Regular 400 and Semibold 600 only.";
        HorizontalLayout {
            spacing: Theme.space-6;
            alignment: start;
            VerticalLayout {
                spacing: Theme.space-2;
                Text {
                    text: "Title 28/36 semibold";
                    font-size: Theme.title-size;
                    font-weight: Theme.weight-strong;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Subtitle 20/28 semibold";
                    font-size: Theme.subtitle-size;
                    font-weight: Theme.weight-strong;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Body strong 14/20 semibold: group headers, tile titles";
                    font-size: Theme.body-size;
                    font-weight: Theme.weight-strong;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Body 14/20 regular: row titles, controls, body text";
                    font-size: Theme.body-size;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Caption 12/16 regular: descriptions, captions, status lines";
                    font-size: Theme.caption-size;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "Disabled text";
                    font-size: Theme.body-size;
                    color: Theme.text-disabled;
                }
            }
        }
    }

    Section {
        title: "Spacing, radii, motion";
        note: "4 px base: 4 inside a control and between cards, 8 between siblings and icon to label (pair-gap), 12 card padding vertical and header row to the first card, 16 card padding horizontal, icon gap and page padding, 24 between groups. Radii: 2 cells, 4 controls and badges, 8 cards and popups, round for circles. Focus ring: 2 px focus-ring, 2 px outside the control.";
        HorizontalLayout {
            spacing: Theme.space-4;
            alignment: start;
            for s in [Theme.space-1, Theme.space-2, Theme.space-3, Theme.space-4, Theme.space-6, Theme.space-8]: VerticalLayout {
                spacing: Theme.space-1;
                alignment: end;
                HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: s;
                        height: s;
                        background: Theme.accent;
                    }
                }
                Remark {
                    text: round(s / 1px);
                }
            }
            Rectangle {
                width: Theme.space-8;
            }
            for r in [
                { name: "small 2", radius: Theme.radius-small },
                { name: "control 4", radius: Theme.radius-control },
                { name: "keycap @28", radius: Theme.radius-keycap(28px) },
                { name: "keycap @52", radius: Theme.radius-keycap(52px) },
                { name: "card 8", radius: Theme.radius-card },
                { name: "round", radius: Theme.radius-round },
            ]: VerticalLayout {
                spacing: Theme.space-1;
                Rectangle {
                    width: 72px;
                    height: 48px;
                    border-radius: r.radius;
                    background: Theme.bg-control;
                    border-width: 1px;
                    border-color: Theme.stroke-keycap;
                }
                Remark {
                    text: r.name;
                }
            }
        }
        Remark {
            text: "Motion, read from the tokens: quick " + round(Theme.motion-quick / 1ms) + " ms (knob, thumb, hover fill), open " + round(Theme.motion-open / 1ms) + " ms (popups), ease-out; Shell.reduced-motion " + (Shell.reduced-motion ? "on: both 0." : "off.");
        }
    }

    Section {
        title: "Icons";
        note: "Phosphor 2.1.1 Bold (MIT), vendored in ui/icons. Name = Icons.<name>; -filled is the Fill weight, for a selected glyph only. 16 px in buttons and fields, 20 in rows, 32 in tiles.";
        for r in ceil(root.icon-list.length / 8): HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            for c in 8: HorizontalLayout {
                property <int> i: r * 8 + c;
                width: 150px;
                spacing: Theme.space-2;
                visible: self.i < root.icon-list.length;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.icon-list[i].image;
                        width: 20px;
                        height: 20px;
                        image-fit: contain;
                        colorize: Theme.text-primary;
                    }
                }
                Remark {
                    text: root.icon-list[i].name;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
    }

    Section {
        title: "Button";
        note: "Disabled: text-disabled, fill at 50 %, reason in the tooltip. Locked config: buttons take enabled: false. Tooltip: hover 600 ms. Danger (Cancel, Remove, Stop) rests grey and turns error-fill / error-text under the pointer, error-fill-pressed while held.";
        GridRow {
            label: "";
            Cell {
                label: "rest";
            }
            Cell {
                label: "hover";
            }
            Cell {
                label: "pressed";
            }
            Cell {
                label: "focused (keyboard)";
            }
            Cell {
                label: "disabled";
            }
        }
        for k in [
            { name: "primary", kind: ButtonKind.primary, text: "Apply", icon: Icons.add-16 },
            { name: "secondary", kind: ButtonKind.secondary, text: "Download", icon: Icons.arrow-download-16 },
            { name: "subtle", kind: ButtonKind.subtle, text: "Open file", icon: Icons.open-folder-16 },
            { name: "danger", kind: ButtonKind.danger, text: "Cancel", icon: Icons.dismiss-16 },
        ]: VerticalLayout {
            spacing: Theme.space-2;
            GridRow {
                label: k.name;
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.kind == ButtonKind.icon ? k.icon : @image-url("");
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.kind == ButtonKind.icon ? k.icon : @image-url("");
                        force-hover: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.kind == ButtonKind.icon ? k.icon : @image-url("");
                        force-pressed: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.kind == ButtonKind.icon ? k.icon : @image-url("");
                        force-focus: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.kind == ButtonKind.icon ? k.icon : @image-url("");
                        enabled: false;
                        tooltip: "Start OxiYapper to download.";
                    }
                }
            }
            if k.kind != ButtonKind.icon: GridRow {
                label: k.name + " + icon";
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.icon;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.icon;
                        force-hover: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.icon;
                        force-pressed: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.icon;
                        force-focus: true;
                    }
                }
                Cell {
                    Button {
                        kind: k.kind;
                        text: k.text;
                        icon: k.icon;
                        enabled: false;
                    }
                }
            }
        }
        GridRow {
            label: "IconButton";
            Cell {
                IconButton {
                    icon: Icons.edit-16;
                    label: "Change hotkey";
                }
            }
            Cell {
                IconButton {
                    icon: Icons.edit-16;
                    label: "Change hotkey";
                    force-hover: true;
                }
            }
            Cell {
                IconButton {
                    icon: Icons.edit-16;
                    label: "Change hotkey";
                    force-pressed: true;
                }
            }
            Cell {
                IconButton {
                    icon: Icons.edit-16;
                    label: "Change hotkey";
                    force-focus: true;
                }
            }
            Cell {
                IconButton {
                    icon: Icons.edit-16;
                    label: "Change hotkey";
                    enabled: false;
                }
            }
            Cell {
                label: "destructive, hover";
                IconButton {
                    icon: Icons.delete-16;
                    label: "Remove";
                    destructive: true;
                    force-hover: true;
                }
            }
        }
        GridRow {
            label: "geometry";
            Cell {
                width: 260px;
                label: "IconButton 32x32: glyph at (" + round(geo-icon.icon-x / 1px) + ", " + round(geo-icon.icon-y / 1px) + "), 16 px";
                geo-icon := IconButton {
                    icon: Icons.folder-open;
                    label: "Open folder";
                }
            }
            Cell {
                width: 360px;
                label: "Download: icon x " + round(geo-btn.icon-x / 1px) + ", y " + round(geo-btn.icon-y / 1px) + "; label x " + round(geo-btn.label-x / 1px) + " (gap " + round((geo-btn.label-x - geo-btn.icon-x - Theme.icon-size-small) / 1px) + " px)";
                HorizontalLayout {
                    alignment: start;
                    geo-btn := Button {
                        text: "Download";
                        icon: Icons.arrow-download-16;
                    }
                }
            }
        }
        GridRow {
            label: "tooltip";
            Cell {
                Tooltip {
                    text: "Start OxiYapper to download.";
                }
            }
            Cell {
                label: "min width " + round(Theme.button-min-width / 1px);
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Button {
                        text: "OK";
                    }
                }
            }
        }
    }

    Section {
        title: "Switch, radio, segmented";
        note: "Small items: selected = strong accent fill. Locked = read-only config (Shell.locked).";
        GridRow {
            label: "";
            Cell {
                label: "rest";
            }
            Cell {
                label: "hover";
            }
            Cell {
                label: "pressed";
            }
            Cell {
                label: "focused";
            }
            Cell {
                label: "disabled";
            }
            Cell {
                label: "locked";
            }
        }
        for on in [false, true]: GridRow {
            label: on ? "switch on" : "switch off";
            Cell {
                Switch {
                    checked: on;
                }
            }
            Cell {
                Switch {
                    checked: on;
                    force-hover: true;
                }
            }
            Cell {
                Switch {
                    checked: on;
                    force-pressed: true;
                }
            }
            Cell {
                Switch {
                    checked: on;
                    force-focus: true;
                }
            }
            Cell {
                Switch {
                    checked: on;
                    enabled: false;
                }
            }
            Cell {
                Switch {
                    checked: on;
                    locked: true;
                }
            }
        }
        GridRow {
            label: "geometry";
            Cell {
                width: 300px;
                label: "Track " + round(Theme.switch-track-width / 1px) + "x" + round(Theme.switch-track-height / 1px) + ", top " + round(geo-switch.track-y / 1px) + " px in a " + round(Theme.control-height / 1px) + " px box";
                geo-switch := Switch {
                    checked: true;
                }
            }
        }
        for on in [false, true]: GridRow {
            label: on ? "radio on" : "radio off";
            Cell {
                Radio {
                    checked: on;
                }
            }
            Cell {
                Radio {
                    checked: on;
                    hover: true;
                }
            }
            Cell { }
            Cell { }
            Cell {
                Radio {
                    checked: on;
                    enabled: false;
                }
            }
            Cell { }
        }
        GridRow {
            label: "segmented";
            Cell {
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 0;
                }
            }
            Cell {
                label: "hover EN / Auto";
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 2;
                    force-hover: 1;
                }
            }
            Cell {
                label: "pressed EN";
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 0;
                    force-pressed: 1;
                }
            }
            Cell {
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 1;
                    force-focus: true;
                }
            }
            Cell {
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 1;
                    enabled: false;
                }
            }
            Cell {
                Segmented {
                    items: ["RU", "EN", "Auto"];
                    selected: 1;
                    locked: true;
                }
            }
        }
    }

    Section {
        title: "Sub-tabs";
        note: "In the header row. The open tab: semibold, 3 px accent underline that fades in; the tab line spans the whole width. Left/Right/Home/End switch, Tab leaves the bar. Short of room, the side padding goes first; labels stay whole.";
        GridRow {
            label: "states";
            for s[i] in ["rest, Model open", "hover Settings", "pressed Settings", "focused (keyboard)"]: Cell {
                width: 280px;
                label: s;
                SubTabs {
                    items: ["Model", "Settings", "Advanced"];
                    selected: 0;
                    force-hover: i == 1 ? 1 : -1;
                    force-pressed: i == 2 ? 1 : -1;
                    force-focus: i == 3;
                }
            }
        }
        GridRow {
            label: "2, 3 tabs";
            Cell {
                width: 280px;
                label: "2 tabs";
                SubTabs {
                    items: ["Dictionary", "Replacements"];
                    selected: 1;
                }
            }
            Cell {
                width: 400px;
                label: "3 tabs, a count, hover on the open one";
                SubTabs {
                    items: ["Dictionary", "Replacements", "Per-app rules"];
                    counts: [-1, -1, 3];
                    selected: 2;
                    force-hover: 2;
                }
            }
        }
        GridRow {
            label: "5 tabs";
            Cell {
                width: 560px;
                label: "room to spare";
                SubTabs {
                    items: ["Microphone", "Recording", "Start sound", "Stop sound", "Advanced"];
                    selected: 3;
                }
            }
            Cell {
                width: 430px;
                label: "narrow window: 430 px";
                SubTabs {
                    items: ["Microphone", "Recording", "Start sound", "Stop sound", "Advanced"];
                    selected: 3;
                }
            }
        }
    }

    Section {
        title: "Slider and number field";
        note: "Bipolar sliders fill from 0. Field: Enter or blur commits (round to step, clamp); Up/Down step, Shift x10, wheel while focused; invalid text = red stroke, reverts on blur.";
        GridRow {
            label: "";
            Cell {
                label: "rest";
            }
            Cell {
                label: "hover";
            }
            Cell {
                label: "pressed";
            }
            Cell {
                label: "focused";
            }
            Cell {
                label: "disabled";
            }
            Cell {
                label: "locked";
            }
        }
        for b in [false, true]: GridRow {
            label: b ? "slider bipolar" : "slider";
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? 6 : 300;
                    bipolar: b;
                }
            }
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? -8 : 300;
                    bipolar: b;
                    force-hover: true;
                }
            }
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? 6 : 300;
                    bipolar: b;
                    force-pressed: true;
                }
            }
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? 6 : 300;
                    bipolar: b;
                    force-focus: true;
                }
            }
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? 6 : 300;
                    bipolar: b;
                    enabled: false;
                }
            }
            Cell {
                Slider {
                    minimum: b ? -20 : 0;
                    maximum: b ? 20 : 1000;
                    value: b ? 6 : 300;
                    bipolar: b;
                    locked: true;
                }
            }
        }
        GridRow {
            label: "number";
            Cell {
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                }
            }
            Cell {
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                    force-hover: true;
                }
            }
            Cell {
                label: "signed / never";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    NumberField {
                        value: 3;
                        minimum: -20;
                        maximum: 20;
                        unit: "dB";
                        signed: true;
                    }
                    NumberField {
                        value: 0;
                        maximum: 60;
                        unit: "min";
                        zero-text: "never";
                    }
                }
            }
            Cell {
                label: "focused / invalid";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    NumberField {
                        value: 300;
                        maximum: 1000;
                        unit: "ms";
                        force-focus: true;
                    }
                    NumberField {
                        value: 300;
                        maximum: 1000;
                        unit: "ms";
                        force-text: "3o0";
                    }
                }
            }
            Cell {
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                    enabled: false;
                }
            }
            Cell {
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                    locked: true;
                }
            }
        }
    }

    Section {
        title: "Inputs";
        note: "Combo, TextField, NumberField, TextArea, SearchField and PathField share one shape: 32 px, radius 4, bg-control, 1 px stroke with the darker bottom edge. Hover lifts the fill, editing draws a 1 px accent border, the keyboard adds the ring. Disabled and locked keep the fill and grey the ink.";
        GridRow {
            label: "side by side";
            HorizontalLayout {
                spacing: Theme.control-gap;
                alignment: start;
                Combo {
                    width: 200px;
                    model: root.devices;
                }
                TextField {
                    width: 160px;
                    text: "app.exe";
                }
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                }
                SearchField {
                    width: 180px;
                    text: "disc";
                }
                PathField {
                    width: 340px;
                    path: "C:\\Users\\Synth\\AppData\\Local\\OxiYapper\\models\\ggml-large-v3-turbo.bin";
                    browse-text: "Browse";
                }
            }
        }
        GridRow {
            label: "";
            for s in ["rest", "hover", "editing", "focused (keyboard)", "disabled", "locked"]: Cell {
                width: 190px;
                label: s;
            }
        }
        GridRow {
            label: "combo";
            for i in 6: Cell {
                width: 190px;
                Combo {
                    // The gallery cell is narrower than a control column.
                    min-width: 160px;
                    model: root.devices;
                    force-hover: i == 1;
                    force-focus: i == 3;
                    enabled: i != 4;
                    locked: i == 5;
                }
            }
        }
        GridRow {
            label: "text field";
            for i in 6: Cell {
                width: 190px;
                TextField {
                    text: i == 0 ? "" : "app.exe";
                    placeholder-text: "app.exe";
                    force-hover: i == 1;
                    force-editing: i == 2 || i == 3;
                    force-focus: i == 3;
                    enabled: i != 4;
                    locked: i == 5;
                }
            }
        }
        GridRow {
            label: "search";
            for i in 6: Cell {
                width: 190px;
                SearchField {
                    text: i == 0 ? "" : "discord";
                    placeholder-text: "Search apps";
                    force-hover: i == 1;
                    force-editing: i == 2 || i == 3;
                    force-focus: i == 3;
                    enabled: i != 4;
                    locked: i == 5;
                }
            }
        }
        GridRow {
            label: "number";
            for i in 6: Cell {
                width: 190px;
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                    force-hover: i == 1;
                    force-focus: i == 2 || i == 3;
                    enabled: i != 4;
                    locked: i == 5;
                }
            }
        }
        GridRow {
            label: "path";
            for i in 6: Cell {
                width: 190px;
                PathField {
                    min-width: 160px;
                    path: i == 0 ? "" : "C:\\Users\\Synth\\AppData\\Roaming\\OxiYapper\\Recordings";
                    placeholder-text: "Default folder";
                    force-hover: i == 1;
                    force-focus: i == 2 || i == 3;
                    enabled: i != 4;
                    locked: i == 5;
                }
            }
        }
        GridRow {
            label: "number, more";
            Cell {
                width: 190px;
                label: "signed / never";
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    NumberField {
                        value: 3;
                        minimum: -20;
                        maximum: 20;
                        unit: "dB";
                        signed: true;
                    }
                    NumberField {
                        value: 0;
                        maximum: 60;
                        unit: "min";
                        zero-text: "never";
                    }
                }
            }
            Cell {
                width: 190px;
                label: "invalid";
                NumberField {
                    value: 300;
                    maximum: 1000;
                    unit: "ms";
                    force-text: "3o0";
                }
            }
        }
        GridRow {
            label: "combo open";
            Cell {
                width: 260px;
                height: 120px;
                label: "the list covers the field, no ring";
                Combo {
                    model: root.devices;
                    current-index: 0;
                    force-open: true;
                    force-focus: true;
                }
            }
        }
        GridRow {
            label: "text area";
            for i in 4: Cell {
                width: 300px;
                label: ["rest", "editing", "focused (keyboard)", "locked"][i];
                TextArea {
                    text: "OxiYapper\nWhisper\nSlint\nVulkan";
                    force-editing: i == 1 || i == 2;
                    force-focus: i == 2;
                    locked: i == 3;
                }
            }
        }
    }

    Section {
        title: "Info tip, empty state, header row";
        note: "InfoTip: a 16 px info glyph in a 20 px round hover box; the hint is its tooltip (hover, keyboard focus, Enter or Space). EmptyState: centred in the box the full list takes. HeaderRow: sub-tabs left, status chip right, the tab line across.";
        GridRow {
            label: "info tip";
            Cell {
                label: "rest";
                InfoTip {
                    text: "Kept on this computer only.";
                }
            }
            Cell {
                label: "hover";
                InfoTip {
                    text: "Kept on this computer only.";
                    force-hover: true;
                }
            }
            Cell {
                label: "focused (keyboard)";
                InfoTip {
                    text: "Kept on this computer only.";
                    force-focus: true;
                }
            }
            Cell {
                width: 260px;
                label: "beside a title, pair-gap";
                HorizontalLayout {
                    spacing: Theme.pair-gap;
                    alignment: start;
                    Text {
                        text: "Save recordings";
                        font-size: Theme.body-size;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        InfoTip {
                            text: "Kept on this computer only.";
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-8;
            alignment: start;
            StateBox {
                box-height: 200px;
                label: "EmptyState with its fix";
                CardFrame {
                    EmptyState {
                        icon: Icons.app-generic;
                        text: "No apps found yet.";
                        Button {
                            text: "Scan for apps";
                            icon: Icons.arrow-download-16;
                        }
                    }
                }
            }
        }
        VerticalLayout {
            width: 880px;
            spacing: Theme.space-3;
            Remark {
                text: "HeaderRow, normal status (inert)";
            }
            HeaderRow {
                SubTabs {
                    horizontal-stretch: 0;
                    items: ["Microphone", "Recording", "Sounds"];
                    selected: 0;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                StatusChip {
                    text: "Ready";
                    tooltip: "Dictation is ready";
                }
            }
            Remark {
                text: "HeaderRow, no model: the chip has an action (hover forced)";
            }
            HeaderRow {
                title: "Home";
                Rectangle {
                    horizontal-stretch: 1;
                }
                StatusChip {
                    text: "No model";
                    tooltip: "Open Model to download one";
                    dot: Theme.warning-text;
                    actionable: true;
                    force-hover: true;
                }
            }
        }
    }

