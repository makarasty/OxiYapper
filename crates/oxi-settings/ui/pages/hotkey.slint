// Hotkey page (SPEC Recording, Settings UI): the chord as keycaps and a pencil, which toggles the
// full keyboard (click keys or press them, held keys light up); while it is open the same row reads
// "current -> new". Closing the keyboard with keys picked keeps them as a draft (a dot on the
// pencil) until the page is left. Then the mode.
import { Theme, Shell, Icons, Group, Card, Row, Divider, ToggleRow, SliderRow, Combo, KeycapRow, TilePicker, Button, ButtonKind, IconButton } from "../theme/index.slint";
import { WarningSlot } from "../theme/components/feedback.slint";
import { Keyboard, KeyCap } from "../keyboard.slint";

// Filled and read by `pages::hotkey`.
export global HotkeyState {
    // The saved chord in words, "Ctrl + Numpad 1", and the caps of its keys one by one.
    in property <string> chord;
    in property <[string]> chord-keys;
    // 0 push-to-talk, 1 toggle.
    in property <int> mode;
    // `hotkey.other_key`: 0 auto, 1 never cancel, 2 always cancel.
    in-out property <int> other-key;
    // `hotkey.esc_cancels`.
    in-out property <bool> esc-cancels;
    in property <bool> keyboard-open;
    // The keyboard is hidden but its pending keys are kept (the dot on the pencil).
    in property <bool> draft;
    // `hotkey.hold_gap_ms` as the slider shows it: 0 is off, else 100 to 1500.
    in-out property <float> hold-gap;
    // The daemon link is up: without it no key is captured and Apply is off.
    in property <bool> online;
    // Why Apply is off on this link (empty while online): its tooltip.
    in property <string> note;
    in property <[KeyCap]> caps;
    in property <float> columns;
    in property <float> rows;
    // The pending chord in words, the keys `pending-keys` shows; empty while it has no keys.
    in property <string> pending;
    // The pending keys one by one (also while the chord is refused, to show what was pressed).
    in property <[string]> pending-keys;
    // Why the pending chord cannot be saved; empty when it can.
    in property <string> error;
    // Set when a pressed chord ends the capture: 1 moves the focus to Apply, 2 to Cancel, 0 stays.
    in property <int> move-focus;
    // The page came into view.
    callback shown();
    callback change();
    callback key-clicked(string);
    // The keyboard gained (true) or lost (false) the keyboard focus: hotkey capture follows it.
    callback focused(bool);
    callback apply();
    callback cancel();
    callback mode-picked(int);
    callback other-key-picked(int);
    callback esc-cancels-toggled(bool);
    callback hold-gap-changed(float);
}

export component HotkeyPage inherits VerticalLayout {
    // The room of the page in the window (without the title and the banners).
    in property <length> free-height;
    // With the keyboard open the page must not scroll (UI rule 25): the board is capped by height
    // and Recording mode gives way.
    property <bool> mode-hidden: HotkeyState.keyboard-open && root.free-height < Theme.hotkey-full-height;
    init => {
        HotkeyState.shown();
    }
    alignment: start;
    spacing: Theme.group-gap;
    Group {
        title: @tr("Shortcut");
        Card {
            Row {
                icon: Icons.keyboard;
                title: @tr("Keys");
                info: @tr("Click keys or press them. Left and right modifiers both count.");
                // The saved chord; while editing it reads as the old value in secondary ink. In the
                // narrow 240 px column it folds into a "+N" cap (DS-28.3) instead of leaving.
                Rectangle {
                    preferred-width: chord.preferred-width;
                    min-width: HotkeyState.keyboard-open ? Theme.keycap-width : 0px;
                    chord := KeycapRow {
                        width: parent.width;
                        pack-end: true;
                        hovered: chord-area.has-hover;
                        keys: HotkeyState.chord-keys;
                        label: HotkeyState.chord;
                        muted: HotkeyState.keyboard-open;
                    }
                    chord-area := TouchArea {
                        enabled: !Shell.locked && !HotkeyState.keyboard-open;
                        mouse-cursor: self.enabled ? pointer : default;
                        clicked => {
                            HotkeyState.change();
                        }
                    }
                }
                if HotkeyState.keyboard-open: VerticalLayout {
                    alignment: center;
                    Image {
                        source: Icons.becomes;
                        width: Theme.icon-size-small;
                        height: Theme.icon-size-small;
                        colorize: Theme.text-secondary;
                        accessible-role: none;
                    }
                }
                // A slot of four caps whatever is pressed: the old chord and the arrow never move.
                if HotkeyState.keyboard-open: Rectangle {
                    preferred-width: 4 * Theme.keycap-width + 3 * Theme.keycap-gap;
                    min-width: Theme.keycap-width;
                    pending := KeycapRow {
                        width: parent.width;
                        keys: HotkeyState.pending-keys;
                        fresh: true;
                        warning: HotkeyState.error != "";
                        empty-text: @tr("Press keys");
                        label: HotkeyState.pending != "" ? @tr("New hotkey: {}", HotkeyState.pending) : @tr("No keys yet");
                    }
                }
                // Centre the button on the keycaps (DS-3.4).
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.edit-16;
                        label: @tr("Change hotkey");
                        enabled: !Shell.locked;
                        toggled: HotkeyState.keyboard-open;
                        kept-dot: HotkeyState.draft && !HotkeyState.keyboard-open;
                        tooltip: Shell.locked ? Shell.locked-tip : HotkeyState.keyboard-open ? @tr("Hide the keyboard, keep the keys") : HotkeyState.draft ? @tr("Continue the unsaved hotkey") : "";
                        clicked => {
                            HotkeyState.change();
                        }
                    }
                }
            }
        }
        // Keys pressed while it has the focus come from the daemon's hook (CaptureHotkey), which
        // swallows Tab and Esc too: so releasing a chord or pressing Esc alone hands the focus back.
        if HotkeyState.keyboard-open: board := FocusScope {
            property <int> move-focus: HotkeyState.move-focus;
            accessible-role: groupbox;
            accessible-label: @tr("Hotkey keyboard");
            init => {
                self.focus();
            }
            changed move-focus => {
                if self.move-focus == 1 {
                    apply.focus();
                } else if self.move-focus == 2 {
                    cancel.focus();
                }
            }
            focus-gained => {
                HotkeyState.focused(true);
            }
            focus-lost => {
                HotkeyState.focused(false);
            }
            // A FocusScope does not take its child's height: the panel would end above the buttons.
            min-height: panel.min-height;
            preferred-height: panel.preferred-height;
            panel := Card {
                Keyboard {
                    caps: HotkeyState.caps;
                    columns: HotkeyState.columns;
                    rows: HotkeyState.rows;
                    room: root.free-height - Theme.hotkey-tight-chrome;
                    clicked(name) => {
                        board.focus();
                        HotkeyState.key-clicked(name);
                    }
                }
                HorizontalLayout {
                    spacing: Theme.control-gap;
                    alignment: end;
                    WarningSlot {
                        text: HotkeyState.error;
                    }
                    cancel := Button {
                        text: @tr("Cancel");
                        accessible-label: @tr("Cancel hotkey change");
                        clicked => {
                            HotkeyState.cancel();
                        }
                    }
                    apply := Button {
                        text: @tr("Apply");
                        accessible-label: @tr("Apply hotkey");
                        kind: ButtonKind.primary;
                        enabled: !Shell.locked && HotkeyState.online && HotkeyState.error == "";
                        // The reason sits on the button; the banner already says OxiYapper is off.
                        tooltip: Shell.locked ? Shell.locked-tip : HotkeyState.note;
                        clicked => {
                            HotkeyState.apply();
                        }
                    }
                }
            }
        }
    }
    if !root.mode-hidden: Group {
        title: @tr("Recording mode");
        TilePicker {
            accessible-label: @tr("Recording mode");
            columns: 2;
            tiles: [
                { icon: Icons.hand-left-24, icon-selected: Icons.hand-left-24-filled, title: @tr("Push to talk"), caption: @tr("Hold the keys while you speak. Double-tap to lock.") },
                { icon: Icons.toggle-right-24, icon-selected: Icons.toggle-right-24-filled, title: @tr("Toggle"), caption: @tr("Press once to start, again to stop.") },
            ];
            selected: HotkeyState.mode;
            picked(i) => {
                HotkeyState.mode-picked(i);
            }
        }
        // Gives way to the open keyboard like the tiles: the page must not scroll (UI rule 25).
        if !HotkeyState.keyboard-open: Card {
            Row {
                title: @tr("Another key while holding");
                info: @tr("The key always reaches the app. Auto cancels only if you have not spoken yet.");
                fill-controls: true;
                Combo {
                    model: [@tr("Auto"), @tr("Never cancel"), @tr("Always cancel")];
                    current-index <=> HotkeyState.other-key;
                    accessible-label: @tr("Another key while holding");
                    selected => {
                        HotkeyState.other-key-picked(self.current-index);
                    }
                }
            }
            Divider { }
            ToggleRow {
                flat: true;
                title: @tr("Esc cancels a recording");
                checked <=> HotkeyState.esc-cancels;
                toggled(on) => {
                    HotkeyState.esc-cancels-toggled(on);
                }
            }
            // Only a held key can be let go and pressed again by accident.
            if HotkeyState.mode == 0: Divider { }
            if HotkeyState.mode == 0: SliderRow {
                title: @tr("Continue after a short re-press");
                info: @tr("Let go of the keys and press them again within this time, and the same dictation goes on. Off starts a new one.");
                minimum: 0;
                maximum: 1500;
                step: 100;
                default-value: 400;
                unit: "ms";
                zero-text: @tr("Off");
                value <=> HotkeyState.hold-gap;
                changed(v) => {
                    HotkeyState.hold-gap-changed(v);
                }
            }
        }
    }
}
