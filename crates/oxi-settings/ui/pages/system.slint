// System page (SPEC System). The shell owns the theme picker (config `ui.theme`); the rest is
// `[system]`, `[history]` and `debug.log_text`, filled and read by `pages::system`.
import { Theme, Shell, Icons, Group, Card, Row, Divider, ToggleRow, TilePicker, Combo, Button, ButtonKind, Switch, NumberField, Tip, SubTabs } from "../theme/index.slint";
import { HomeState } from "home.slint";

export enum ThemeChoice { system, dark, light }

export global SystemState {
    // The sub-tab: 0 General, 1 Recordings and files (UI rule 25: the page did not fit).
    in-out property <int> tab;
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> log-text;
    // Names of the app languages (`pages::system::APP_LANGUAGES`) and the one in use.
    in property <[string]> app-languages;
    in-out property <int> app-language;
    callback app-language-picked(int);
    callback autostart-toggled(bool);
    // Off fires only after the note is confirmed.
    callback update-check-toggled(bool);
    callback log-text-toggled(bool);
    callback open-settings-folder();
    callback open-logs-folder();
    // Recording storage. `history-folder` is the chosen folder (empty: the default one),
    // `history-path` where recordings land, `history-problem` the row's "!" text.
    in-out property <bool> history-on;
    in-out property <float> history-days;
    in-out property <float> history-gb;
    in property <string> history-folder;
    in property <string> history-path;
    in property <string> history-problem;
    // The config's size limit is not whole GB, so the field shows it rounded up: the row's "!".
    in property <string> history-limit-note;
    // No native folder dialog on this OS: the button is hidden.
    in property <bool> can-browse;
    callback history-toggled(bool);
    callback history-days-changed(float);
    callback history-gb-changed(float);
    callback history-browse();
    // The page was opened: the chosen folder may have gone since the last look.
    callback history-check();
}

export component SystemPage inherits VerticalLayout {
    in property <ThemeChoice> theme;
    callback theme-picked(ThemeChoice);
    // The page's own room in the window: in a low one General tightens up (UI rule 25).
    in property <length> free-height;
    property <bool> tight: root.free-height < Theme.system-tight-height;
    // The update switch was turned off: it stays on until the note is confirmed (SPEC Settings UI).
    // The note and its buttons take the row's title and switch, so the row keeps its height.
    property <bool> confirm-update-off;
    // The swap removes the focused control, so focus moves with it, ringed only for the keyboard.
    property <bool> confirm-by-key;
    alignment: start;
    spacing: Theme.space-4;
    init => {
        SystemState.history-check();
    }
    SubTabs {
        items: [@tr("General"), @tr("Recordings and files")];
        selected: SystemState.tab;
        picked(i) => {
            SystemState.tab = i;
        }
    }
    if SystemState.tab == 0: VerticalLayout {
    alignment: start;
    spacing: root.tight ? Theme.space-4 : Theme.group-gap;
    Group {
        title: @tr("Appearance");
        TilePicker {
            accessible-label: @tr("Theme");
            columns: 3;
            tile-height: root.tight ? Theme.tile-height-short : Theme.tile-height;
            tiles: [
                { icon: Icons.dark-theme-24, icon-selected: Icons.dark-theme-24-filled, title: @tr("System") },
                { icon: Icons.weather-sunny-24, icon-selected: Icons.weather-sunny-24-filled, title: @tr("Light") },
                { icon: Icons.weather-moon-24, icon-selected: Icons.weather-moon-24-filled, title: @tr("Dark") },
            ];
            selected: root.theme == ThemeChoice.light ? 1 : root.theme == ThemeChoice.dark ? 2 : 0;
            picked(i) => {
                root.theme-picked(i == 1 ? ThemeChoice.light : i == 2 ? ThemeChoice.dark : ThemeChoice.system);
            }
        }
        Card {
            // No icon: no other System row has one, and titles start at one x (UI rule 9).
            Row {
                title: @tr("App language");
                description: @tr("Menus and labels of this window. It does not change the language you dictate in.");
                // Centred: the description wraps at narrow widths, and a Combo would fill the row.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Combo {
                        model: SystemState.app-languages;
                        current-index <=> SystemState.app-language;
                        accessible-label: @tr("App language");
                        selected => {
                            SystemState.app-language-picked(self.current-index);
                        }
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Startup and updates");
        Card {
            ToggleRow {
                flat: true;
                title: @tr("Start at sign-in");
                // Until the OS registration lands (ROADMAP M10) the switch only saves the setting.
                description: @tr("Takes effect in a later version.");
                checked <=> SystemState.autostart;
                toggled(on) => {
                    SystemState.autostart-toggled(on);
                }
            }
            Divider { }
            Rectangle {
                min-height: update-row.min-height;
                preferred-height: update-row.preferred-height;
                update-row := ToggleRow {
                    visible: !root.confirm-update-off;
                    flat: true;
                    title: @tr("Check for updates");
                    description: @tr("Once a day OxiYapper asks GitHub for the latest version. Nothing installs on its own.");
                    checked <=> SystemState.update-check;
                    toggled(on) => {
                        if (on) {
                            root.confirm-update-off = false;
                            SystemState.update-check-toggled(true);
                        } else {
                            self.checked = true;
                            root.confirm-by-key = self.key-focused;
                            root.confirm-update-off = true;
                        }
                    }
                }
                if root.confirm-update-off: Row {
                    init => {
                        keep.take-focus(root.confirm-by-key);
                    }
                    title: @tr("Update checks tell you when a fix is out.");
                    description: @tr("Once a day OxiYapper asks GitHub for the latest version. Nothing installs on its own.");
                    Button {
                        text: @tr("Turn off");
                        kind: ButtonKind.subtle;
                        // The risky choice the confirmation guards turns red under the pointer (UI rule 16).
                        destructive: true;
                        accessible-label: @tr("Turn off update checks");
                        clicked => {
                            root.confirm-update-off = false;
                            update-row.take-focus(self.key-focused);
                            SystemState.update-check = false;
                            SystemState.update-check-toggled(false);
                        }
                    }
                    keep := Button {
                        text: @tr("Keep checking");
                        kind: ButtonKind.primary;
                        clicked => {
                            root.confirm-update-off = false;
                            update-row.take-focus(self.key-focused);
                        }
                    }
                }
            }
        }
    }
    }
    if SystemState.tab == 1: Card {
            Row {
                title: @tr("Save recordings");
                // Limits act only while on, on the folder below: recordings left after Off or in an earlier
                // folder are never deleted (SPEC History: retention is part of saving).
                description: @tr("While on, keeps audio and text in the folder below, up to these limits.");
                warning: SystemState.history-limit-note;
                NumberField {
                    value <=> SystemState.history-days;
                    maximum: 999;
                    unit: @tr("days");
                    zero-text: @tr("Forever");
                    accessible-label: @tr("Keep recordings for");
                    changed(days) => {
                        SystemState.history-days-changed(days);
                    }
                }
                NumberField {
                    value <=> SystemState.history-gb;
                    maximum: 999;
                    unit: @tr("GB");
                    zero-text: @tr("No limit");
                    accessible-label: @tr("Recordings size limit");
                    changed(gb) => {
                        SystemState.history-gb-changed(gb);
                    }
                }
                Switch {
                    checked <=> SystemState.history-on;
                    accessible-label: @tr("Save recordings");
                    toggled(on) => {
                        SystemState.history-toggled(on);
                    }
                }
            }
            Divider { }
            Row {
                title: @tr("Recordings folder");
                warning: SystemState.history-problem;
                // Packed right with its buttons, as their subject (UI rule 9); a long path is cut.
                Rectangle {
                    max-width: folder-text.preferred-width;
                    accessible-role: text;
                    accessible-label: SystemState.history-path;
                    folder-text := Text {
                        width: 100%;
                        text: SystemState.history-folder == "" ? @tr("Default folder") : SystemState.history-folder;
                        font-size: Theme.body-size;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                    path-hover := TouchArea { }
                    Tip {
                        text: SystemState.history-path;
                        hovered: path-hover.has-hover;
                    }
                }
                if SystemState.can-browse: Button {
                    text: @tr("Change recordings folder");
                    kind: ButtonKind.icon;
                    icon: Icons.edit-16;
                    enabled: !Shell.locked;
                    tooltip: Shell.locked-tip;
                    clicked => {
                        SystemState.history-browse();
                    }
                }
                Button {
                    text: @tr("Open recordings folder");
                    kind: ButtonKind.icon;
                    icon: Icons.open-folder-16;
                    clicked => {
                        HomeState.open-history();
                    }
                }
            }
            Divider { }
            Row {
                title: @tr("Open a folder");
                Button {
                    text: @tr("Settings");
                    kind: ButtonKind.subtle;
                    icon: Icons.open-folder-16;
                    accessible-label: @tr("Open settings folder");
                    clicked => {
                        SystemState.open-settings-folder();
                    }
                }
                Button {
                    text: @tr("Logs");
                    kind: ButtonKind.subtle;
                    icon: Icons.open-folder-16;
                    accessible-label: @tr("Open logs folder");
                    clicked => {
                        SystemState.open-logs-folder();
                    }
                }
            }
            Divider { }
            ToggleRow {
                flat: true;
                title: @tr("Log dictated text");
                warning: SystemState.log-text ? @tr("Dictated text is written to the log files while this is on. Turn it off when you are done.") : "";
                checked <=> SystemState.log-text;
                toggled(on) => {
                    SystemState.log-text-toggled(on);
                }
            }
    }
}
