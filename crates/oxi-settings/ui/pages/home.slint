// Home page (SPEC, History): four usage numbers and the speaking-activity heatmap, or the open
// card's chart by day.
import { Theme, Icons, Group, CardFrame, StatCard, ActivityHeatmap, MonthLabel, EmptyState } from "../theme/index.slint";
import { HoverTip, Tooltip } from "../theme/components/base.slint";
import { TrendChart } from "../theme/components/stats.slint";

// Filled by `pages::home`.
export global HomeState {
    in property <string> words: "0";
    in property <string> wpm: "0";
    in property <string> dictations: "0";
    in property <int> streak;
    in property <int> longest-streak;
    in property <int> active-days;
    // Nothing dictated yet: the activity card shows an empty state.
    in property <bool> empty: true;
    in property <string> chord;
    // Recording mode is Toggle: the hint says press once, not hold.
    in property <bool> toggle;
    // History saving is on: the folder beside the disclaimer then holds text and audio.
    in property <bool> history-on;
    // One 0..4 per day from a Monday (index = week * 7 + weekday, Monday first) to today.
    in property <[int]> levels;
    // What each day's tooltip says ("Nov 8 · 3 dictations · 120 words"), one per level.
    in property <[string]> day-tips;
    in property <[MonthLabel]> months;
    in property <int> today: -1;
    // The open stat card (0..3 in the order of the cards), -1: none, the heatmap shows.
    in property <int> selected: -1;
    // The open card's chart: one bar per day in thousandths of the peak, oldest first. At least a
    // month of days, so a short history still reads as a time axis.
    in property <[int]> trend;
    // What each bar's tooltip says ("Nov 8: 1,234 words"), one per bar.
    in property <[string]> trend-tips;
    // Days with data (the bars before the first dictation are padding); 0 shows the empty state.
    in property <int> trend-days;
    in property <string> trend-peak;
    in property <string> trend-first;
    in property <string> trend-last;
    callback shown();
    // How many heatmap weeks the page shows (half a year); `levels` then holds that many. Set
    // before the page's code is bound too, so it is a property, and `fit` tells the page.
    in-out property <int> fit-weeks;
    callback fit();
    callback pick(int);
    callback open-history();
    // A day with dictations was clicked: History opens (it cannot filter by day yet).
    callback open-day();
}

struct Stat {
    icon: image,
    label: string,
    value: string,
    caption: string,
    // The chart's title.
    trend: string,
}

export component HomePage inherits VerticalLayout {
    alignment: start;
    // The page column's width, from the window: the card rows are built from it, so it must not
    // come from this layout's own size.
    in property <length> content-width;
    // The window's width, not the column's: the rail widens at 960 and takes 164 px from the
    // column, which would flip the cards back to two rows on the way up.
    in property <length> window-width;
    // The page's own room in the window (without the title and the banners).
    in property <length> free-height;
    // Under this the four cards stop fitting their labels.
    property <bool> wide: root.window-width >= Theme.narrow-window;
    // A window too low for two rows of cards (UI rule 25): one row even when narrow.
    property <bool> one-row: root.wide || root.free-height < Theme.home-full-height;
    property <length> card-width: root.one-row ? (root.content-width - 3 * Theme.tile-gap) / 4 : (root.content-width - Theme.tile-gap) / 2;
    property <int> weeks: max(1, ceil(HomeState.levels.length / 7));
    property <length> heat-room: root.content-width - 2 * Theme.card-padding-h - heat.label-w;
    // The last half year (oxi-core's HEAT_WEEKS_MIN).
    property <int> fit-weeks: 26;
    // The height the page spends outside the grid: the cards (a second row, two label lines), the
    // card's header and paddings. What is left is the grid's, so the page never scrolls (rule 25).
    property <length> chrome: Theme.home-chrome + (root.label-lines == 2 ? Theme.home-chrome-labels : 0px) + (root.one-row ? 0px : Theme.home-chrome-row);
    property <length> grid-room: root.free-height - root.chrome - Theme.heat-top - 7 * heat.gap;
    // The cell: fills the card's width up to `heat-cell-max`, and no more than the height allows.
    // With the legend (a gap and one more cell high) when the height leaves cells of
    // `heat-cell-legend` or more; else the legend is the first thing a low window drops.
    property <length> cell-wide: Theme.heat-cell(root.heat-room, root.fit-weeks, heat.gap);
    property <length> cell-high: floor((root.grid-room - Theme.space-3) / 8 / 1px) * 1px;
    property <bool> legend: root.cell-high >= Theme.heat-cell-legend;
    property <length> cell: max(Theme.heat-cell-floor, min(root.cell-wide, root.legend ? root.cell-high : floor(root.grid-room / 7 / 1px) * 1px));
    init => {
        HomeState.fit-weeks = root.fit-weeks;
        HomeState.fit();
    }
    // Under 172 px a card's longest label (Words per minute) wraps: reserve two lines in all four.
    property <int> label-lines: root.card-width < Theme.stat-card-one-line ? 2 : 1;
    property <[Stat]> stats: [
        { icon: Icons.text-word-count, label: @tr("Words spoken"), value: HomeState.words, caption: @tr("All time"), trend: @tr("Words by day") },
        { icon: Icons.top-speed, label: @tr("Words per minute"), value: HomeState.wpm, caption: @tr("Based on recorded speech"), trend: @tr("Words per minute by day") },
        { icon: Icons.mic, label: @tr("Dictations"), value: HomeState.dictations, caption: @tr("All time"), trend: @tr("Dictations by day") },
        {
            icon: Icons.fire,
            label: @tr("Current streak"),
            value: @tr("{n} day" | "{n} days" % HomeState.streak),
            caption: @tr("Longest: {n} day" | "Longest: {n} days" % HomeState.longest-streak),
            trend: @tr("Streak by day"),
        },
    ];
    property <bool> trend-open: HomeState.selected >= 0;
    // Nothing to draw in the activity card: no dictation yet, or no day for the open chart.
    property <bool> blank: root.trend-open ? HomeState.trend-days == 0 : HomeState.empty;
    // The hint behind the activity card's "i" (UI rule 35: no loose explanatory text).
    property <string> how: HomeState.toggle ? @tr("Press {} once to start, again to stop.", HomeState.chord) : @tr("Hold {} and speak.", HomeState.chord);
    property <string> hint: root.how + " " + (HomeState.empty ? @tr("Your words, pace and streak show up here after the first dictation.") : @tr("Click a card above to see it day by day."));
    // Indexes into `stats`: a new number must update the cards, not rebuild them (focus and hover
    // live in the instances).
    property <[[int]]> rows: root.one-row ? [[0, 1, 2, 3]] : [[0, 1], [2, 3]];
    spacing: Theme.tile-gap;
    for row in root.rows: HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.tile-gap;
        for i in row: StatCard {
            width: root.card-width;
            label-lines: root.label-lines;
            icon: root.stats[i].icon;
            label: root.stats[i].label;
            value: root.stats[i].value;
            caption: root.stats[i].caption;
            selected: HomeState.selected == i;
            clicked => {
                HomeState.pick(i);
            }
        }
    }
    // The card is as high as its content; the window's spare height stays under it (UI rule 24).
    Group {
        vertical-stretch: 0;
        title: root.trend-open ? root.stats[HomeState.selected].trend : @tr("Speaking activity");
        icon: root.trend-open ? root.stats[HomeState.selected].icon : Icons.calendar;
        info: root.hint;
        action-text: @tr("History folder");
        action-icon: Icons.folder-open-16;
        action-tip: HomeState.history-on ? @tr("Opens the folder with your dictated text and audio. Statistics keep only dates and counts.") : @tr("Opens the History folder. Statistics keep only dates and counts, never the text.");
        action => {
            HomeState.open-history();
        }
        CardFrame {
            vertical-stretch: 0;
            min-height: body.min-height;
            preferred-height: body.preferred-height;
            body := VerticalLayout {
                padding-left: Theme.card-padding-h;
                padding-right: Theme.card-padding-h;
                padding-top: Theme.card-padding-v;
                padding-bottom: Theme.card-padding-v;
                // At least the heatmap's room, so opening a chart or the first dictation moves
                // nothing (UI rules 1, 5); in a taller card the heatmap stays centred.
                Rectangle {
                    min-height: grid.min-height;
                    preferred-height: grid.min-height;
                    vertical-stretch: 0;
                    grid := VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            heat := ActivityHeatmap {
                                visible: !root.trend-open && !root.blank;
                                levels: HomeState.levels;
                                day-tips: HomeState.day-tips;
                                months: HomeState.months;
                                today: HomeState.today;
                                cell: root.cell;
                                legend-shown: root.legend;
                                day-clicked(day) => {
                                    HomeState.open-day();
                                }
                                summary: @tr("{n} active day in the last {} weeks" | "{n} active days in the last {} weeks" % HomeState.active-days, root.weeks);
                            }
                        }
                    }
                    if root.blank: EmptyState {
                        width: parent.width;
                        height: parent.height;
                        icon: Icons.mic;
                        text: @tr("No dictations yet");
                    }
                    if root.trend-open && !root.blank: plot := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        // `max-pitch` below is the full width, so the bars always span it.
                        property <int> days: HomeState.trend.length;
                        property <length> pitch: self.width / max(1, self.days);
                        // TrendChart's plot: the peak caption above it, the dates below.
                        property <length> plot-top: Theme.caption-line + Theme.space-1;
                        property <length> baseline: self.height - Theme.caption-line - Theme.space-1;
                        property <int> hovered: touch.has-hover ? max(0, min(self.days - 1, floor(touch.mouse-x / self.pitch))) : -1;
                        // The hovered day's column, under its bar.
                        if plot.hovered >= 0: Rectangle {
                            x: floor(plot.hovered * plot.pitch / 1px) * 1px;
                            y: plot.plot-top;
                            width: max(1px, floor((plot.hovered + 1) * plot.pitch / 1px) * 1px - self.x);
                            height: plot.baseline - plot.plot-top;
                            border-radius: Theme.radius-small;
                            background: Theme.bg-subtle-hover;
                        }
                        TrendChart {
                            width: parent.width;
                            height: parent.height;
                            max-pitch: parent.width;
                            bars: HomeState.trend;
                            peak: @tr("Highest: {}", HomeState.trend-peak);
                            first-day: HomeState.trend-first;
                            last-day: HomeState.trend-last;
                            summary: @tr("{n} day, highest {}" | "{n} days, highest {}" % HomeState.trend-days, HomeState.trend-peak);
                        }
                        // Hover only: the bars take no click, so the pointer stays an arrow.
                        touch := TouchArea { }
                        // The hovered bar's tip; a refresh under a still pointer brings its new text.
                        property <string> tip: self.hovered >= 0 ? HomeState.trend-tips[self.hovered] : "";
                        // Not drawn: the bubble's width, to place it before it opens.
                        measure := Tooltip {
                            visible: false;
                            width: 0;
                            height: 0;
                            text: plot.tip;
                        }
                        // Right of the column, as a web chart's tooltip; left of it where the
                        // window's edge leaves no room, so it never covers the hovered bar.
                        property <length> tip-right: self.absolute-position.x + (self.hovered + 1) * self.pitch + Theme.space-2;
                        property <length> tip-x: self.tip-right + measure.preferred-width + Theme.space-2 <= root.window-width ? self.tip-right : self.absolute-position.x + self.hovered * self.pitch - Theme.space-2 - measure.preferred-width;
                        function show-tip() {
                            HoverTip.text = self.tip;
                            HoverTip.x = self.tip-x;
                            HoverTip.y = self.absolute-position.y + self.plot-top;
                        }
                        // At once, beside the bar's top.
                        changed tip => {
                            self.show-tip();
                        }
                        changed tip-x => {
                            if (self.hovered >= 0) {
                                self.show-tip();
                            }
                        }
                        // The bubble lives while a bar is hovered (see `HoverTip.beat`).
                        Timer {
                            interval: 150ms;
                            running: plot.hovered >= 0;
                            triggered => {
                                HoverTip.beat += 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
