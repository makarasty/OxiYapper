// About page: the hero with the project links, what the app is built with and the author. The Slint
// tile opens the std "Made with Slint" badge (SPEC Settings UI, R2.3). The browser opens every link;
// the app makes no request.
import { AboutSlint } from "std-widgets.slint";
import { Theme, Icons, Caption, Group, Card, CardFrame, ClickCard, Button } from "../theme/index.slint";

// `brand`: one of the `Theme.brand-*` inks (DS-19.3).
// An empty `url`: the tile opens the Slint badge instead of a link.
struct Tech {
    name: string,
    note: string,
    mark: image,
    brand: color,
    url: string,
}

// A project the app is built with: a whole-card link. `short` drops the note where it would be cut.
component TechCard inherits ClickCard {
    in property <string> name;
    in property <string> note;
    in property <image> mark;
    in property <color> brand;
    // Opens something in the app, not a link: no external-link arrow.
    in property <bool> inner;
    in property <bool> short;
    accessible-label: root.name;
    accessible-description: root.note;
    border-color: root.hover ? Theme.stroke-control : Theme.stroke-card;
    HorizontalLayout {
        // The whole tile under its padding: the card body packs at the top, and the page sets the
        // height so the mark box sits as far from the top and bottom as from the left.
        height: root.height - 2 * Theme.card-padding-v;
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            mark-box := Rectangle {
                width: root.short ? Theme.icon-size : Theme.control-height;
                height: self.width;
                border-radius: Theme.radius-control;
                // The short tile's square is no bigger than the mark: no tint to crowd it.
                background: root.short ? transparent : root.brand.transparentize(0.9);
                // Placed by hand: equal insets on all four sides by construction (DS-15.4).
                mark := Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.mark;
                    width: Theme.icon-size;
                    height: Theme.icon-size;
                    colorize: root.brand;
                    accessible-role: none;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.title-gap;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                height: Theme.body-line;
                vertical-alignment: center;
                font-size: Theme.body-size;
                color: Theme.text-primary;
                overflow: elide;
                accessible-role: none;
            }
            if !root.short: Caption {
                text: root.note;
                height: Theme.caption-line;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: root.inner ? Icons.caret-down : Icons.open-external;
                width: Theme.icon-size-small;
                height: Theme.icon-size-small;
                colorize: root.hover ? Theme.accent-text : Theme.text-secondary;
                accessible-role: none;
            }
        }
    }
}

// The app mark (`oxi-platform` draw::logo, 256 grid): paper tile, ink ring, record dot. The dot is
// drawn in the accent, so it follows the user's pick (DS-20.8); the rest is the brand's fixed paper
// and ink, the same in both themes, as in the exe icon.
component AppMark inherits Rectangle {
    // One grid unit: the side over 256.
    property <length> u: self.width / 256;
    height: self.width;
    border-radius: 0.22 * self.width;
    border-width: self.width / 64;
    border-color: #E4DED2;
    background: #FAF7F1;
    accessible-role: none;
    Rectangle {
        x: 36 * root.u;
        y: 60 * root.u;
        width: 160 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 40 * root.u;
        border-color: #1C1B19;
    }
    Rectangle {
        x: 172 * root.u;
        y: 36 * root.u;
        width: 48 * root.u;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.accent;
    }
}

component AuthorCard inherits Card {
    callback open(string);
    // Under the second tile column the line shows "Made in Ukraine" alone.
    in property <bool> compact;
    HorizontalLayout {
        spacing: Theme.icon-gap;
        Rectangle {
            width: Theme.about-logo-size;
            height: Theme.about-logo-size;
            border-radius: Theme.radius-round;
            clip: true;
            Image {
                source: Icons.avatar;
                width: 100%;
                height: 100%;
                image-fit: cover;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.title-gap;
            horizontal-stretch: 1;
            preferred-width: 0;
            Text {
                text: "makarasty";
                font-size: Theme.body-size;
                font-weight: Theme.weight-strong;
                color: Theme.text-primary;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-1;
                Caption {
                    text: "Made in Ukraine";
                }
                if !root.compact: Caption {
                    text: "·";
                    accessible-role: none;
                }
                if !root.compact: Caption {
                    text: @tr("Issues and ideas welcome");
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "github.com/makarasty";
                icon: Icons.github-mark;
                clicked => {
                    root.open("https://github.com/makarasty");
                }
            }
        }
    }
}

export component AboutPage inherits VerticalLayout {
    in property <string> app-name;
    in property <string> version;
    in property <string> licence;
    in property <string> repository;
    // The column's height under the page title (banners already taken off).
    in property <length> free-height;
    function open(url: string) {
        Platform.open-url(url);
    }
    property <[Tech]> techs: [
        { name: "Rust", note: @tr("The whole app"), mark: Icons.rust-mark, brand: Theme.brand-rust, url: "https://github.com/rust-lang/rust" },
        { name: "Slint", note: @tr("This settings window"), mark: Icons.slint-mark, brand: Theme.brand-slint, url: "" },
        { name: "whisper.cpp", note: @tr("Speech recognition"), mark: Icons.person-voice, brand: Theme.brand-whisper-cpp, url: "https://github.com/ggml-org/whisper.cpp" },
        { name: "whisper-rs", note: @tr("Rust bindings"), mark: Icons.plug-connected, brand: Theme.brand-whisper-rs, url: "https://codeberg.org/tazz4843/whisper-rs" },
        { name: "nnnoiseless", note: @tr("Noise suppression"), mark: Icons.sound-wave-circle, brand: Theme.brand-nnnoiseless, url: "https://github.com/jneem/nnnoiseless" },
        { name: "cpal", note: @tr("Microphone capture"), mark: Icons.mic, brand: Theme.brand-cpal, url: "https://github.com/RustAudio/cpal" },
        { name: "Phosphor Icons", note: @tr("Every icon in the app"), mark: Icons.icons, brand: Theme.brand-phosphor, url: "https://github.com/phosphor-icons/core" },
        { name: "Claude Code", note: @tr("Pair programming"), mark: Icons.claude-mark, brand: Theme.brand-claude, url: "https://github.com/anthropics/claude-code" },
        { name: "tiny-skia", note: @tr("Draws the overlay pill"), mark: Icons.paint-brush, brand: Theme.brand-tiny-skia, url: "https://github.com/RazrFalcon/tiny-skia" },
    ];
    property <int> columns: 3;
    property <int> rows: ceil(root.techs.length / root.columns);
    property <length> tile-width: (root.width - (root.columns - 1) * Theme.tile-gap) / root.columns;
    // A column's left edge in whole pixels, so every 1 px tile stroke stays crisp (UI rule 20) and
    // the gaps stay one tile gap.
    pure function column-x(c: int) -> length {
        return Theme.whole(c * (root.width + Theme.tile-gap) / root.columns);
    }
    // A tile's text column once its padding, mark and arrow are off; the longest note needs half a
    // control column.
    property <bool> notes-fit: root.tile-width - 2 * Theme.card-padding-h - Theme.control-height - 2 * Theme.space-3 - Theme.icon-size-small >= Theme.control-column-min / 2;
    // The mark box sets a tile's height: as far from the tile's top and bottom as the card padding
    // puts it from the left edge (item 11, DS-15.4). The name and note lines fit inside.
    property <length> tall-tile: 2 * Theme.card-padding-h + Theme.control-height;
    property <length> card-height: 2 * Theme.card-padding-v + Theme.about-logo-size;
    property <length> group-head: Theme.icon-size + Theme.header-gap;
    property <length> short-tile: 2 * Theme.card-padding-h + Theme.icon-size;
    // The page as drawn: two cards, the tile grid, two group titles and the gaps.
    property <length> drawn-height: 2 * root.card-height + root.rows * (root.notes-fit ? root.tall-tile : root.short-tile) + (root.rows - 1) * Theme.tile-gap + 2 * root.group-head + 2 * Theme.group-gap;
    // Too low for that (UI rule 25): no group titles, short tiles.
    property <bool> tight: root.free-height < root.drawn-height;
    property <bool> short: root.tight || !root.notes-fit;
    property <length> tile-height: root.short ? root.short-tile : root.tall-tile;
    alignment: start;
    spacing: root.tight ? Theme.space-3 : Theme.group-gap;
    Card {
        HorizontalLayout {
            spacing: Theme.icon-gap;
            AppMark {
                width: Theme.about-logo-size;
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.title-gap;
                horizontal-stretch: 1;
                Text {
                    text: root.app-name;
                    font-size: Theme.subtitle-size;
                    font-weight: Theme.weight-strong;
                    color: Theme.text-primary;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-1;
                    Caption {
                        text: @tr("Version");
                    }
                    Caption {
                        text: root.version;
                    }
                    // Under this width the two licence buttons say it alone (UI rule 29).
                    if root.notes-fit: Caption {
                        text: "·";
                        accessible-role: none;
                    }
                    if root.notes-fit: Caption {
                        text: root.licence;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.control-gap;
                    Button {
                        text: @tr("Project page");
                        icon: Icons.github-mark;
                        clicked => {
                            root.open(root.repository);
                        }
                    }
                    Button {
                        text: @tr("MIT licence");
                        clicked => {
                            root.open(root.repository + "/blob/main/LICENSE-MIT");
                        }
                    }
                    Button {
                        text: @tr("Apache-2.0 licence");
                        clicked => {
                            root.open(root.repository + "/blob/main/LICENSE-APACHE");
                        }
                    }
                }
            }
        }
    }
    Group {
        title: root.tight ? "" : @tr("Built with");
        Rectangle {
            height: root.rows * root.tile-height + (root.rows - 1) * Theme.tile-gap;
            for tech[i] in root.techs: TechCard {
                x: root.column-x(mod(i, root.columns));
                y: floor(i / root.columns) * (root.tile-height + Theme.tile-gap);
                width: root.column-x(mod(i, root.columns) + 1) - Theme.tile-gap - self.x;
                height: root.tile-height;
                name: tech.name;
                note: tech.note;
                mark: tech.mark;
                brand: tech.brand;
                inner: tech.url == "";
                short: root.short;
                clicked => {
                    if (tech.url == "") {
                        slint-badge.show();
                    } else {
                        root.open(tech.url);
                    }
                }
            }
            // R2.3: the royalty-free licence's "Made with Slint" badge, under the Slint tile.
            slint-badge := PopupWindow {
                x: root.column-x(1);
                y: root.tile-height + Theme.space-1;
                close-policy: close-on-click-outside;
                CardFrame {
                    VerticalLayout {
                        padding-left: Theme.card-padding-h;
                        padding-right: Theme.card-padding-h;
                        padding-top: Theme.card-padding-v;
                        padding-bottom: Theme.card-padding-v;
                        spacing: Theme.space-2;
                        AboutSlint {
                            width: Theme.about-slint-width;
                            height: Theme.about-slint-height;
                        }
                        Button {
                            text: @tr("Project page");
                            icon: Icons.github-mark;
                            clicked => {
                                slint-badge.close();
                                root.open("https://github.com/slint-ui/slint");
                            }
                        }
                    }
                }
            }
        }
    }
    Group {
        title: root.tight ? "" : @tr("Author");
        AuthorCard {
            open(url) => {
                root.open(url);
            }
        }
    }
}
