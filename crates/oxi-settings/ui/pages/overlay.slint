// Overlay page (SPEC Feedback): the pill on or off, its spot on screen, hiding it over
// fullscreen apps, and a preview the daemon shows at the picked spot.
import { Button, Palette } from "std-widgets.slint";
import { Group, ToggleRow, ThumbPicker } from "../widgets.slint";

// Filled and read by `pages::overlay`.
export global OverlayState {
    in-out property <bool> enabled;
    // Picker order: top left, top centre, top right, then the bottom row the same way.
    in property <int> position;
    in-out property <bool> hide-over-fullscreen;
    // The daemon link is up: Preview needs it to show the pill.
    in property <bool> online;
    callback enabled-toggled(bool);
    callback position-picked(int);
    callback hide-over-fullscreen-toggled(bool);
    callback preview();
}

export component OverlayPage inherits VerticalLayout {
    alignment: start;
    spacing: 10px;
    Group {
        title: @tr("Overlay");
        ToggleRow {
            label: @tr("Show the overlay");
            checked <=> OverlayState.enabled;
            toggled(on) => {
                OverlayState.enabled-toggled(on);
            }
        }
        ToggleRow {
            label: @tr("Hide over fullscreen apps");
            checked <=> OverlayState.hide-over-fullscreen;
            toggled(on) => {
                OverlayState.hide-over-fullscreen-toggled(on);
            }
        }
    }
    Group {
        title: @tr("Position");
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 4px;
            // Two rows of three, laid out like the screen.
            ThumbPicker {
                accessible-label: @tr("Position");
                columns: 3;
                thumbs: [
                    { image: @image-url("../img/overlay-top-left.svg"), caption: @tr("Top left") },
                    { image: @image-url("../img/overlay-top-centre.svg"), caption: @tr("Top centre") },
                    { image: @image-url("../img/overlay-top-right.svg"), caption: @tr("Top right") },
                    { image: @image-url("../img/overlay-bottom-left.svg"), caption: @tr("Bottom left") },
                    { image: @image-url("../img/overlay-bottom-centre.svg"), caption: @tr("Bottom centre") },
                    { image: @image-url("../img/overlay-bottom-right.svg"), caption: @tr("Bottom right") },
                ];
                selected: OverlayState.position;
                picked(i) => {
                    OverlayState.position-picked(i);
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Button {
                    text: @tr("Preview");
                    enabled: OverlayState.online;
                    accessible-description: OverlayState.online ? "" : @tr("OxiYapper is not running");
                    clicked => {
                        OverlayState.preview();
                    }
                }
                if !OverlayState.online: Text {
                    text: @tr("OxiYapper is not running");
                    vertical-alignment: center;
                    color: Palette.foreground;
                    opacity: 0.7;
                }
            }
        }
    }
}
