// System page (SPEC System). The shell owns the theme picker (config `ui.theme`); the rest is
// `[system]` and `debug.log_text`, filled and read by `pages::system`.
import { Theme, Icons, Group, Card, Row, ToggleRow, TilePicker, Button, ButtonKind, Note, Severity } from "../theme/index.slint";

export enum ThemeChoice { system, dark, light }

export global SystemState {
    in-out property <bool> autostart;
    in-out property <bool> update-check;
    in-out property <bool> log-text;
    callback autostart-toggled(bool);
    // Off fires only after the note is confirmed.
    callback update-check-toggled(bool);
    callback log-text-toggled(bool);
    callback open-settings-folder();
    callback open-logs-folder();
}

export component SystemPage inherits VerticalLayout {
    in property <ThemeChoice> theme;
    callback theme-picked(ThemeChoice);
    // The update switch was turned off: it stays on until the note is confirmed (SPEC Settings UI).
    property <bool> confirm-update-off;
    alignment: start;
    spacing: Theme.group-gap;
    Group {
        title: @tr("Appearance");
        TilePicker {
            accessible-label: @tr("Theme");
            columns: 3;
            tiles: [
                { icon: Icons.dark-theme-24, icon-selected: Icons.dark-theme-24-filled, title: @tr("System") },
                { icon: Icons.weather-sunny-24, icon-selected: Icons.weather-sunny-24-filled, title: @tr("Light") },
                { icon: Icons.weather-moon-24, icon-selected: Icons.weather-moon-24-filled, title: @tr("Dark") },
            ];
            selected: root.theme == ThemeChoice.light ? 1 : root.theme == ThemeChoice.dark ? 2 : 0;
            picked(i) => {
                root.theme-picked(i == 1 ? ThemeChoice.light : i == 2 ? ThemeChoice.dark : ThemeChoice.system);
            }
        }
    }
    Group {
        title: @tr("Startup and updates");
        ToggleRow {
            title: @tr("Start at sign-in");
            // Until the OS registration lands (ROADMAP M10) the switch only saves the setting.
            description: @tr("Takes effect in a later version.");
            checked <=> SystemState.autostart;
            toggled(on) => {
                SystemState.autostart-toggled(on);
            }
        }
        ToggleRow {
            title: @tr("Check for updates");
            description: @tr("Once a day OxiYapper asks GitHub for the latest version. Nothing installs on its own.");
            checked <=> SystemState.update-check;
            toggled(on) => {
                if (on) {
                    root.confirm-update-off = false;
                    SystemState.update-check-toggled(true);
                } else {
                    self.checked = true;
                    root.confirm-update-off = true;
                }
            }
        }
        if root.confirm-update-off: Note {
            padding-left: Theme.card-padding-h;
            padding-top: Theme.space-1;
            text: @tr("Update checks tell you when a fix is out.");
            severity: Severity.warning;
            Button {
                text: @tr("Turn off");
                kind: ButtonKind.subtle;
                accessible-label: @tr("Turn off update checks");
                clicked => {
                    root.confirm-update-off = false;
                    SystemState.update-check = false;
                    SystemState.update-check-toggled(false);
                }
            }
            Button {
                text: @tr("Keep checking");
                kind: ButtonKind.primary;
                clicked => {
                    root.confirm-update-off = false;
                }
            }
        }
    }
    Group {
        title: @tr("Debug");
        ToggleRow {
            title: @tr("Log dictated text");
            checked <=> SystemState.log-text;
            toggled(on) => {
                SystemState.log-text-toggled(on);
            }
        }
        if SystemState.log-text: Note {
            padding-left: Theme.card-padding-h;
            padding-top: Theme.space-1;
            text: @tr("Dictated text is written to the log files while this is on. Turn it off when you are done.");
            severity: Severity.warning;
        }
    }
    Group {
        title: @tr("Files");
        Card {
            Row {
                icon: Icons.folder-open;
                title: @tr("Settings folder");
                Button {
                    text: @tr("Open");
                    kind: ButtonKind.subtle;
                    icon: Icons.open-folder-16;
                    accessible-label: @tr("Open settings folder");
                    clicked => {
                        SystemState.open-settings-folder();
                    }
                }
            }
            Row {
                icon: Icons.folder-open;
                title: @tr("Logs");
                Button {
                    text: @tr("Open");
                    kind: ButtonKind.subtle;
                    icon: Icons.open-folder-16;
                    accessible-label: @tr("Open logs folder");
                    clicked => {
                        SystemState.open-logs-folder();
                    }
                }
            }
        }
    }
}
