    out property <int> long-grid-columns: long-grid.columns;
    out property <length> long-grid-height: long-grid.height;
    property <[Swatch]> swatches: [
        { name: "bg-page", c: Theme.bg-page, bg: Theme.bg-page, bg-name: "", ratio: false },
