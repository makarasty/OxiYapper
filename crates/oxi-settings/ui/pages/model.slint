// Model page (SPEC Models, ARCHITECTURE section 8): the curated models with their state on disk,
// download and cancel through the daemon, "use my own .bin", the GPU and the idle unload.
import { Theme, Shell, Icons, Group, Card, ClickCard, Row, Divider, SliderRow, Combo, TextField, Button, ButtonKind, Radio, Badge, BadgeKind, ProgressBar, Note, Severity } from "../theme/index.slint";

export struct ModelRow {
    id: string,
    name: string,
    // "1.6 GB".
    size: string,
    // What follows the size: a hint, or what to do about a state the badge names.
    status: string,
    // Beside the progress bar while downloading: "0.7 of 1.6 GB".
    progress-text: string,
    // "Ready", "Not downloaded", "Downloading".
    badge: string,
    // On disk and usable: the badge is green.
    ready: bool,
    can-download: bool,
    downloading: bool,
    // 0..1 while downloading.
    progress: float,
    // Why the last download failed; empty otherwise.
    error: string,
}

// Filled and read by `pages::model`.
export global ModelState {
    in property <[ModelRow]> rows;
    // Index in `rows`; `rows.length` is "use my own .bin", -1 is none.
    in property <int> selected;
    in-out property <string> custom-path;
    in property <string> custom-error;
    // The native file dialog exists on this OS.
    in property <bool> can-browse;
    // "Auto", "CPU", then the GPUs the daemon lists.
    in property <[string]> gpus;
    in-out property <int> gpu;
    in-out property <float> idle-minutes;
    in property <float> default-idle-minutes;
    // The daemon's Status warnings ("running on CPU: ..."); empty hides the note.
    in property <string> warning;
    // Why Download is off; empty while the daemon is online.
    in property <string> download-off;
    callback shown();
    callback picked(int);
    callback download(int);
    callback cancel(int);
    callback custom-edited(string);
    callback browse();
    callback gpu-picked(int);
    callback idle-changed(float);
}

// Radio dot, name and caption: the choice inside a model card. Its own accessible element, so a
// button beside it in the card is not part of the radio.
component Choice inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> hover;
    callback picked();
    horizontal-stretch: 1;
    min-height: inner.min-height;
    preferred-height: inner.preferred-height;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: !Shell.locked;
    accessible-action-default => {
        if (!Shell.locked) {
            root.picked();
        }
    }
    inner := HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            Radio {
                checked: root.checked;
                enabled: !Shell.locked;
                hover: root.hover;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.title-gap;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: Theme.body-size;
                color: Shell.locked ? Theme.text-disabled : Theme.text-primary;
                wrap: word-wrap;
            }
            Text {
                text: root.detail;
                font-size: Theme.caption-size;
                color: Shell.locked ? Theme.text-disabled : Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }
}

export component ModelPage inherits VerticalLayout {
    // Lines under the name start past the radio dot.
    property <length> under-radio: 16px + Theme.space-3;
    alignment: start;
    spacing: Theme.group-gap;
    init => {
        ModelState.shown();
    }
    Group {
        title: @tr("Speech model");
        for row[i] in ModelState.rows: card := ClickCard {
            enabled: !Shell.locked;
            accessible-role: none;
            clicked => {
                ModelState.picked(i);
            }
            HorizontalLayout {
                spacing: Theme.control-gap;
                Choice {
                    label: row.name;
                    detail: row.size + " · " + row.status;
                    checked: ModelState.selected == i;
                    hover: card.hover;
                    picked => {
                        ModelState.picked(i);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Badge {
                        text: row.badge;
                        kind: row.downloading ? BadgeKind.accent : row.ready ? BadgeKind.success : BadgeKind.neutral;
                        accessible-label: @tr("{}: {}", row.name, row.badge);
                    }
                }
                // Downloading writes no config, so it stays on while the config is locked.
                if row.can-download && !row.downloading: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Download");
                        icon: Icons.arrow-download-16;
                        enabled: ModelState.download-off == "";
                        tooltip: ModelState.download-off;
                        accessible-label: @tr("Download {}", row.name);
                        clicked => {
                            ModelState.download(i);
                        }
                    }
                }
                if row.downloading: VerticalLayout {
                    alignment: center;
                    Button {
                        text: @tr("Cancel");
                        icon: Icons.dismiss-16;
                        kind: ButtonKind.subtle;
                        accessible-label: @tr("Cancel {}", row.name);
                        clicked => {
                            ModelState.cancel(i);
                        }
                    }
                }
            }
            if row.downloading: ProgressBar {
                padding-left: root.under-radio;
                value: row.progress;
                label: row.progress-text;
                accessible-label: @tr("{} download", row.name);
                accessible-value: row.progress;
            }
            if row.error != "": Note {
                padding-left: root.under-radio;
                text: row.error;
                severity: Severity.error;
                accessible-label: @tr("{}: {}", row.name, row.error);
            }
            if ModelState.selected == i && row.can-download && !row.downloading: Note {
                padding-left: root.under-radio;
                text: @tr("Dictation will not start until this is downloaded.");
                severity: Severity.warning;
            }
        }
        custom := ClickCard {
            enabled: !Shell.locked;
            accessible-role: none;
            clicked => {
                ModelState.picked(ModelState.rows.length);
            }
            Choice {
                label: @tr("Use my own .bin");
                detail: @tr("Loaded as is, without a hash check");
                checked: ModelState.selected == ModelState.rows.length;
                hover: custom.hover;
                picked => {
                    ModelState.picked(ModelState.rows.length);
                }
            }
            HorizontalLayout {
                padding-left: root.under-radio;
                spacing: Theme.control-gap;
                TextField {
                    text <=> ModelState.custom-path;
                    placeholder-text: @tr("Path to a .bin file");
                    enabled: !Shell.locked;
                    accessible-label: @tr("Model file");
                    edited(text) => {
                        ModelState.custom-edited(text);
                    }
                }
                if ModelState.can-browse: Button {
                    text: @tr("Browse…");
                    icon: Icons.folder-open-16;
                    enabled: !Shell.locked;
                    tooltip: Shell.locked-tip;
                    clicked => {
                        ModelState.browse();
                    }
                }
            }
            if ModelState.custom-error != "": Note {
                padding-left: root.under-radio;
                text: ModelState.custom-error;
                severity: Severity.error;
            }
        }
    }
    Group {
        title: @tr("Engine");
        Card {
            Row {
                icon: Icons.desktop;
                title: @tr("GPU");
                fill-controls: true;
                Combo {
                    model: ModelState.gpus;
                    current-index <=> ModelState.gpu;
                    accessible-label: @tr("GPU");
                    selected => {
                        ModelState.gpu-picked(self.current-index);
                    }
                }
            }
            Divider { }
            SliderRow {
                icon: Icons.timer;
                title: @tr("Unload after idle");
                description: @tr("Frees the memory while you are not dictating.");
                minimum: 0;
                maximum: 60;
                unit: "min";
                zero-text: @tr("Never");
                default-value: ModelState.default-idle-minutes;
                value <=> ModelState.idle-minutes;
                changed(v) => {
                    ModelState.idle-changed(v);
                }
            }
            if ModelState.warning != "": Note {
                text: ModelState.warning;
                severity: Severity.warning;
            }
        }
    }
}
