// Buttons (spec section 4 `Button`). Our own, because std `Button { primary }` paints the
// system accent.
import { Theme } from "../tokens.slint";
import { FocusRing, KeyFocus, Tip } from "base.slint";

export enum ButtonKind { primary, secondary, subtle, danger, icon }

// Height 32, radius 4, padding 12, min width 88 so action rows align. `icon` buttons are 32x32
// with only the glyph; their `text` is the accessible label and the tooltip. A disabled button
// needs a reason: put it in `tooltip` (or in the row description).
export component Button {
    in property <string> text;
    in property <image> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <string> tooltip;
    // A Remove that is an `icon` button turns red under the pointer as `danger` does (UI rule 16).
    in property <bool> destructive;
    // Static shots have no mouse: the gallery forces the states.
    in property <bool> force-hover;
    in property <bool> force-pressed;
    in property <bool> force-focus;
    callback clicked;

    // For a control that replaces the focused one: `ring` says if the keyboard did it (UI rule 17).
    public function take-focus(ring: bool) {
        fs.focus();
        root.key-focus = ring;
    }

    property <bool> framed: root.kind == ButtonKind.secondary || root.kind == ButtonKind.danger;
    property <bool> hover: root.enabled && (touch.has-hover || root.force-hover);
    property <bool> down: root.enabled && (touch.pressed || root.force-pressed);
    // `danger` (Cancel, Remove, Stop) rests as a secondary button and turns red under the pointer.
    out property <bool> red: (root.kind == ButtonKind.danger || root.destructive) && (root.hover || root.down);
    property <bool> key-focus;
    out property <bool> key-focused: root.key-focus && fs.has-focus;
    property <color> ink: !root.enabled && root.kind == ButtonKind.primary ? Theme.bg-card : !root.enabled ? Theme.text-disabled : root.kind == ButtonKind.primary ? Theme.on-accent : root.red ? Theme.error-text : Theme.text-primary;
    property <bool> has-label: root.kind != ButtonKind.icon && root.text != "";

    forward-focus: fs;
    height: Theme.control-height;
    min-width: root.kind == ButtonKind.icon ? Theme.control-height : max(88px, row.min-width);
    max-width: root.kind == ButtonKind.icon ? Theme.control-height : 100000px;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.enabled ? "" : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    face := Rectangle {
        border-radius: Theme.radius-control;
        // Disabled: fills at 50 %; primary turns neutral (Fluent), a faded teal with grey text is unreadable.
        opacity: root.enabled || root.kind == ButtonKind.primary ? 1 : 0.5;
        background: root.kind == ButtonKind.primary ? (!root.enabled ? Theme.text-disabled : root.down ? Theme.accent-pressed : root.hover ? Theme.accent-hover : Theme.accent) : root.red ? (root.down ? Theme.error-fill-pressed : Theme.error-fill) : root.framed ? (root.down ? Theme.bg-control-pressed : root.hover ? Theme.bg-control-hover : Theme.bg-control) : (root.down ? Theme.bg-subtle-selected : root.hover ? Theme.bg-subtle-hover : transparent);
        border-width: root.framed ? 1px : 0;
        border-color: root.red ? Theme.error-text.transparentize(0.7) : Theme.stroke-control;
        animate background { duration: Theme.motion-quick; easing: ease-out; }
        // Fluent's darker bottom edge on framed controls.
        Rectangle {
            visible: root.framed;
            x: Theme.radius-control;
            y: parent.height - 1px;
            width: parent.width - 2 * Theme.radius-control;
            height: 1px;
            background: root.red ? Theme.error-text.transparentize(0.5) : Theme.stroke-control-bottom;
        }
    }
    row := HorizontalLayout {
        padding-left: root.kind == ButtonKind.icon ? 0 : Theme.space-3;
        padding-right: self.padding-left;
        spacing: Theme.space-2;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: Theme.icon-size-small;
                height: Theme.icon-size-small;
                colorize: root.ink;
                accessible-role: none;
            }
        }
        if root.has-label: Text {
            text: root.text;
            font-size: Theme.body-size;
            color: root.ink;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // Enabled even on a disabled button: its tooltip says why.
    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            root.key-focus = KeyFocus.from-key(reason);
        }
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    FocusRing {
        shown: root.force-focus || root.key-focused;
    }
    Tip {
        text: root.kind == ButtonKind.icon && root.enabled ? root.text : root.enabled ? "" : root.tooltip;
        hovered: touch.has-hover;
    }
}
