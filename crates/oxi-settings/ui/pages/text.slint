// Text page (SPEC Text), in sub-tabs: dictionary.txt with its prompt token budget, replace.txt
// with the lines it ignores, how text is pasted (mode, trailing space, Win+V history, restore
// delay), and the per-app rules.
import { Theme, Shell, Icons, Group, Card, CardFrame, Caption, Row, Divider, ToggleRow, SliderRow, Combo, Segmented, TextField, SearchField, TextArea, TilePicker, Button, ButtonKind, IconButton, InfoTip, Tip, ProgressBar, Note, Severity, SubTabs, SubTabPane, GalleryTile, CardGrid, EmptyState, ScrollBox } from "../theme/index.slint";
import { WarningSlot, Warnings } from "../theme/components/feedback.slint";
import { SystemState } from "system.slint";

export enum TextFile { dictionary, replacements }

// How a text file was read. `converted`: UTF-16 or a BOM, Save writes plain UTF-8.
// `not-text` and `unreadable` (an io error, its kind in `FileInfo.error`): the editor stays
// empty and Save is off, so the file is never wiped.
export enum FileState { ok, converted, not-text, unreadable }

export struct FileInfo {
    state: FileState,
    error: string,
    // What was on disk when the editor last matched it ("missing", or length and hash). Kept
    // here so a rebind after Reset still knows it; Save writes only while the disk still has it.
    base: string,
    // Edited since the last load or save.
    dirty: bool,
    // Save or a re-check found the file changed on disk while the editor was dirty; `error`
    // then names the read error if the file cannot be read now.
    conflict: bool,
}

// One per-app paste rule. `mode`: 0 the global mode, 1 clipboard, 2 type. `name`: the app's name
// from the last scan, empty when the scan did not find it. `icon`: its icon from the scan (none
// before one ran). `hidden`: the search field filters it out; the row keeps its place in the model so
// `rule-mode-picked` and `rule-removed` still count from the config's first rule.
export struct PasteRuleRow {
    app: string,
    name: string,
    mode: int,
    icon: image,
    hidden: bool,
}

// Filled and read by `pages::text`.
export global TextState {
    // The open sub-tab: 0 Dictionary, 1 Replacements, 2 Paste, 3 Per-app rules, 4 Processing, 5 Words.
    in-out property <int> tab;
    in-out property <string> dictionary;
    in property <FileInfo> dictionary-info;
    // Tokens of the whole dictionary, and the most whisper keeps.
    in property <int> tokens;
    in property <int> budget;
    // 1-based first line left out of the prompt (it and every line after it); 0 when all fit.
    in property <int> dropped-from;
    in-out property <string> replacements;
    in property <FileInfo> replacements-info;
    // Which lines have no "=>" and are ignored; empty when every line parses.
    in property <string> bad-lines;
    // 0 clipboard, 1 type.
    in-out property <int> paste-mode;
    in-out property <bool> trailing-space;
    // The dictation stays in Win+V history (`paste.keep_in_clipboard_history`).
    in-out property <bool> keep-history;
    // One Enter after the whole text landed (`paste.press_enter`).
    in-out property <bool> press-enter;
    in-out property <float> restore-delay-ms;
    in property <float> default-restore-delay-ms;
    // Processing (`[text]`): every switch is off until the person turns it on.
    in-out property <bool> pause-punctuation;
    in-out property <float> pause-sentence-ms;
    // 0 is off.
    in-out property <float> pause-paragraph-ms;
    in-out property <bool> filler-filter;
    // One word per line.
    in-out property <string> fillers;
    in-out property <bool> voice-commands;
    // One `trigger => text` per line; a backslash and n in the text is a line break.
    in-out property <string> snippets;
    in-out property <bool> confidence-filter;
    in-out property <float> confidence-min;
    // History saving is on: a held part has a place to be kept, so the confidence filter can run.
    // Follows the System page's switch, so a change made anywhere shows at once.
    out property <bool> history-on: SystemState.history-on;
    in property <[PasteRuleRow]> rules;
    // To-file mode (`[output]`): 0 off, 1 also, 2 only; the format 0 md, 1 txt; the folder's name
    // (empty while none is chosen, the whole path is its tip).
    in-out property <int> file-mode;
    in-out property <int> file-format;
    in property <string> file-folder-name;
    in property <string> file-folder;
    // Why the last dictation did not reach its file (the daemon's status warning); empty when it did.
    in property <string> file-warning;
    // The rule whose profile is open in the Per-app card, -1 for the list.
    in-out property <int> profile-rule: -1;
    in property <string> profile-name;
    in property <string> profile-app;
    in property <image> profile-icon;
    // The choices of the profile's two long lists, "Default" first.
    in property <[string]> language-names;
    in property <[string]> model-names;
    // The profile's values as indexes into those lists and the three-way ones (0 default, 1 on, 2
    // off); the order is the fields of `profile-picked`.
    in property <[int]> profile-values;
    // How many rules the search field leaves visible.
    in property <int> rule-matches;
    // The search field of the rules list: filters the rules, offers the installed apps and a typed exe.
    in-out property <string> query;
    // What the field offers under it: installed apps with no rule yet (name as title, exe as caption,
    // icon as picture), then one row for the typed exe: `hint` "add" to add it, "dup" when it already
    // has a rule (`caption` says so).
    in property <[GalleryTile]> suggestions;
    // What the last Scan found: the shortcut's name as title, the exe as caption, its icon as
    // picture; `checked` when the app has a rule.
    in property <[GalleryTile]> found;
    // `found` filtered by `popup-query`, the apps popup's grid.
    in property <[GalleryTile]> grid;
    in-out property <string> popup-query;
    // The rule a duplicate pick points at, for 600 ms: its row shows the accent tint and scrolls into view.
    in property <string> flash-app;
    // A scan runs on a worker; `scanned` once one has finished in this window.
    in property <bool> scanning;
    in property <bool> scanned;
    // The Per-app tab came into view: the first time, the apps are scanned for their icons and names.
    callback per-app-shown();
    // The page came into view: files with no unsaved edits are read again.
    callback shown();
    callback edited(TextFile, string);
    callback save(TextFile);
    callback open(TextFile);
    callback reload(TextFile);
    callback overwrite(TextFile);
    callback paste-mode-picked(int);
    callback trailing-space-toggled(bool);
    callback keep-history-toggled(bool);
    callback press-enter-toggled(bool);
    callback restore-delay-changed(float);
    callback pause-punctuation-toggled(bool);
    callback pause-sentence-changed(float);
    callback pause-paragraph-changed(float);
    callback filler-filter-toggled(bool);
    callback fillers-edited(string);
    callback voice-commands-toggled(bool);
    callback snippets-edited(string);
    callback confidence-filter-toggled(bool);
    callback confidence-min-changed(float);
    callback rule-mode-picked(int, int);
    // 0 language, 1 model, 2 to file, 3 dictionary, 4 replacements, 5 voice commands, 6 filler
    // words, 7 pause punctuation; the index into that field's list.
    callback profile-picked(int, int);
    callback profile-opened(int);
    callback file-mode-picked(int);
    callback file-format-picked(int);
    callback file-folder-choose();
    callback rule-removed(int);
    // A row of the field's list: add the rule for this exe (a duplicate is refused: its rule flashes).
    callback rule-picked(string);
    callback query-edited(string);
    callback popup-search(string);
    // A tile of the popup: its app gets a rule, or loses it. The exe, not the index: the grid is filtered.
    callback found-toggled(string);
    callback scan();
}

// An editor for one text file on its card: the text and one status line that never grows: an "i"
// with what the file is for, the children (Reload and Overwrite take their place when the file
// needs them), a "!" with how the file was read, Open file and Save.
component FileEditor inherits Card {
    in property <TextFile> file;
    in property <string> name;
    in property <string> label;
    in property <string> description;
    // The format, shown inside an empty editor.
    in property <string> hint;
    in property <FileInfo> info;
    // What is wrong with the text itself; the file's own trouble comes first in the "!".
    in property <string> warning;
    // The height under the sub-tabs for this card; the editor takes what the status line leaves, at least its least (no most: a cap leaves an empty band at large sizes).
    in property <length> room;
    in-out property <string> text;
    property <length> chrome: 2 * Theme.card-padding-v + Theme.space-2 + max(bar.preferred-height, bar.min-height);
    property <length> editor-height: max(root.room - root.chrome, Theme.editor-min-height);
    property <bool> readable: root.info.state != FileState.not-text && root.info.state != FileState.unreadable;
    // A converted file has no edit yet, but Save is what rewrites it as UTF-8.
    property <bool> can-save: root.readable && (root.info.dirty || root.info.state == FileState.converted);
    property <bool> trouble: root.info.conflict || !root.readable;
    property <string> file-alert: root.info.conflict ? (root.info.error != "" ? @tr("Could not read {} on disk: {}.", root.name, root.info.error) : @tr("{} changed on disk since it was loaded.", root.name))
        : root.info.state == FileState.unreadable ? @tr("Could not read {}: {}.", root.name, root.info.error)
        : root.info.state == FileState.not-text ? @tr("{} is not UTF-8 or UTF-16 text: fix it in a text editor.", root.name)
        : "";
    // A converted file reads fine: its note comes after what is wrong with the text.
    property <string> warnings: Warnings.both(Warnings.both(root.file-alert, root.warning), root.info.state == FileState.converted ? @tr("Saved as UTF-16 or with a BOM: Save rewrites it as UTF-8.") : "");
    property <string> alert: root.warnings != "" ? root.warnings : root.info.dirty ? @tr("Unsaved changes") : "";
    FocusScope {
        height: root.editor-height;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            // Ctrl+S on an English, a Russian or a Ukrainian layout.
            if (event.modifiers.control && (event.text == "s" || event.text == "S" || event.text == "ы" || event.text == "Ы" || event.text == "і" || event.text == "І")) {
                if (root.can-save) {
                    TextState.save(root.file);
                }
                return accept;
            }
            reject
        }
        TextArea {
            width: 100%;
            height: 100%;
            text <=> root.text;
            // A read-only config locks the config only: this file is written on its own.
            locked: false;
            enabled: root.readable;
            // An unreadable file must not look like an empty one: say why inside the editor.
            placeholder-text: root.readable ? root.hint : root.file-alert;
            accessible-label: root.label;
            edited(text) => {
                TextState.edited(root.file, text);
            }
        }
    }
    bar := HorizontalLayout {
        spacing: Theme.control-gap;
        VerticalLayout {
            alignment: center;
            InfoTip {
                text: root.description;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: status.min-width;
            min-height: status.min-height;
            Rectangle {
                visible: !root.trouble;
                status := VerticalLayout {
                    alignment: center;
                    @children
                }
            }
            if root.trouble: HorizontalLayout {
                alignment: start;
                spacing: Theme.control-gap;
                Button {
                    text: @tr("Reload");
                    accessible-label: @tr("Reload {}", root.name);
                    clicked => {
                        TextState.reload(root.file);
                    }
                }
                if root.info.conflict: Button {
                    text: @tr("Overwrite");
                    kind: ButtonKind.danger;
                    accessible-label: @tr("Overwrite {}", root.name);
                    clicked => {
                        TextState.overwrite(root.file);
                    }
                }
            }
        }
        WarningSlot {
            text: root.alert;
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Open file");
                icon: Icons.open-folder-16;
                kind: ButtonKind.soft;
                accessible-label: @tr("Open {}", root.name);
                clicked => {
                    TextState.open(root.file);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Save");
                icon: Icons.save-16;
                kind: root.info.dirty ? ButtonKind.primary : ButtonKind.secondary;
                enabled: root.can-save;
                tooltip: root.readable ? @tr("No changes to save") : @tr("The file could not be read");
                accessible-label: @tr("Save {}", root.name);
                clicked => {
                    TextState.save(root.file);
                }
            }
        }
    }
}

// The apps found by a scan, in a popup: search, close, one tile per app that ticks or unticks its rule
// (the mode is chosen in the rules list). The grid never resizes: nothing appears below it.
component AppsPopup inherits PopupWindow {
    close-policy: close-on-click-outside;
    init => {
        // The caret is in the search field at once, the ring never (DS-4.6).
        field.focus();
    }
    CardFrame {
        background: Theme.bg-control;
        border-color: Theme.stroke-control;
        FocusScope {
            focus-on-click: false;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: Theme.space-4;
                spacing: Theme.space-3;
                HorizontalLayout {
                    spacing: Theme.control-gap;
                    FocusScope {
                        horizontal-stretch: 1;
                        focus-on-click: false;
                        capture-key-pressed(event) => {
                            if (event.text == Key.DownArrow && grid.tiles.length > 0) {
                                grid.focus-grid();
                                return accept;
                            }
                            reject
                        }
                        field := SearchField {
                            width: 100%;
                            height: 100%;
                            no-ring: true;
                            text <=> TextState.popup-query;
                            placeholder-text: @tr("Search apps");
                            accessible-label: @tr("Search apps");
                        }
                    }
                    IconButton {
                        icon: Icons.close;
                        label: @tr("Close");
                        tooltip: @tr("Close");
                        clicked => {
                            root.close();
                        }
                    }
                }
                // The scan's bar has its place from the start, so the grid does not move when a scan begins.
                Rectangle {
                    height: Theme.rail-height;
                    if TextState.scanning: ProgressBar {
                        width: 100%;
                        indeterminate: true;
                        accessible-label: @tr("Looking for apps");
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    grid := CardGrid {
                        visible: TextState.grid.length > 0;
                        width: parent.width;
                        height: parent.height;
                        accessible-label: @tr("Installed apps");
                        tiles: TextState.grid;
                        fallback-icon: Icons.app-generic;
                        picked(i) => {
                            TextState.found-toggled(TextState.grid[i].caption);
                        }
                    }
                    if TextState.grid.length == 0: EmptyState {
                        icon: Icons.app-generic;
                        text: TextState.scanning && TextState.found.length == 0 ? @tr("Looking for apps") : TextState.found.length > 0 ? @tr("No app matches") : @tr("No apps found");
                        if !TextState.scanning && TextState.found.length == 0: Button {
                            text: @tr("Scan again");
                            icon: Icons.scan;
                            enabled: !Shell.locked;
                            clicked => {
                                TextState.scan();
                            }
                        }
                    }
                }
            }
        }
    }
}

// One tab in view, so the page needs no scroll at the minimum size (UI rule 25); the editors and
// the rule list scroll inside their own area (rule 26).
export component TextPage inherits VerticalLayout {
    // The shell's room under the page title, banners already taken off: what the editors and the
    // rule list share out so a tab fits without the page scrolling.
    in property <length> free-height;
    property <length> room: root.free-height - tabs.preferred-height - Theme.space-4;
    // Per-app rules: one card, the search bar over the list. The list takes its rows, between three
    // rows (the empty states) and what the room leaves.
    property <length> bar-block: Theme.control-height + Theme.space-3;
    property <length> list-room: max(root.room - 2 * Theme.card-padding-v - root.bar-block, 3 * Theme.row-height);
    // The profile editor of a rule: its header, then eight rows; it takes what the room leaves, so a short
    // window scrolls inside it (rule 26).
    property <length> profile-height: min(root.room, 2 * Theme.card-padding-v + Theme.control-height + 2 * Theme.space-3 + 8 * Theme.control-height + 7 * Theme.space-3 + Theme.space-2);
    property <length> list-height: min(root.list-room, max(TextState.rule-matches * Theme.row-height, 3 * Theme.row-height));
    // The card is as tall with a profile open as with the list, the taller of the two, so opening one
    // moves nothing (UI rule 1); the list keeps its rows at the top.
    property <length> rules-card: max(2 * Theme.card-padding-v + root.bar-block + root.list-height, root.profile-height);
    // Words: the two editors share what the room leaves after both cards' padding, the
    // toggle and the two headers, so the tab never scrolls as a page; each keeps three rows.
    property <length> words-min: 3 * Theme.control-height;
    property <length> words-height: max(root.words-min, (root.room - Theme.card-gap - 4 * Theme.card-padding-v - 3 * Theme.row-height - 3 * Theme.space-2) / 2);
    // The row of the field's list under the arrows.
    property <int> active;
    // The window's width, from the shell: the page's own width is short of it by the rail and
    // paddings, and by the scrollbar gutter when the page scrolls as a whole.
    in property <length> window-width;
    // Open while there is text and rows for it, until the caret leaves the field; typing, or the
    // caret coming back, opens it again.
    property <bool> dismissed;
    property <bool> suggest-open: TextState.query != "" && TextState.suggestions.length > 0 && !root.dismissed;
    property <bool> field-focus: search.has-focus;
    property <string> query: TextState.query;
    property <string> popup-query: TextState.popup-query;
    property <int> shown-tab: TextState.tab;
    changed field-focus => {
        root.dismissed = !self.field-focus;
    }
    changed query => {
        root.dismissed = false;
        root.active = 0;
        TextState.query-edited(self.query);
    }
    changed popup-query => {
        TextState.popup-search(self.popup-query);
    }
    changed shown-tab => {
        if (self.shown-tab == 3) {
            TextState.per-app-shown();
        }
    }
    function pick-suggestion(i: int) {
        if (!Shell.locked && i >= 0 && i < TextState.suggestions.length) {
            TextState.rule-picked(TextState.suggestions[i].caption);
        }
    }
    function open-apps() {
        TextState.popup-query = "";
        apps.show();
    }
    alignment: start;
    spacing: Theme.space-4;
    init => {
        TextState.shown();
        if (TextState.tab == 3) {
            TextState.per-app-shown();
        }
    }
    tabs := SubTabs {
        items: [@tr("Dictionary"), @tr("Replacements"), @tr("Paste"), @tr("Per-app rules"), @tr("Processing"), @tr("Words")];
        counts: [-1, -1, -1, TextState.rules.length, -1, -1];
        selected: TextState.tab;
        picked(i) => {
            TextState.tab = i;
        }
    }
    Rectangle {
        // No group titles: the sub-tab says it (UI rule 29).
        SubTabPane {
            shown: TextState.tab == 0;
            VerticalLayout {
                alignment: start;
                FileEditor {
                    file: TextFile.dictionary;
                    name: "dictionary.txt";
                    label: @tr("Dictionary");
                    description: @tr("Words that help Whisper spell names and terms, one per line.");
                    hint: @tr("One word or name per line");
                    info: TextState.dictionary-info;
                    warning: TextState.dropped-from > 0 ? @tr("Over the limit: line {} and after are not sent.", TextState.dropped-from) : "";
                    room: root.room;
                    text <=> TextState.dictionary;
                    ProgressBar {
                        value: TextState.tokens / max(TextState.budget, 1);
                        error: TextState.dropped-from > 0;
                        label: @tr("{} / {} tokens", TextState.tokens, TextState.budget);
                        accessible-label: self.label;
                    }
                }
            }
        }
        SubTabPane {
            shown: TextState.tab == 1;
            VerticalLayout {
                alignment: start;
                FileEditor {
                    file: TextFile.replacements;
                    name: "replace.txt";
                    label: @tr("Replacements");
                    description: @tr("heard => wanted, one per line. Applied after transcription.");
                    hint: @tr("heard => wanted");
                    info: TextState.replacements-info;
                    warning: TextState.bad-lines;
                    room: root.room;
                    text <=> TextState.replacements;
                    if TextState.bad-lines == "": Note {
                        text: @tr("All lines valid");
                        severity: Severity.success;
                    }
                }
            }
        }
        SubTabPane {
            shown: TextState.tab == 2;
            VerticalLayout {
                alignment: start;
                Group {
                    TilePicker {
                        accessible-label: @tr("Paste mode");
                        columns: 2;
                        tiles: [
                            { icon: Icons.clipboard-paste-24, icon-selected: Icons.clipboard-paste-24-filled, title: @tr("Clipboard"), caption: @tr("Pastes with Ctrl+V and keeps your own copy") },
                            { icon: Icons.keyboard-24, icon-selected: Icons.keyboard-24-filled, title: @tr("Type"), caption: @tr("Types the text, for games and remote desktops") },
                        ];
                        selected: TextState.paste-mode;
                        picked(i) => {
                            TextState.paste-mode = i;
                            TextState.paste-mode-picked(i);
                        }
                    }
                    Card {
                        ToggleRow {
                            flat: true;
                            title: @tr("Trailing space");
                            info: @tr("Adds a space after the pasted text.");
                            checked <=> TextState.trailing-space;
                            toggled(on) => {
                                TextState.trailing-space-toggled(on);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            flat: true;
                            title: @tr("Keep the last dictation in Win+V");
                            info: @tr("A new dictation replaces the one before.");
                            checked <=> TextState.keep-history;
                            toggled(on) => {
                                TextState.keep-history-toggled(on);
                            }
                        }
                        Divider { }
                        SliderRow {
                            title: @tr("Restore your copy after");
                            info: @tr("How long the dictation stays on Ctrl+V after it is pasted.");
                            minimum: 0;
                            maximum: 1000;
                            step: 25;
                            unit: "ms";
                            default-value: TextState.default-restore-delay-ms;
                            value <=> TextState.restore-delay-ms;
                            changed(v) => {
                                TextState.restore-delay-changed(v);
                            }
                        }
                        // In the same card: a card of its own does not fit the least window with a banner
                        // (UI rule 25).
                        Divider { }
                        Row {
                            title: @tr("Also write to a file");
                            warning: TextState.file-warning;
                            info: @tr("Each dictation is added to a file of the day, YYYY-MM-DD, in the folder. With Write only nothing is pasted. Without a folder nothing is written.");
                            Combo {
                                model: [@tr("Off"), @tr("Paste and write"), @tr("Write only")];
                                current-index: TextState.file-mode;
                                accessible-label: @tr("Also write to a file");
                                selected => {
                                    TextState.file-mode-picked(self.current-index);
                                }
                            }
                        }
                        Divider { }
                        // The format beside the folder: one row less, for the same reason.
                        Row {
                            title: @tr("Folder");
                            info: TextState.file-folder == "" ? @tr("Choose the folder the files go to. Markdown adds a list line, - 09:05 text; Text adds 09:05  text.") : TextState.file-folder;
                            HorizontalLayout {
                                alignment: end;
                                spacing: Theme.control-gap;
                                Segmented {
                                    accessible-label: @tr("File format");
                                    items: [".md", ".txt"];
                                    spoken: [@tr("Markdown"), @tr("Text")];
                                    tips: [@tr("Markdown: a list line, - 09:05 text"), @tr("Text: 09:05  text")];
                                    selected: TextState.file-format;
                                    picked(i) => {
                                        TextState.file-format-picked(i);
                                    }
                                }
                                Button {
                                    text: TextState.file-folder-name == "" ? @tr("Choose folder") : TextState.file-folder-name;
                                    icon: Icons.folder-open;
                                    enabled: !Shell.locked;
                                    tooltip: Shell.locked-tip;
                                    clicked => {
                                        TextState.file-folder-choose();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        SubTabPane {
            shown: TextState.tab == 4;
            VerticalLayout {
                alignment: start;
                Group {
                    Card {
                        ToggleRow {
                            flat: true;
                            title: @tr("Punctuation from pauses");
                            info: @tr("A long pause ends the sentence: a full stop and a capital letter. \"привет  как дела\" with a pause becomes \"привет. Как дела\"; \"hello  how are you\" becomes \"hello. How are you\".");
                            checked <=> TextState.pause-punctuation;
                            toggled(on) => {
                                TextState.pause-punctuation-toggled(on);
                            }
                        }
                        Divider { }
                        SliderRow {
                            title: @tr("Sentence pause");
                            info: @tr("A pause at least this long ends a sentence.");
                            enabled: TextState.pause-punctuation;
                            minimum: 300;
                            maximum: 3000;
                            step: 100;
                            unit: "ms";
                            default-value: 800;
                            value <=> TextState.pause-sentence-ms;
                            changed(v) => {
                                TextState.pause-sentence-changed(v);
                            }
                        }
                        Divider { }
                        SliderRow {
                            title: @tr("Paragraph pause");
                            info: @tr("A pause at least this long also leaves a blank line. Typed text gets a space instead: a line break would send the message.");
                            enabled: TextState.pause-punctuation;
                            minimum: 0;
                            maximum: 10000;
                            step: 1000;
                            unit: "ms";
                            zero-text: @tr("Off");
                            default-value: 0;
                            value <=> TextState.pause-paragraph-ms;
                            changed(v) => {
                                TextState.pause-paragraph-changed(v);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            flat: true;
                            title: @tr("Voice commands");
                            info: @tr("Say \"новая строка\" or \"new line\" for a line break, \"новый абзац\" or \"new paragraph\" for a blank line, \"удали последнее\", \"delete that\" or \"scratch that\" to remove the sentence before it. Text already pasted is never touched. Typed text gets a space instead of a line break.");
                            checked <=> TextState.voice-commands;
                            toggled(on) => {
                                TextState.voice-commands-toggled(on);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            flat: true;
                            title: @tr("Press Enter after pasting");
                            info: @tr("One Enter once the whole text is in. Not sent if, since you started speaking, the window or the field changed, you pressed a key, or the PC was locked or asleep.");
                            // Owner 2026-11-12: after Ctrl+V the Enter needs the app's own read.
                            warning: TextState.press-enter && TextState.paste-mode == 0 ? @tr("With Clipboard mode, Enter only when the app confirms it took the text from the clipboard. No confirmation, no Enter. Type mode always gets the Enter.") : "";
                            checked <=> TextState.press-enter;
                            toggled(on) => {
                                TextState.press-enter-toggled(on);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            flat: true;
                            title: @tr("Hold doubtful words back");
                            info: @tr("A part Whisper was unsure of is not pasted; its text stays in the History record. Needs History saving.");
                            enabled: TextState.history-on;
                            off-tip: @tr("Turn on History saving: a held part is kept there");
                            checked <=> TextState.confidence-filter;
                            toggled(on) => {
                                TextState.confidence-filter-toggled(on);
                            }
                        }
                        Divider { }
                        SliderRow {
                            title: @tr("Doubt level");
                            info: @tr("A part is held back when Whisper's confidence in it is under this share.");
                            enabled: TextState.history-on && TextState.confidence-filter;
                            minimum: 0.05;
                            maximum: 0.95;
                            step: 0.05;
                            decimals: 2;
                            default-value: 0.35;
                            value <=> TextState.confidence-min;
                            changed(v) => {
                                TextState.confidence-min-changed(v);
                            }
                        }
                    }
                }
            }
        }
        SubTabPane {
            shown: TextState.tab == 5;
            VerticalLayout {
                alignment: start;
                Group {
                    Card {
                        ToggleRow {
                            flat: true;
                            title: @tr("Remove filler words");
                            info: @tr("Removes the words below, with their comma: \"Ну, э, привет\" becomes \"Ну, привет\"; \"Um, hello\" becomes \"Hello\".");
                            checked <=> TextState.filler-filter;
                            toggled(on) => {
                                TextState.filler-filter-toggled(on);
                            }
                        }
                        Row {
                            title: @tr("Filler words");
                            info: @tr("One word per line, any case. Whole words only.");
                            text-only: true;
                        }
                        TextArea {
                            width: 100%;
                            preferred-height: root.words-height;
                            min-height: root.words-min;
                            text <=> TextState.fillers;
                            placeholder-text: @tr("One word per line");
                            accessible-label: @tr("Filler words");
                            edited(text) => {
                                TextState.fillers-edited(text);
                            }
                        }
                    }
                    Card {
                        Row {
                            title: @tr("Snippets");
                            info: @tr("When you say only the trigger, the text takes its place: \"мой адрес => ул. Ленина, 1\" or \"my email => me@example.com\". A trigger inside a longer sentence does nothing. Write a backslash and n for a line break in the text.");
                            text-only: true;
                        }
                        TextArea {
                            width: 100%;
                            preferred-height: root.words-height;
                            min-height: root.words-min;
                            text <=> TextState.snippets;
                            placeholder-text: @tr("trigger => text");
                            accessible-label: @tr("Snippets");
                            edited(text) => {
                                TextState.snippets-edited(text);
                            }
                        }
                    }
                }
            }
        }
        SubTabPane {
            shown: TextState.tab == 3;
            VerticalLayout {
                alignment: start;
                card := CardFrame {
                    height: root.rules-card;
                    // Search, add and scan in one field: it filters the rules below, lists the installed
                    // apps that match, and takes a typed exe for an app with no shortcut.
                    HorizontalLayout {
                        visible: TextState.profile-rule < 0;
                        x: Theme.card-padding-h;
                        y: Theme.card-padding-v;
                        width: parent.width - 2 * Theme.card-padding-h;
                        height: Theme.control-height;
                        spacing: Theme.control-gap;
                        FocusScope {
                            horizontal-stretch: 1;
                            focus-on-click: false;
                            capture-key-pressed(event) => {
                                if (!root.suggest-open) {
                                    return reject;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.active = min(root.active + 1, TextState.suggestions.length - 1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.active = max(root.active - 1, 0);
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.pick-suggestion(root.active);
                                    return accept;
                                }
                                reject
                            }
                            search := SearchField {
                                width: 100%;
                                height: 100%;
                                text <=> TextState.query;
                                placeholder-text: @tr("Search or add an app");
                                enabled: !Shell.locked;
                                accessible-label: @tr("New rule app");
                                // At once for a typed letter; `changed query` takes the clear button, Esc and a pick.
                                edited(text) => {
                                    root.dismissed = false;
                                    root.active = 0;
                                    TextState.query-edited(text);
                                }
                            }
                        }
                        Button {
                            text: @tr("Scan for apps");
                            icon: Icons.scan;
                            tooltip: Shell.locked ? Shell.locked-tip : @tr("Choose the apps that get their own rule");
                            enabled: !Shell.locked;
                            clicked => {
                                root.open-apps();
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTip {
                                text: @tr("These apps get text their own way; every other app follows the Paste tab.");
                            }
                        }
                    }
                    // The list overhangs the card's padding by the bar's gutter, so the buttons end where
                    // the search bar does and the thumb sits in the padding.
                    Rectangle {
                        visible: TextState.profile-rule < 0;
                        x: Theme.card-padding-h;
                        y: Theme.card-padding-v + root.bar-block;
                        width: parent.width - 2 * Theme.card-padding-h;
                        height: root.rules-card - 2 * Theme.card-padding-v - root.bar-block;
                        rules-box := ScrollBox {
                            // Without an x a sized child is centred: pinned, so the overhang is all on the right.
                            x: 0;
                            width: parent.width + Theme.scrollbar-gutter;
                            height: parent.height;
                            reserve-gutter: true;
                            content-height: TextState.rule-matches * Theme.row-height;
                            VerticalLayout {
                                alignment: start;
                                width: rules-box.content-width;
                                for rule[i] in TextState.rules: Rectangle {
                                    // A pick sets the Combo's index, which ends its binding: a mode changed
                                    // from outside (Reset) still reaches it through this.
                                    property <int> mode: rule.mode;
                                    changed mode => {
                                        mode-combo.current-index = self.mode;
                                    }
                                    // A duplicate pick: the tint for 600 ms (set and cleared by `pages::text`), and the row scrolls into view.
                                    property <bool> flash: TextState.flash-app != "" && rule.app == TextState.flash-app;
                                    changed flash => {
                                        if (self.flash) {
                                            if (self.y + self.height > -rules-box.viewport-y + rules-box.height) {
                                                rules-box.viewport-y = rules-box.height - self.y - self.height;
                                            }
                                            if (self.y < -rules-box.viewport-y) {
                                                rules-box.viewport-y = -self.y;
                                            }
                                        }
                                    }
                                    visible: !rule.hidden;
                                    height: rule.hidden ? 0px : Theme.row-height;
                                    background: self.flash ? Theme.accent-tint : transparent;
                                    border-radius: Theme.radius-control;
                                    HorizontalLayout {
                                        spacing: Theme.icon-gap;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: rule.icon.width > 0 ? rule.icon : Icons.app-generic;
                                                width: Theme.icon-size;
                                                height: Theme.icon-size;
                                                image-fit: contain;
                                                colorize: rule.icon.width > 0 ? transparent : Theme.text-secondary;
                                                accessible-role: none;
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            min-width: 0;
                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: rule.name != "" ? rule.name : rule.app;
                                                    font-size: Theme.body-size;
                                                    color: Theme.text-primary;
                                                    overflow: elide;
                                                }
                                                if rule.name != "": Caption {
                                                    text: rule.app;
                                                    overflow: elide;
                                                    accessible-role: none;
                                                }
                                            }
                                            name-area := TouchArea { }
                                            Tip {
                                                text: rule.name != "" ? rule.name + "\n" + rule.app : rule.app;
                                                hovered: name-area.has-hover;
                                            }
                                        }
                                        // The mode and Delete are one group, 8 apart (DS-28.1); Delete is rightmost.
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                            VerticalLayout {
                                                alignment: center;
                                                mode-combo := Combo {
                                                    min-width: Theme.rule-mode-width;
                                                    max-width: Theme.rule-mode-width;
                                                    model: [@tr("Default"), @tr("Clipboard"), @tr("Type")];
                                                    current-index: rule.mode;
                                                    accessible-label: @tr("Mode for {}", rule.app);
                                                    selected => {
                                                        TextState.rule-mode-picked(i, self.current-index);
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    kind: ButtonKind.icon;
                                                    icon: Icons.edit-16;
                                                    text: @tr("Profile of {}", rule.app);
                                                    tooltip: @tr("Language, model and text options for this app");
                                                    clicked => {
                                                        TextState.profile-opened(i);
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    kind: ButtonKind.icon;
                                                    destructive: true;
                                                    icon: Icons.delete-16;
                                                    text: @tr("Remove {}", rule.app);
                                                    enabled: !Shell.locked;
                                                    tooltip: Shell.locked-tip;
                                                    clicked => {
                                                        TextState.rule-removed(i);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if TextState.rules.length == 0: EmptyState {
                            icon: Icons.app-generic;
                            text: @tr("No app has a rule of its own");
                            Button {
                                text: @tr("Scan for apps");
                                icon: Icons.scan;
                                enabled: !Shell.locked;
                                clicked => {
                                    root.open-apps();
                                }
                            }
                        }
                        if TextState.rules.length > 0 && TextState.rule-matches == 0: EmptyState {
                            icon: Icons.app-generic;
                            text: @tr("No rule matches");
                        }
                    }
                    // Under the field, over the list: the installed apps that match, then the typed exe.
                    if root.suggest-open && TextState.profile-rule < 0: CardFrame {
                        x: Theme.card-padding-h;
                        y: Theme.card-padding-v + Theme.control-height + Theme.space-1;
                        width: search.width;
                        height: TextState.suggestions.length * Theme.control-height + 2 * Theme.space-1;
                        background: Theme.bg-control;
                        border-color: Theme.stroke-control;
                        accessible-role: list;
                        accessible-label: @tr("Matching apps");
                        for s[i] in TextState.suggestions: Rectangle {
                            x: Theme.space-1;
                            y: Theme.space-1 + i * Theme.control-height;
                            width: parent.width - 2 * Theme.space-1;
                            height: Theme.control-height;
                            border-radius: Theme.radius-control;
                            background: i == root.active || touch.has-hover ? Theme.bg-subtle-hover : transparent;
                            accessible-role: list-item;
                            // The action is what a screen reader names; the exe is in the description.
                            accessible-label: s.hint != "" ? @tr("Add rule") : s.title;
                            accessible-description: s.hint == "dup" ? @tr("{} already has a rule", s.caption) : s.caption;
                            accessible-action-default => {
                                root.pick-suggestion(i);
                            }
                            HorizontalLayout {
                                padding-left: Theme.space-2;
                                padding-right: Theme.space-2;
                                spacing: Theme.space-2;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: s.hint == "add" ? Icons.add : s.hint == "dup" ? Icons.warning : s.picture.width > 0 ? s.picture : Icons.app-generic;
                                        width: Theme.icon-size-small;
                                        height: Theme.icon-size-small;
                                        image-fit: contain;
                                        colorize: s.hint == "dup" ? Theme.error-text : s.hint == "add" ? Theme.accent-text : s.picture.width > 0 ? transparent : Theme.text-secondary;
                                        accessible-role: none;
                                    }
                                }
                                Text {
                                    text: s.hint == "add" ? @tr("Add {}", s.caption) : s.title;
                                    font-size: Theme.body-size;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                                Caption {
                                    text: s.hint == "dup" ? @tr("already has a rule") : s.hint == "add" ? "" : s.caption;
                                    color: s.hint == "dup" ? Theme.error-text : Theme.text-secondary;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                            }
                            touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.pick-suggestion(i);
                                }
                            }
                        }
                    }
                    // One rule's profile in the place of the list: the card keeps its size, so nothing
                    // moves. Every field is "Default" (follow the other tabs) or this app's own value.
                    if TextState.profile-rule >= 0: VerticalLayout {
                        x: Theme.card-padding-h;
                        y: Theme.card-padding-v;
                        width: parent.width - 2 * Theme.card-padding-h;
                        height: parent.height - 2 * Theme.card-padding-v;
                        spacing: Theme.space-3;
                        HorizontalLayout {
                            height: Theme.control-height;
                            spacing: Theme.icon-gap;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: TextState.profile-icon.width > 0 ? TextState.profile-icon : Icons.app-generic;
                                    width: Theme.icon-size;
                                    height: Theme.icon-size;
                                    image-fit: contain;
                                    colorize: TextState.profile-icon.width > 0 ? transparent : Theme.text-secondary;
                                    accessible-role: none;
                                }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: TextState.profile-name != "" ? TextState.profile-name : TextState.profile-app;
                                font-size: Theme.body-size;
                                font-weight: Theme.weight-strong;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.close;
                                    label: @tr("Close the profile");
                                    tooltip: @tr("Back to the apps");
                                    clicked => {
                                        TextState.profile-rule = -1;
                                    }
                                }
                            }
                        }
                        Divider { }
                        profile-box := ScrollBox {
                            vertical-stretch: 1;
                            reserve-gutter: true;
                            content-height: 8 * Theme.control-height + 7 * Theme.space-3;
                            VerticalLayout {
                                alignment: start;
                                spacing: Theme.space-3;
                                width: profile-box.content-width;
                                Row {
                                    title: @tr("Language");
                                    info: @tr("This app's language. A language with its own model (Model, Settings, Model by language) runs that model; Auto runs the model in use.");
                                    Combo {
                                        model: TextState.language-names;
                                        current-index: TextState.profile-values[0];
                                        accessible-label: @tr("Language");
                                        selected => {
                                            TextState.profile-picked(0, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Model");
                                    info: @tr("This app's model. Changing between two apps with different models loads a model each time (1 to 4 seconds, while you speak).");
                                    Combo {
                                        model: TextState.model-names;
                                        current-index: TextState.profile-values[1];
                                        accessible-label: @tr("Model");
                                        selected => {
                                            TextState.profile-picked(1, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Write to a file");
                                    info: @tr("Needs the folder on the Paste tab.");
                                    Combo {
                                        model: [@tr("Default"), @tr("Off"), @tr("Paste and write"), @tr("Write only")];
                                        current-index: TextState.profile-values[2];
                                        accessible-label: @tr("Write to a file");
                                        selected => {
                                            TextState.profile-picked(2, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Dictionary");
                                    info: @tr("Off sends Whisper no dictionary words for this app.");
                                    Combo {
                                        model: [@tr("Default"), @tr("On"), @tr("Off")];
                                        current-index: TextState.profile-values[3];
                                        accessible-label: @tr("Dictionary");
                                        selected => {
                                            TextState.profile-picked(3, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Replacements");
                                    info: @tr("Off skips the replacements of the Replacements tab for this app.");
                                    Combo {
                                        model: [@tr("Default"), @tr("On"), @tr("Off")];
                                        current-index: TextState.profile-values[4];
                                        accessible-label: @tr("Replacements");
                                        selected => {
                                            TextState.profile-picked(4, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Voice commands");
                                    info: @tr("On or off for this app, whatever the Processing tab says.");
                                    Combo {
                                        model: [@tr("Default"), @tr("On"), @tr("Off")];
                                        current-index: TextState.profile-values[5];
                                        accessible-label: @tr("Voice commands");
                                        selected => {
                                            TextState.profile-picked(5, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Remove filler words");
                                    info: @tr("On or off for this app, whatever the Words tab says.");
                                    Combo {
                                        model: [@tr("Default"), @tr("On"), @tr("Off")];
                                        current-index: TextState.profile-values[6];
                                        accessible-label: @tr("Remove filler words");
                                        selected => {
                                            TextState.profile-picked(6, self.current-index);
                                        }
                                    }
                                }
                                Row {
                                    title: @tr("Pause punctuation");
                                    info: @tr("On or off for this app, whatever the Processing tab says.");
                                    Combo {
                                        model: [@tr("Default"), @tr("On"), @tr("Off")];
                                        current-index: TextState.profile-values[7];
                                        accessible-label: @tr("Pause punctuation");
                                        selected => {
                                            TextState.profile-picked(7, self.current-index);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // Not laid out: the popup takes its own place, centred on the page and in the window.
                Rectangle {
                    width: 0;
                    height: 0;
                    apps := AppsPopup {
                        width: min(960px, root.window-width - 4 * Theme.space-4);
                        height: min(640px, Shell.window-height - 4 * Theme.space-4);
                        x: (root.window-width - self.width) / 2 - parent.absolute-position.x;
                        y: (Shell.window-height - self.height) / 2 - parent.absolute-position.y;
                    }
                }
            }
        }
    }
}
