// Messages and status: window banner, inline note, level meter, progress bar, badge.
import { Theme } from "../tokens.slint";
import { Icons } from "../icons.slint";
import { Caption, FocusRing, HoverTip, Tip, TipBubble } from "base.slint";

export enum Severity { info, success, warning, error }

// Colour and icon of a severity, one place for Banner and Note.
export global Look {
    public pure function ink(s: Severity) -> color {
        return s == Severity.error ? Theme.error-text : s == Severity.warning ? Theme.warning-text : s == Severity.success ? Theme.success-text : Theme.text-secondary;
    }
    public pure function fill(s: Severity) -> color {
        return s == Severity.error ? Theme.error-fill : s == Severity.warning ? Theme.warning-fill : Theme.info-fill;
    }
    public pure function icon(s: Severity) -> image {
        return s == Severity.error ? Icons.error-circle : s == Severity.warning ? Icons.warning : s == Severity.success ? Icons.checkmark-circle : Icons.info;
    }
    public pure function icon-16(s: Severity) -> image {
        return s == Severity.error ? Icons.error-circle-16 : s == Severity.warning ? Icons.warning-16 : s == Severity.success ? Icons.checkmark-circle-16 : Icons.info-16;
    }
}

// Window-level message: card-shaped, severity fill with a 30 % stroke of the same hue, icon 20,
// wrapping text, actions (children, buttons) on the right. Under 560 px the text takes its own
// line above the buttons.
export component Banner inherits Rectangle {
    in property <string> text;
    in property <Severity> severity: Severity.warning;
    property <bool> narrow: root.width < Theme.banner-narrow;
    property <length> pad-h: Theme.space-4;
    property <length> pad-v: Theme.space-3;
    property <length> text-x: root.pad-h + Theme.icon-size + Theme.space-3;
    property <bool> has-actions: actions.preferred-width > 0;
    property <length> text-w: root.narrow || !root.has-actions ? root.width - root.text-x - root.pad-h : root.width - root.text-x - root.pad-h - actions.preferred-width - Theme.space-4;
    property <length> body-h: root.narrow && root.has-actions ? message.preferred-height + Theme.space-2 + actions.preferred-height : max(message.preferred-height, actions.preferred-height, Theme.icon-size);
    background: Look.fill(root.severity);
    // 1 px hairline: the banner's stroke.
    border-width: 1px;
    border-color: Look.ink(root.severity).transparentize(0.7);
    border-radius: Theme.radius-card;
    accessible-role: banner;
    accessible-label: root.text;
    min-width: Theme.banner-min-width;
    height: root.body-h + 2 * root.pad-v;
    Image {
        x: root.pad-h;
        y: root.pad-v + (root.narrow && root.has-actions ? 0 : (root.body-h - Theme.icon-size) / 2);
        width: Theme.icon-size;
        height: Theme.icon-size;
        source: Look.icon(root.severity);
        colorize: Look.ink(root.severity);
        accessible-role: none;
    }
    message := Text {
        x: root.text-x;
        y: root.pad-v + (root.narrow && root.has-actions ? 0 : (root.body-h - self.height) / 2);
        width: root.text-w;
        height: self.preferred-height;
        text: root.text;
        font-size: Theme.body-size;
        color: Theme.text-primary;
        wrap: word-wrap;
        accessible-role: none;
    }
    actions := HorizontalLayout {
        x: root.width - root.pad-h - self.preferred-width;
        y: root.narrow ? root.pad-v + message.preferred-height + Theme.space-2 : root.pad-v + (root.body-h - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: Theme.space-2;
        @children
    }
}

// Inline note under a control inside a Card: no border, icon 16 and caption text in the severity
// colour, optional buttons (children) on the right.
export component Note inherits HorizontalLayout {
    in property <string> text;
    in property <Severity> severity: Severity.info;
    spacing: Theme.space-2;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    VerticalLayout {
        alignment: center;
        Image {
            source: Look.icon-16(root.severity);
            width: Theme.icon-size-small;
            height: Theme.icon-size-small;
            colorize: Look.ink(root.severity);
            accessible-role: none;
        }
    }
    Text {
        text: root.text;
        font-size: Theme.caption-size;
        color: Look.ink(root.severity);
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 1;
        accessible-role: none;
    }
    @children
}

// Two warnings for one "!": the worse first, each on its own line of the tooltip.
export global Warnings {
    public pure function both(worse: string, other: string) -> string {
        return worse == "" ? other : other == "" ? worse : worse + "\n" + other;
    }
}

// What the focused "!" says and where, in window coordinates, for `KeyTipHost`.
export global KeyTip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

// Lies over the whole window like the toast: takes no input, pushes nothing.
export component KeyTipHost {
    property <int> seen;
    if KeyTip.text != "": TipBubble {
        x: min(KeyTip.x, root.width - self.width - Theme.space-2);
        y: min(KeyTip.y, root.height - self.height - Theme.space-2);
        width: self.preferred-width;
        height: self.preferred-height;
        text: KeyTip.text;
    }
    if HoverTip.text != "": TipBubble {
        x: min(HoverTip.x, root.width - self.width - Theme.space-2);
        y: min(HoverTip.y, root.height - self.height - Theme.space-2);
        width: self.preferred-width;
        height: self.preferred-height;
        text: HoverTip.text;
    }
    // A Tip removed while open never closes itself: its heartbeat stops, the bubble goes.
    Timer {
        interval: 450ms;
        running: HoverTip.text != "";
        triggered => {
            if (root.seen == HoverTip.beat) {
                HoverTip.text = "";
            }
            root.seen = HoverTip.beat;
        }
    }
}

// The "!" of a row (UI rule 2): its space is kept while `text` is empty, the text is its tooltip on
// hover and on keyboard focus, so a warning never changes the row. A Tab stop only while it warns.
export component WarningSlot inherits Rectangle {
    in property <string> text;
    width: Theme.icon-size;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    property <bool> tell-key-tip: fs.has-focus && root.text != "";
    // Tracked, because Tab scrolls the row into view after the focus lands.
    property <length> key-tip-y: root.absolute-position.y + root.height + Theme.space-1;
    function update-key-tip() {
        KeyTip.text = root.tell-key-tip ? root.text : "";
        KeyTip.x = root.absolute-position.x;
        KeyTip.y = root.key-tip-y;
    }
    changed tell-key-tip => {
        root.update-key-tip();
    }
    changed key-tip-y => {
        if (root.tell-key-tip) {
            root.update-key-tip();
        }
    }
    changed text => {
        if (root.tell-key-tip) {
            root.update-key-tip();
        }
    }
    if root.text != "": Image {
        y: (root.height - self.height) / 2;
        width: Theme.icon-size;
        height: Theme.icon-size;
        source: Look.icon(Severity.warning);
        colorize: Look.ink(Severity.warning);
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.text != "";
    }
    // Only Tab reaches it, so the ring never shows for the mouse (UI rule 17).
    fs := FocusScope {
        enabled: root.text != "";
        focus-on-click: false;
    }
    FocusRing {
        y: (root.height - self.height) / 2;
        height: Theme.icon-size;
        shown: fs.has-focus;
    }
    Tip {
        text: root.text;
        hovered: touch.has-hover;
    }
}

// The one toast of the window (UI rule 3): the newest replaces the current one, no queue. For
// short events; callable from Rust and from pages.
export global Toast {
    out property <string> text;
    // Bumped by every `show`, so the host restarts its clock for a repeated message too.
    out property <int> shown;
    public function show(message: string) {
        root.text = message;
        root.shown += 1;
    }
    public function clear() {
        root.text = "";
    }
}

// Lies over the bottom of the window: takes no input, pushes nothing, leaves after 3 s.
export component ToastHost {
    property <int> shown: Toast.shown;
    // The `shown` the clock runs for: a `show` in the same tick as the expiry must not be cleared.
    property <int> armed;
    changed shown => {
        self.armed = self.shown;
        clock.restart();
    }
    clock := Timer {
        interval: 3s;
        running: Toast.text != "";
        triggered => {
            if (root.armed == root.shown) {
                Toast.clear();
            }
        }
    }
    if Toast.text != "": VerticalLayout {
        alignment: end;
        padding-bottom: Theme.space-4;
        HorizontalLayout {
            alignment: center;
            // Fades in and reads at body size, so it is not taken for a stray hover tip.
            // shortcut: it leaves in one frame (the `if` drops it), fade it out if owners miss it.
            TipBubble {
                text: Toast.text;
                font-size: Theme.body-size;
            }
        }
    }
}

// Live level: 24 px inset track with 3 px accent bars 2 px apart, newest at the right; the bars
// that fit are centred on the track, so both ends keep the same inset. A bar marked in `clipped`
// goes error red, as does one at 1.0. With `live` off the track shows `empty-text` ("No
// microphone"); live with no bar yet (silence so far) it shows `idle-text`, so an open, quiet
// mic does not look like a dead meter.
export component Meter inherits Rectangle {
    // Bar heights 0..1, oldest first.
    in property <[float]> bars;
    // Parallel to `bars`: the ones that clipped.
    in property <[bool]> clipped;
    in property <bool> live: true;
    in property <string> empty-text;
    in property <string> idle-text;
    property <length> inset: Theme.space-1;
    property <length> pitch: Theme.meter-pitch;
    property <length> bar-width: Theme.meter-bar;
    // Bars that fit between the insets, and where the first of them starts.
    property <int> fit: floor((root.width - 2 * root.inset + root.pitch - root.bar-width) / root.pitch);
    property <length> start: (root.width - (root.fit * root.pitch - (root.pitch - root.bar-width))) / 2;
    height: Theme.meter-height;
    min-width: Theme.meter-min-width;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: Theme.bg-inset;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: root.live ? "" : root.empty-text;
    if root.live: Rectangle {
        for level[i] in root.bars: Rectangle {
            x: root.start + (root.fit - (root.bars.length - i)) * root.pitch;
            width: root.bar-width;
            // A silent bar keeps a 2 px stub (radius-small); the tallest leaves 3 px above and below.
            height: max(Theme.radius-small, clamp(level, 0, 1) * (root.height - 2 * root.bar-width));
            border-radius: Theme.radius-round;
            background: root.clipped[i] || level >= 1 ? Theme.error-text : Theme.accent;
            visible: root.bars.length - i <= root.fit;
        }
    }
    if !root.live || root.bars.length == 0: Caption {
        text: root.live ? root.idle-text : root.empty-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// 4 px rail with the accent fill; `error` turns the fill red (token budget exceeded). `label`
// ("0.7 of 1.6 GB") sits right of the rail.
export component ProgressBar inherits HorizontalLayout {
    in property <float> value;
    in property <bool> error;
    in property <string> label;
    spacing: Theme.space-2;
    accessible-role: progress-indicator;
    accessible-value: round(clamp(root.value, 0, 1) * 100) + " %";
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: Theme.rail-height;
            min-width: Theme.progress-min-width;
            border-radius: Theme.radius-round;
            background: Theme.bg-inset;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.value, 0, 1);
                border-radius: Theme.radius-round;
                background: root.error ? Theme.error-text : Theme.accent;
            }
        }
    }
    if root.label != "": Text {
        text: root.label;
        font-size: Theme.caption-size;
        color: root.error ? Theme.error-text : Theme.text-secondary;
        vertical-alignment: center;
    }
}

export enum BadgeKind { success, neutral, accent }

// Small nearly square label (UI rule 13, no pill): "Ready" (success), "Not downloaded" (neutral),
// "Recommended" (accent). One height (`badge-height`) so a column of them lines up (DS-9.3); the
// text fills it, centred both ways, and never wraps (DS-9.1). Every kind reaches 4.5:1 (DS-9.2).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeKind> kind: BadgeKind.neutral;
    property <color> ink: root.kind == BadgeKind.success ? Theme.success-text : root.kind == BadgeKind.accent ? Theme.accent-text : Theme.text-secondary;
    border-radius: Theme.radius-control;
    background: root.kind == BadgeKind.success ? Theme.success-tint : root.kind == BadgeKind.accent ? Theme.accent-badge : Theme.bg-inset;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    height: Theme.badge-height;
    min-width: Theme.whole(t.preferred-width) + 2 * Theme.space-2;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    t := Text {
        x: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        height: parent.height;
        text: root.text;
        font-size: Theme.caption-size;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        accessible-role: none;
    }
}

// What an empty list shows, in the same box the full list takes (DS-12): a 32 px glyph in
// secondary ink, one line saying what is missing, and the fix as a Button (children) 12 px below.
// Any longer hint is an InfoTip.
export component EmptyState {
    in property <image> icon;
    in property <string> text;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    VerticalLayout {
        alignment: center;
        spacing: Theme.space-3;
        padding: Theme.space-4;
        if root.icon.width > 0: HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: Theme.icon-size-large;
                height: Theme.icon-size-large;
                colorize: Theme.text-secondary;
                accessible-role: none;
            }
        }
        Text {
            text: root.text;
            font-size: Theme.body-size;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: none;
        }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.control-gap;
            @children
        }
    }
}
